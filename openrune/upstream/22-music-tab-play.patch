From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 02:17:21 -0400
Subject: [PATCH] Music tab: play a track from the list, unlock hints

The jukebox list (music:jukebox) gets its op events when the tab opens; Play
on an unlocked track switches to manual mode and plays it ("You have not
unlocked this piece of music yet!" otherwise), and Unlock hint prints the
track's hint. The children follow the clientscript's music_list_setup: one
per music row that is not hidden, in row order. MusicPlayer gains isUnlocked
and isPlaying for content (e.g. music clue steps).
---
 .../music/plugin/scripts/MusicTabScript.kt    | 34 ++++++++++++++++++-
 .../org/rsmod/api/player/music/MusicPlayer.kt | 14 ++++++--
 2 files changed, 45 insertions(+), 3 deletions(-)

diff --git a/api/music-plugin/src/main/kotlin/org/rsmod/api/music/plugin/scripts/MusicTabScript.kt b/api/music-plugin/src/main/kotlin/org/rsmod/api/music/plugin/scripts/MusicTabScript.kt
index 8ab0248dc..2fac25c06 100644
--- a/api/music-plugin/src/main/kotlin/org/rsmod/api/music/plugin/scripts/MusicTabScript.kt
+++ b/api/music-plugin/src/main/kotlin/org/rsmod/api/music/plugin/scripts/MusicTabScript.kt
@@ -1,17 +1,32 @@
 package org.rsmod.api.music.plugin.scripts
 
+import dev.openrune.definition.type.widget.IfEvent
+import dev.openrune.types.aconverted.interf.IfButtonOp
+import jakarta.inject.Inject
 import org.rsmod.api.player.music.MusicPlayMode
+import org.rsmod.api.player.music.MusicPlayer
 import org.rsmod.api.player.protect.ProtectedAccess
+import org.rsmod.api.player.ui.ifSetEvents
 import org.rsmod.api.player.vars.enumVarp
+import org.rsmod.api.script.onIfOpen
 import org.rsmod.api.script.onIfOverlayButton
+import org.rsmod.api.table.MusicRow
 import org.rsmod.game.entity.Player
 import org.rsmod.plugin.scripts.PluginScript
 import org.rsmod.plugin.scripts.ScriptContext
 
-public class MusicTabScript : PluginScript() {
+public class MusicTabScript @Inject constructor(private val musicPlayer: MusicPlayer) : PluginScript() {
     private var Player.playMode by enumVarp<MusicPlayMode>("varp.musicplay")
 
+    /** The jukebox list's children: the clientscript makes one per music row that is not hidden. */
+    private val tracks: List<MusicRow> by lazy {
+        MusicRow.all().filter { it.hidden != true }.sortedBy { it.rowId }
+    }
+
     override fun ScriptContext.startup() {
+        onIfOpen("interface.music") {
+            player.ifSetEvents("component.music:jukebox", tracks.indices, IfEvent.Op1, IfEvent.Op2)
+        }
         onIfOverlayButton("component.music:area") { selectPlayMode(MusicPlayMode.Area, "area") }
         onIfOverlayButton("component.music:shuffle") {
             selectPlayMode(MusicPlayMode.Random, "shuffle")
@@ -19,10 +34,27 @@ public class MusicTabScript : PluginScript() {
         onIfOverlayButton("component.music:single") {
             selectPlayMode(MusicPlayMode.Manual, "single")
         }
+        onIfOverlayButton("component.music:jukebox") { selectTrack(it.comsub, it.op) }
     }
 
     private fun ProtectedAccess.selectPlayMode(mode: MusicPlayMode, name: String) {
         player.playMode = mode
         mes("You are now using the $name music mode.")
     }
+
+    private fun ProtectedAccess.selectTrack(index: Int, op: IfButtonOp) {
+        val track = tracks.getOrNull(index) ?: return
+        when (op) {
+            IfButtonOp.Op1 -> {
+                if (!musicPlayer.isUnlocked(player, track)) {
+                    mes("You have not unlocked this piece of music yet!")
+                    return
+                }
+                player.playMode = MusicPlayMode.Manual
+                musicPlayer.play(player, track)
+            }
+            IfButtonOp.Op2 -> mes("This track unlocks ${track.unlockhint}")
+            else -> Unit
+        }
+    }
 }
diff --git a/api/player/src/main/kotlin/org/rsmod/api/player/music/MusicPlayer.kt b/api/player/src/main/kotlin/org/rsmod/api/player/music/MusicPlayer.kt
