diff --git a/content/skills/hunter/src/integration/kotlin/org/rsmod/content/skills/hunter/BirdHouseScriptTest.kt b/content/skills/hunter/src/integration/kotlin/org/rsmod/content/skills/hunter/BirdHouseScriptTest.kt
