+
+public object AndroidGameMessageEncoderRepository {
+    @ExperimentalStdlibApi
+    @Suppress("UNUSED_PARAMETER")
+    public fun build(huffmanCodecProvider: HuffmanCodecProvider): MessageEncoderRepository<AndroidGameServerProt> =
+        MessageEncoderRepositoryBuilder(ProtRepository.of<AndroidGameServerProt>()).apply {
+            bind(AndroidUpdateStatV2Encoder())
+            bindWithAlts(AndroidRebuildNormalV2Encoder(), RebuildLoginV2::class.java, RebuildNormalV2::class.java)
+            bind(AndroidUpdateRunWeightEncoder())
+            bind(AndroidUpdateInvFullEncoder())
+            bind(androidUpdateInvPartialEncoder())
+            bind(AndroidSetNpcUpdateOriginEncoder())
+            bind(AndroidVarpSmallEncoder())
+            bind(AndroidVarpLargeEncoder())
+            bind(AndroidIfSetEventsV2Encoder())
+            bind(AndroidLogoutEncoder())
+            bind(AndroidServerTickEndEncoder())
+            bind(AndroidIfOpenSubEncoder())
+            bind(AndroidIfOpenTopEncoder())
+            bind(androidMessageGameEncoder())
+            bind(androidRunClientScriptEncoder())
+            bind(AndroidPlayerInfoEncoder())
+            bind(AndroidSetActiveWorldV2Encoder())
+            bind(AndroidUpdateRunEnergyEncoder())
+            bind(androidNpcInfoSmallV6Encoder())
+            bind(AndroidObjAddSpecificEncoder())
+            bind(AndroidIfSetAnimEncoder())
+            bind(AndroidIfSetNpcHeadActiveEncoder())
+            bind(AndroidIfSetNpcHeadEncoder())
+            bind(AndroidIfCloseSubEncoder())
+            bind(AndroidIfSetTextEncoder())
+            bind(AndroidObjDelSpecificEncoder())
+            bind(androidNpcInfoLargeV6Encoder())
+            bind(AndroidUpdateZonePartialFollowsEncoder())
+            bind(AndroidUpdateZoneFullFollowsEncoder())
+            bind(AndroidUpdateZonePartialEnclosedEncoder())
+            bind(AndroidLocAddChangeV2Encoder())
+            bind(AndroidLocDelEncoder())
+            bind(AndroidIfSetHideEncoder())
+            bind(AndroidIfSetPlayerHeadEncoder())
+        }.build()
+}
+
+public object AndroidGameMessageDecoderRepository {
+    private val IDENTIFIED =
+        setOf(
+            AndroidGameClientProt.MOVE_GAMECLICK,
+            AndroidGameClientProt.CLIENT_CHEAT,
+            AndroidGameClientProt.MESSAGE_PUBLIC,
+            AndroidGameClientProt.IF_BUTTONX,
+            AndroidGameClientProt.RESUME_PAUSEBUTTON,
+        ) + (ANDROID_OPLOC + ANDROID_OPOBJ + ANDROID_OPNPC).map { it.first } +
+            setOf(AndroidGameClientProt.OPLOCT, AndroidGameClientProt.OPOBJT, AndroidGameClientProt.OPNPCT)
+
+    @ExperimentalStdlibApi
+    public fun build(huffmanCodecProvider: HuffmanCodecProvider): MessageDecoderRepository<AndroidGameClientProt> =
+        MessageDecoderRepositoryBuilder(ProtRepository.of<AndroidGameClientProt>()).apply {
+            bind(AndroidMoveGameClickDecoder())
+            bind(androidClientCheatDecoder())
+            bind(androidMessagePublicDecoder(huffmanCodecProvider))
+            bind(androidIfButtonXDecoder())
+            bind(AndroidResumePauseButtonDecoder())
+            for ((prot, op, spec) in ANDROID_OPLOC) bind(AndroidOpLocDecoder(prot, op, spec))
+            for ((prot, op, spec) in ANDROID_OPOBJ) bind(AndroidOpObjDecoder(prot, op, spec))
+            for ((prot, op, spec) in ANDROID_OPNPC) bind(AndroidOpNpcDecoder(prot, op, spec))
+            bind(AndroidOpLocTDecoder())
+            bind(AndroidOpObjTDecoder())
+            bind(AndroidOpNpcTDecoder())
+            for (prot in AndroidGameClientProt.entries) {
+                if (prot in IDENTIFIED) continue
+                bind(AndroidUnknownPacket::class.java, AndroidUnknownPacketDecoder(prot))
+            }
+        }.build()
+}
+
+/**
+ * A client packet whose meaning has not been identified yet; framing is still exact because the
+ * size comes from the client's own table. Servers can log these to map the remaining prots.
+ */
+public class AndroidUnknownPacket(
+    public val opcode: Int,
+    public val payload: ByteArray,
+) : IncomingGameMessage {
+    override val category: ClientProtCategory
+        get() = GameClientProtCategory.CLIENT_EVENT
+
+    override fun toString(): String =
+        "AndroidUnknownPacket(opcode=$opcode, size=${payload.size}, payload=" +
+            payload.joinToString("") { "%02x".format(it) } + ")"
+}
+
+public class AndroidUnknownPacketDecoder(
+    override val prot: ClientProt,
+) : MessageDecoder<AndroidUnknownPacket> {
+    override fun decode(buffer: JagByteBuf): AndroidUnknownPacket {
+        val payload = ByteArray(buffer.readableBytes())
+        buffer.buffer.readBytes(payload)
+        return AndroidUnknownPacket(prot.opcode, payload)
+    }
+}
+
+/**
+ * The CRC section of the Android login block. Its order has not been reverse engineered; desktop
+ * order is assumed (the login succeeds either way, only CRC validation is affected).
+ */
+public object AndroidLoginCrcDecoder : LoginCrcDecoder by DesktopLoginCrcDecoder {
+    override val clientType: OldSchoolClientType = OldSchoolClientType.ANDROID
+}
diff --git a/protocol/osrs-241/osrs-241-android/src/main/kotlin/net/rsprot/protocol/android/AndroidZone.kt b/protocol/osrs-241/osrs-241-android/src/main/kotlin/net/rsprot/protocol/android/AndroidZone.kt
