From a21ffff72bb9c11a93410af0265bd72cd94816a2 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:33:26 -0400
Subject: [PATCH] Add content groups to two fishing spots

The Lumbridge river Lure/Bait spot (0_50_50_freshfish) and 0_50_49_saltfish
had no content group, so their fishing ops did nothing.
---
 .data/raw-cache/server/npcs.toml | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/.data/raw-cache/server/npcs.toml b/.data/raw-cache/server/npcs.toml
index 0e61a1db8..bd9af7f5d 100644
--- a/.data/raw-cache/server/npcs.toml
+++ b/.data/raw-cache/server/npcs.toml
@@ -1,12 +1,14 @@
 [[npc]]
 id = "npc.0_50_50_freshfish"
 inherit = "npc.0_50_50_freshfish"
+contentGroup = "content.lure_bait_fishing_spot"
 moveRestrict = "NoMove"
 wanderRange = 0
 
 [[npc]]
 id = "npc.0_50_49_saltfish"
 inherit = "npc.0_50_49_saltfish"
+contentGroup = "content.net_bait_fishing_spot"
 moveRestrict = "NoMove"
 wanderRange = 0
 respawnRate = 50
-- 
2.43.0

