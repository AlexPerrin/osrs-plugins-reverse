+/**
+ * Draynor Manor's side of Vampyre Slayer: Morgan's garlic cupboard, the coffin and Count Draynor.
+ * Count Draynor rises for the player who opens the coffin; at 0 hitpoints he only dies to a stake
+ * and a hammer, otherwise he heals to full. Garlic weakens him while the player attacks him (see
+ * [CountDraynorFight]); his fast regeneration is the npc's `regenRate` (vampyre_slayer_npcs.toml).
+ * If the fight takes too long he returns to his coffin (the lifespan ends) and rises again at full
+ * health when the coffin is reopened.
+ */
+class VampyreSlayerManor
+@Inject
+constructor(
+    private val npcRepo: NpcRepository,
+    private val locRepo: LocRepository,
+    private val protectedAccess: ProtectedAccessLauncher,
+    private val npcDeath: NpcDeath,
+    private val aiPlayerInteractions: AiPlayerInteractions,
+    private val npcHitModifier: StandardNpcHitModifier,
+) : PluginScript() {
+    private val fights = HashMap<Long, CountDraynorFight>()
+
+    private val quest: Quest
+        get() = checkNotNull(Quest.get(QUEST_KEY)) { "Vampyre Slayer is not registered." }
+
+    private fun stage(player: Player): Int = quest.getQuestStage(player)
+
+    private fun countType(): NpcServerType =
+        ServerCacheManager.getNpc(COUNT.asRSCM(RSCMType.NPC)) ?: error("Missing npc: $COUNT")
+
+    private fun fightOf(count: Npc): CountDraynorFight? = fights.values.firstOrNull { it.count === count }
+
+    override fun ScriptContext.startup() {
+        onOpLoc1(CUPBOARD_SHUT) { openCupboard(it.loc) }
+        onOpLoc1(CUPBOARD_OPEN) { searchCupboard() }
+        onOpLoc2(CUPBOARD_OPEN) { closeCupboard(it.loc) }
+        onOpLoc1(COFFIN) { openCoffin(it.loc) }
+        onNpcQueue(countType(), "queue.death") { countDeath() }
+        onAiTimer(countType()) { countTick(npc) }
+        onModifyNpcHit(countType()) { fightOf(npc)?.garlicBonus(hit) }
+        onPlayerLogout {
+            val fight = player.uuid?.let(fights::remove) ?: return@onPlayerLogout
+            if (fight.count.isSlotAssigned) npcRepo.del(fight.count, Int.MAX_VALUE)
+        }
+    }
+
+    private suspend fun ProtectedAccess.openCupboard(loc: BoundLocInfo) {
+        arriveDelay()
+        anim("seq.human_opencupboard")
+        locRepo.change(loc, CUPBOARD_OPEN, CUPBOARD_OPEN_TICKS)
+    }
+
+    private fun ProtectedAccess.closeCupboard(loc: BoundLocInfo) {
+        anim("seq.human_opencupboard")
+        locRepo.change(loc, CUPBOARD_SHUT, Int.MAX_VALUE)
+    }
+
+    private suspend fun ProtectedAccess.searchCupboard() {
+        arriveDelay()
+        if (invAdd(inv, VampyreSlayer.GARLIC).failure) {
+            mes("You don't have enough inventory space.")
+            return
+        }
+        startDialogue { objbox(VampyreSlayer.GARLIC, "The cupboard contains garlic. You take a clove.") }
+    }
+
+    private suspend fun ProtectedAccess.openCoffin(loc: BoundLocInfo) {
+        arriveDelay()
+        val stage = stage(player)
+        if (stage < VampyreSlayer.STARTED || stage >= VampyreSlayer.COMPLETE) {
+            mes("The coffin is sealed shut.")
+            return
+        }
+        val uuid = player.uuid ?: return
+        val existing = fights[uuid]
+        if (existing != null && existing.count.isSlotAssigned) {
+            return
+        }
+        anim("seq.human_openchest")
+        delay(1)
+        val count = Npc(COUNT, loc.coords.translateZ(-1))
+        npcRepo.add(count, COUNT_LIFESPAN)
+        fights[uuid] = CountDraynorFight(player, count)
+        count.anim("seq.vampireslayer_arise")
+        delay(2)
+        count.opPlayer2(player, aiPlayerInteractions)
+        count.aiTimer(1)
+    }
+
+    private fun countTick(count: Npc) {
+        val fight = fightOf(count) ?: return
+        val damage = fight.garlicCheck()
+        if (damage > 0) {
+            count.queueHit(1, HitType.Typeless, damage, npcHitModifier)
+        }
+        count.aiTimer(1)
+    }
+
+    private suspend fun StandardNpcAccess.countDeath() {
+        val entry = fights.entries.firstOrNull { it.value.count === npc }
+        if (entry == null) {
+            npcDeath.deathNoDrops(this)
+            return
+        }
+        val player = entry.value.player
+        val hasStake = player.inv.count(VampyreSlayer.STAKE) > 0
+        val hasHammer = player.inv.count(VampyreSlayer.HAMMER) > 0
+        if (!hasStake || !hasHammer) {
+            if (hasStake) {
+                player.mes("You're unable to push the stake far enough in!")
+            }
+            player.mes("The vampyre seems to regenerate!")
+            npc.heal(npc.baseHitpointsLvl, showHitsplat = true)
+            return
+        }
+        player.mes("You hammer the stake into the vampyre's chest!")
+        fights.remove(entry.key)
+        npcDeath.deathWithDrops(this)
+        complete(player)
+    }
+
+    @OptIn(InternalApi::class)
+    private fun complete(player: Player) {
+        val finish: suspend ProtectedAccess.() -> Unit = { quest.completeQuest(this) }
+        if (!protectedAccess.launch(player, block = finish)) {
+            protectedAccess.launchLenient(player, finish)
+        }
+    }
+
+    private companion object {
+        const val QUEST_KEY = "quest_vampyreslayer"
+        const val COUNT = "npc.count_draynor"
+        const val COFFIN = "loc.vampcoffin"
+        const val CUPBOARD_SHUT = "loc.garliccupboardshut"
+        const val CUPBOARD_OPEN = "loc.garliccupboardopen"
+        const val CUPBOARD_OPEN_TICKS = 300
+        const val COUNT_LIFESPAN = 500
+    }
+}
+
+/**
+ * Garlic in a Count Draynor fight (OSRS Wiki, Count Draynor: "Strategy" and "Stat restoration",
+ * quoting Mod Ash). Every tick that [player] has an attack queued on [count] (melee, or an autocast
+ * spell; a manual cast is a spell-on-npc interaction and does not count) and carries garlic, each
+ * of the Count's stats that is full is drained: Attack -10 (with a message), Strength -10, Defence
+ * -40 (his 30 Defence goes to 0) and, when his hitpoints are full, 10 damage. His regeneration (1
+ * point every 5 ticks) restores them, so the drain comes back: Attack after 50 ticks, Defence after
+ * 150, hitpoints whenever he heals to full. Garlic also adds 1 to the player's damage on him.
+ */
+internal class CountDraynorFight(val player: Player, val count: Npc) {
+    private var ticks = 0
+    private var weakened = false
+    private var lastHitpointsDrain = Int.MIN_VALUE / 2
+
+    /** Runs one tick of the garlic check and returns the garlic damage to deal (0 or 10). */
+    fun garlicCheck(): Int {
+        ticks++
+        if (count.hitpoints <= 0 || !attackQueued() || !hasGarlic()) {
+            return 0
+        }
+        if (count.attackLvl >= count.baseAttackLvl) {
+            count.attackLvl = (count.attackLvl - GARLIC_ATTACK_DRAIN).coerceAtLeast(0)
+            player.mes(if (weakened) REWEAKEN_MESSAGE else WEAKEN_MESSAGE)
+            weakened = true
+        }
+        if (count.strengthLvl >= count.baseStrengthLvl) {
+            count.strengthLvl = (count.strengthLvl - GARLIC_STRENGTH_DRAIN).coerceAtLeast(0)
+        }
+        if (count.defenceLvl >= count.baseDefenceLvl) {
+            count.defenceLvl = (count.defenceLvl - GARLIC_DEFENCE_DRAIN).coerceAtLeast(0)
+        }
+        // The damage lands a tick later; don't queue it twice while it is still in flight.
+        if (count.hitpoints >= count.baseHitpointsLvl && ticks - lastHitpointsDrain > HIT_DELAY) {
+            lastHitpointsDrain = ticks
+            return GARLIC_DAMAGE
+        }
+        return 0
+    }
+
+    /** Garlic adds 1 to the player's damage on the Count (wiki, Mod Ash 17 Nov 2020). */
+    fun garlicBonus(hit: HitBuilder) {
+        if (!hit.isFromPlayer || hit.sourceUid != player.uid.packed || hit.damage <= 0) return
+        if (hasGarlic()) hit.damage++
+    }
+
+    private fun hasGarlic(): Boolean = player.inv.count(VampyreSlayer.GARLIC) > 0
+
+    private fun attackQueued(): Boolean {
+        val interaction = player.interaction as? InteractionNpcOp ?: return false
+        return interaction.op == InteractionOp.Op2 && interaction.target === count
+    }
+
+    companion object {
+        const val WEAKEN_MESSAGE = "The vampyre seems to be weakened by the garlic you're carrying."
+        const val REWEAKEN_MESSAGE = "The vampyre seems to weaken."
+        const val GARLIC_DAMAGE = 10
+        private const val GARLIC_ATTACK_DRAIN = 10
+        private const val GARLIC_STRENGTH_DRAIN = 10
+        private const val GARLIC_DEFENCE_DRAIN = 40
+        private const val HIT_DELAY = 2
+    }
+}
