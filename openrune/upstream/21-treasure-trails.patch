+                    columnRSCM(OBJ, "obj.${r.obj}")
+                    column(MIN, r.min)
+                    column(MAX, r.max)
+                    column(WEIGHT, r.weight)
+                    column(NOTED, r.noted)
+                }
+            }
+        }
