+}
+
+/** Case 4: MAP_ANIM as a top-level packet (zone index 0). */
+public class AndroidMapAnimEncoder : MessageEncoder<MapAnim> {
+    override val prot: ServerProt = AndroidGameServerProt.MAP_ANIM
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: MapAnim) {
+        AndroidZoneProts.writeMapAnim(buffer, message)
+    }
+}
+
+/** Case 17: LOC_ANIM as a top-level packet (zone index 2). */
+public class AndroidLocAnimEncoder : MessageEncoder<LocAnim> {
+    override val prot: ServerProt = AndroidGameServerProt.LOC_ANIM
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: LocAnim) {
+        AndroidZoneProts.writeLocAnim(buffer, message)
+    }
+}
+
+/** Case 48: SOUND_AREA as a top-level packet (zone index 13). */
+public class AndroidSoundAreaEncoder : MessageEncoder<SoundArea> {
+    override val prot: ServerProt = AndroidGameServerProt.SOUND_AREA
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: SoundArea) {
+        AndroidZoneProts.writeSoundArea(buffer, message)
+    }
+}
+
+/** Case 105: LOC_MERGE as a top-level packet (zone index 9; the client skips the payload). */
+public class AndroidLocMergeEncoder : MessageEncoder<LocMerge> {
+    override val prot: ServerProt = AndroidGameServerProt.LOC_MERGE
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: LocMerge) {
+        AndroidZoneProts.writeLocMerge(buffer, message)
