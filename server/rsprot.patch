+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcBodyCustomisationEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcCombatLevelChangeEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcExactMoveEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcFaceEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcFreezeEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcHeadCustomisationEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcHeadIconCustomisationEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcHeadbarEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcHitmarkEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcNameChangeEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcSayEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcSpotAnimEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcTintingEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcTransformationEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcTransparencyEncoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.extendedinfo.NpcVisibleOpsEncoder
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatarExtendedInfo
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatarExtendedInfoBlocks
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatarExtendedInfoWriter
+import net.rsprot.protocol.internal.game.outgoing.info.encoder.PrecomputedExtendedInfoEncoder
+import net.rsprot.protocol.internal.game.outgoing.info.npcinfo.encoder.NpcExtendedInfoEncoders
+import net.rsprot.protocol.internal.game.outgoing.info.shared.extendedinfo.Sequence
+
+@Suppress("DuplicatedCode")
+public class NpcAvatarExtendedInfoAndroidWriter :
+    NpcAvatarExtendedInfoWriter(
+        OldSchoolClientType.ANDROID,
+        NpcExtendedInfoEncoders(
+            OldSchoolClientType.ANDROID,
+            NpcSpotAnimEncoder(),
+            NpcSayEncoder(),
+            NpcVisibleOpsEncoder(),
+            NpcExactMoveEncoder(),
+            AndroidNpcSequenceEncoder(),
+            NpcTintingEncoder(),
+            NpcHeadIconCustomisationEncoder(),
+            NpcNameChangeEncoder(),
+            NpcHeadCustomisationEncoder(),
+            NpcBodyCustomisationEncoder(),
+            NpcTransformationEncoder(),
+            NpcCombatLevelChangeEncoder(),
+            NpcHitmarkEncoder(),
+            NpcHeadbarEncoder(),
+            NpcFaceEncoder(),
+            NpcBaseAnimationSetEncoder(),
+            NpcTransparencyEncoder(),
+            NpcFreezeEncoder(),
+        ),
+    ) {
+    override fun pExtendedInfo(
+        buffer: JagByteBuf,
+        localIndex: Int,
+        observerIndex: Int,
+        flag: Int,
+        blocks: NpcAvatarExtendedInfoBlocks,
+    ) {
+        // Android NPC extended info (NPC_INFO reader, Ghidra 0x569778): flag bytes chain with
+        // 0x20, 0x2000 and 0x20000. Only blocks with a verified Android layout are written, in the
+        // client's read order: 0x2 transformation, 0x1 sequence, 0x4 say. Anything else is dropped.
+        var clientFlag = 0
+        if (flag and NpcAvatarExtendedInfo.TRANSFORMATION != 0) clientFlag = clientFlag or ANDROID_TRANSFORMATION
+        if (flag and NpcAvatarExtendedInfo.SEQUENCE != 0) clientFlag = clientFlag or ANDROID_SEQUENCE
+        if (flag and NpcAvatarExtendedInfo.SAY != 0) clientFlag = clientFlag or ANDROID_SAY
+        buffer.p1(clientFlag)
+        if (clientFlag and ANDROID_TRANSFORMATION != 0) pCachedData(buffer, blocks.transformation)
+        if (clientFlag and ANDROID_SEQUENCE != 0) pCachedData(buffer, blocks.sequence)
+        if (clientFlag and ANDROID_SAY != 0) pCachedData(buffer, blocks.say)
+    }
+
+    private companion object {
+        private const val ANDROID_SEQUENCE: Int = 0x1
+        private const val ANDROID_TRANSFORMATION: Int = 0x2
+        private const val ANDROID_SAY: Int = 0x4
+    }
+}
+
+/** NPC flag 0x1: [id lo^0x80, hi][delay]. */
+public class AndroidNpcSequenceEncoder : PrecomputedExtendedInfoEncoder<Sequence> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: Sequence,
+    ): JagByteBuf =
+        alloc.buffer(3, 3).toJagByteBuf().also {
+            it.p2Alt3(extendedInfo.id.toInt())
+            it.p1(extendedInfo.delay.toInt())
+        }
+}
