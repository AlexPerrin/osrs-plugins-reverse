+            Row("moonlight_moth_low_wander", "npc.moth_moonlight_low_wander", "npc.moth_moonlight", "obj.butterfly_jar_moonmoth", "moth", 75, 84, MOONLIGHT, EFFECT_HEAL, "stat.prayer", 22, 0, 0),
