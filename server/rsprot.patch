+package net.rsprot.protocol.android
+
+import net.rsprot.protocol.game.incoming.codec.messaging.MessagePrivateDecoder
+import net.rsprot.protocol.game.incoming.messaging.MessagePrivate
+import net.rsprot.buffer.JagByteBuf
+import net.rsprot.protocol.ClientProt
+import net.rsprot.compression.provider.HuffmanCodecProvider
+import net.rsprot.protocol.game.incoming.buttons.If3Button
+import net.rsprot.protocol.game.incoming.codec.buttons.IfButtonXDecoder
+import net.rsprot.protocol.game.incoming.codec.messaging.MessagePublicDecoder
+import net.rsprot.protocol.game.incoming.codec.misc.user.ClientCheatDecoder
+import net.rsprot.protocol.game.incoming.messaging.MessagePublic
+import net.rsprot.protocol.game.incoming.misc.user.ClientCheat
+import net.rsprot.protocol.game.incoming.misc.user.MoveGameClick
+import net.rsprot.protocol.message.IncomingMessage
+import net.rsprot.protocol.game.incoming.resumed.ResumePauseButton
+import net.rsprot.protocol.util.CombinedId
+import net.rsprot.protocol.message.codec.MessageDecoder
+
+// Client packets identified by observing the live client (tap the world, log the payload).
+
+/** Opcode 31: [x lo^0x80, hi][z hi, lo^0x80][keyCombination ^0x80]. */
+public class AndroidMoveGameClickDecoder : MessageDecoder<MoveGameClick> {
+    override val prot: ClientProt = AndroidGameClientProt.MOVE_GAMECLICK
+
+    override fun decode(buffer: JagByteBuf): MoveGameClick {
+        val x = buffer.g2Alt3()
+        val z = buffer.g2Alt2()
+        val keyCombination = buffer.g1Alt1()
+        return MoveGameClick(x, z, keyCombination)
+    }
+}
+
+/**
+ * A desktop decoder reused under an Android opcode, for packets whose payload layout was observed
+ * to match desktop byte for byte.
+ */
+public class AndroidDelegatingDecoder<T : IncomingMessage>(
+    override val prot: ClientProt,
+    private val delegate: MessageDecoder<T>,
+) : MessageDecoder<T> {
+    override fun decode(buffer: JagByteBuf): T = delegate.decode(buffer)
+}
+
+/** Opcode 81: command string, autocomplete byte (observed: "pos\0" 00). */
+public fun androidClientCheatDecoder(): MessageDecoder<ClientCheat> =
+    AndroidDelegatingDecoder(AndroidGameClientProt.CLIENT_CHEAT, ClientCheatDecoder())
+
+/** Opcode 64: type, colour, effect, huffman text (observed: 00 00 00 05 838c70 = "hello"). */
+public fun androidMessagePublicDecoder(huffman: HuffmanCodecProvider): MessageDecoder<MessagePublic> =
+    AndroidDelegatingDecoder(AndroidGameClientProt.MESSAGE_PUBLIC, MessagePublicDecoder(huffman))
+
+/**
+ * Opcode 50: [name gjstr][huffman message], as desktop. Sender: CS2 op 5009 (0x1391) in FUN_005bdf14,
+ * which writes the name as a CP1252 C string and the message through the Huffman encoder FUN_008668f0.
+ */
+public fun androidMessagePrivateDecoder(huffman: HuffmanCodecProvider): MessageDecoder<MessagePrivate> =
+    AndroidDelegatingDecoder(AndroidGameClientProt.MESSAGE_PRIVATE, MessagePrivateDecoder(huffman))
+
+/** Opcode 99: combined id, sub, obj, op (observed: 02590030 ffff ffff 01 = 601:48 op 1). */
+public fun androidIfButtonXDecoder(): MessageDecoder<If3Button> =
+    AndroidDelegatingDecoder(AndroidGameClientProt.IF_BUTTONX, IfButtonXDecoder())
+
+/**
+ * Opcode 48: [component int LE][sub LE] (observed: 0500e700 ffff = 231:5 sub -1;
+ * 0100db00 0200 = 219:1 sub 2 for the second chatmenu option).
+ */
+public class AndroidResumePauseButtonDecoder : MessageDecoder<ResumePauseButton> {
+    override val prot: ClientProt = AndroidGameClientProt.RESUME_PAUSEBUTTON
+
+    override fun decode(buffer: JagByteBuf): ResumePauseButton {
+        val combinedId = buffer.g4Alt1()
+        val sub = buffer.g2Alt1()
+        return ResumePauseButton(CombinedId(combinedId), sub)
+    }
+}
+
+/**
+ * Reads one field with the transform named by [t]: `p1`, `p1a1` (b+128), `p1a2` (-b), `p1a3`
+ * (128-b), `p2` (big endian), `p2a1` (little endian), `p2a2` ([hi][lo+128]), `p2a3` ([lo+128][hi]).
+ */
+internal fun JagByteBuf.readField(t: String): Int =
+    when (t) {
+        "p1" -> g1()
+        "p1a1" -> g1Alt1()
+        "p1a2" -> g1Alt2()
+        "p1a3" -> g1Alt3()
+        "p2" -> g2()
+        "p2a1" -> g2Alt1()
+        "p2a2" -> g2Alt2()
+        "p2a3" -> g2Alt3()
+        "p4" -> g4()
+        "p4a1" -> g4Alt1()
+        "p4a3" -> g4Alt3()
+        else -> error("unknown field transform $t")
+    }
+
+/** Decodes a fixed field list given as "name:transform" pairs, in wire order. */
+internal fun JagByteBuf.readFields(spec: String): Map<String, Int> {
+    val out = HashMap<String, Int>()
+    for (f in spec.split(' ')) {
+        val (name, t) = f.split(':')
+        out[name] = readField(t)
+    }
+    return out
+}
+
+/**
+ * OPLOC1..5 (opcodes 7, 55, 58, 3, 66). Read from the client's sender (Ghidra 0x61d10c); the
+ * OPLOC6 (38) and OPLOCT (63) senders share its loc id helper (0x623b5c).
+ */
+public class AndroidOpLocDecoder(
+    override val prot: ClientProt,
+    private val op: Int,
+    private val spec: String,
+) : MessageDecoder<net.rsprot.protocol.game.incoming.locs.OpLocV2> {
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.locs.OpLocV2 {
+        val f = buffer.readFields(spec)
+        return net.rsprot.protocol.game.incoming.locs.OpLocV2(
+            f.getValue("id"), f.getValue("x"), f.getValue("z"), f.getValue("ctrl") == 1, op, f.getValue("subop"),
+        )
+    }
+}
+
+/** OPOBJ1..5 (opcodes 79, 24, 82, 34, 40), from the sender at Ghidra 0x62073c. */
+public class AndroidOpObjDecoder(
+    override val prot: ClientProt,
+    private val op: Int,
+    private val spec: String,
+) : MessageDecoder<net.rsprot.protocol.game.incoming.objs.OpObjV2> {
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.objs.OpObjV2 {
+        val f = buffer.readFields(spec)
+        return net.rsprot.protocol.game.incoming.objs.OpObjV2(
+            f.getValue("id"), f.getValue("x"), f.getValue("z"), f.getValue("ctrl") == 1, op, f.getValue("subop"),
+        )
+    }
+}
+
+/** OPNPC1..5 (opcodes 92, 44, 71, 33, 9), from the sender at Ghidra 0x61fc20. */
+public class AndroidOpNpcDecoder(
+    override val prot: ClientProt,
+    private val op: Int,
+    private val spec: String,
+) : MessageDecoder<net.rsprot.protocol.game.incoming.npcs.OpNpcV2> {
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.npcs.OpNpcV2 {
+        val f = buffer.readFields(spec)
+        return net.rsprot.protocol.game.incoming.npcs.OpNpcV2(
+            f.getValue("index"), f.getValue("ctrl") == 1, op, f.getValue("subop"),
+        )
+    }
+}
+
+internal val ANDROID_OPLOC: List<Triple<AndroidGameClientProt, Int, String>> =
+    listOf(
+        Triple(AndroidGameClientProt.OPLOC1, 1, "id:p2a2 subop:p1a3 x:p2a2 z:p2 ctrl:p1a2"),
+        Triple(AndroidGameClientProt.OPLOC2, 2, "id:p2a2 z:p2 subop:p1a1 x:p2a2 ctrl:p1a1"),
+        Triple(AndroidGameClientProt.OPLOC3, 3, "ctrl:p1 x:p2 z:p2a3 id:p2a1 subop:p1a3"),
+        Triple(AndroidGameClientProt.OPLOC4, 4, "x:p2 id:p2 ctrl:p1a2 z:p2a1 subop:p1a1"),
+        Triple(AndroidGameClientProt.OPLOC5, 5, "subop:p1a3 ctrl:p1a1 x:p2a3 z:p2a1 id:p2a1"),
+    )
+
+internal val ANDROID_OPOBJ: List<Triple<AndroidGameClientProt, Int, String>> =
+    listOf(
+        Triple(AndroidGameClientProt.OPOBJ1, 1, "id:p2 subop:p1a1 z:p2a2 x:p2 ctrl:p1a1"),
+        Triple(AndroidGameClientProt.OPOBJ2, 2, "id:p2a2 ctrl:p1a2 x:p2a3 subop:p1 z:p2a1"),
+        Triple(AndroidGameClientProt.OPOBJ3, 3, "x:p2a2 id:p2a1 ctrl:p1a1 subop:p1a1 z:p2a2"),
+        Triple(AndroidGameClientProt.OPOBJ4, 4, "subop:p1a1 ctrl:p1a2 id:p2a3 x:p2 z:p2a2"),
+        Triple(AndroidGameClientProt.OPOBJ5, 5, "id:p2a2 ctrl:p1a3 x:p2a3 z:p2a2 subop:p1a2"),
+    )
+
+internal val ANDROID_OPNPC: List<Triple<AndroidGameClientProt, Int, String>> =
+    listOf(
+        Triple(AndroidGameClientProt.OPNPC1, 1, "index:p2a3 ctrl:p1 subop:p1a1"),
+        Triple(AndroidGameClientProt.OPNPC2, 2, "index:p2 subop:p1 ctrl:p1a1"),
+        Triple(AndroidGameClientProt.OPNPC3, 3, "ctrl:p1 subop:p1 index:p2"),
+        Triple(AndroidGameClientProt.OPNPC4, 4, "subop:p1a1 ctrl:p1a3 index:p2a3"),
+        Triple(AndroidGameClientProt.OPNPC5, 5, "index:p2a2 ctrl:p1a2 subop:p1a1"),
+    )
+
+/**
+ * "Use selected item/spell on" packets. Fields: comb = selected component (interface << 16 |
+ * component), sub = selected slot, obj = selected obj. Senders: OPLOCT 0x61cfa8, OPOBJT 0x6205c4,
+ * OPNPCT 0x61f9fc.
+ */
+public class AndroidOpLocTDecoder : MessageDecoder<net.rsprot.protocol.game.incoming.locs.OpLocT> {
+    override val prot: ClientProt = AndroidGameClientProt.OPLOCT
+
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.locs.OpLocT {
+        val f = buffer.readFields("ctrl:p1a1 comb:p4a1 id:p2a1 sub:p2a3 obj:p2a2 x:p2 z:p2")
+        return net.rsprot.protocol.game.incoming.locs.OpLocT(
+            f.getValue("id"), f.getValue("x"), f.getValue("z"), f.getValue("ctrl") == 1,
+            CombinedId(f.getValue("comb")), f.getValue("sub"), f.getValue("obj"),
+        )
+    }
+}
+
+public class AndroidOpObjTDecoder : MessageDecoder<net.rsprot.protocol.game.incoming.objs.OpObjT> {
+    override val prot: ClientProt = AndroidGameClientProt.OPOBJT
+
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.objs.OpObjT {
+        val f = buffer.readFields("sub:p2 ctrl:p1a2 id:p2 comb:p4 z:p2a2 x:p2a2 obj:p2a1")
+        return net.rsprot.protocol.game.incoming.objs.OpObjT(
+            f.getValue("id"), f.getValue("x"), f.getValue("z"), f.getValue("ctrl") == 1,
+            CombinedId(f.getValue("comb")), f.getValue("sub"), f.getValue("obj"),
+        )
+    }
+}
+
+public class AndroidOpNpcTDecoder : MessageDecoder<net.rsprot.protocol.game.incoming.npcs.OpNpcT> {
+    override val prot: ClientProt = AndroidGameClientProt.OPNPCT
+
+    override fun decode(buffer: JagByteBuf): net.rsprot.protocol.game.incoming.npcs.OpNpcT {
+        val f = buffer.readFields("sub:p2a2 index:p2a2 comb:p4a3 ctrl:p1a3 obj:p2a3")
+        return net.rsprot.protocol.game.incoming.npcs.OpNpcT(
+            f.getValue("index"), f.getValue("ctrl") == 1,
+            CombinedId(f.getValue("comb")), f.getValue("sub"), f.getValue("obj"),
+        )
+    }
+}
