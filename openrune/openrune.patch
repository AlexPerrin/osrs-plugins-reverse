+                main = listOf(
+                    ImplingDrop(1539, 5, 5, false, 1, 10), // Steel nails
+                    ImplingDrop(1523, 1, 1, false, 1, 10), // Lockpick
+                    ImplingDrop(7936, 1, 1, false, 1, 10), // Pure essence
