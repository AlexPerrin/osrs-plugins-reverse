From 0a34089d1fd9704ef285f8df4870c7ec0b4c338c Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:34:29 -0400
Subject: [PATCH] Send the OSRS welcome message on login

RuneLite's Chat History plugin restores the previous chat only after it sees
"Welcome to Old School RuneScape." (ChatType.Welcome). A configured login
message starting with "Welcome to " is replaced by that text; other login
messages are sent as before.
---
 .../kotlin/org/rsmod/content/other/login/LoginScript.kt    | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/content/other/login/src/main/kotlin/org/rsmod/content/other/login/LoginScript.kt b/content/other/login/src/main/kotlin/org/rsmod/content/other/login/LoginScript.kt
index a325cee80..741ff0b66 100644
--- a/content/other/login/src/main/kotlin/org/rsmod/content/other/login/LoginScript.kt
+++ b/content/other/login/src/main/kotlin/org/rsmod/content/other/login/LoginScript.kt
@@ -107,10 +107,15 @@ constructor(
         client.write(HideObjOps(false))
     }
 
+    private val OSRS_WELCOME = "Welcome to Old School RuneScape."
+
     private fun Player.sendWelcomeMessage() {
         val message = realm.config.loginMessage
         message?.let {
-            mes(it.replace("RS Mod", config.name), ChatType.Welcome)
+            // RuneLite's Chat History restores the chat only after "Welcome to Old School RuneScape".
+            val text =
+                if (it.startsWith("Welcome to ")) OSRS_WELCOME else it.replace("RS Mod", config.name)
+            mes(text, ChatType.Welcome)
         }
 
         val broadcast = realm.config.loginBroadcast
-- 
2.43.0

