+package org.rsmod.content.other.treasuretrails
+
+import dev.openrune.rscm.RSCM.asRSCM
+import dev.openrune.rscm.RSCMType
+import dev.openrune.types.util.UncheckedType
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.parallel.Execution
+import org.junit.jupiter.api.parallel.ExecutionMode
+import org.rsmod.api.player.vars.VarPlayerIntMapSetter
+import org.rsmod.api.testing.GameTestState
+import org.rsmod.api.testing.scope.GameTestScope
+import org.rsmod.content.other.treasuretrails.StashUnitScript.Companion.UNITS
+import org.rsmod.content.other.treasuretrails.StashUnitScript.Companion.isFilled
+import org.rsmod.game.inv.InvObj
+import org.rsmod.map.CoordGrid
+
+@OptIn(UncheckedType::class)
+@Execution(ExecutionMode.SAME_THREAD)
+class StashUnitScriptTest {
+    @Test
+    fun `three beginner units with two items each`() {
+        assertEquals(3, UNITS.size)
+        assertEquals(listOf(0, 1, 2), UNITS.map { it.filledBit })
+        assertTrue(UNITS.all { it.varbit.startsWith("varbit.hh_constructed_beginner") })
+    }
+
+    @Test
+    fun GameTestState.`deposit and withdraw move exactly the unit's items`() =
+        runInjectedGameTest(StashUnitScript::class, null, StashUnitScript::class) { script ->
+            prepare()
+            val unit = UNITS.first { it.item1.internalName == "obj.gold_ring" }
+            val ring = unit.item1.internalName
+            val necklace = unit.item2.internalName
+            player.inv[0] = InvObj(ring.asRSCM(RSCMType.OBJ), 1)
+            with(script) {
+                player.withProtectedAccess { search(unit) }
+                assertEquals(1, player.inv.count(ring))
+                assertFalse(isFilled(player, unit))
+
+                VarPlayerIntMapSetter.set(player, unit.varbit, 1)
+                player.withProtectedAccess { search(unit) }
+                assertEquals(1, player.inv.count(ring))
+                assertFalse(isFilled(player, unit))
+
+                player.inv[1] = InvObj(necklace.asRSCM(RSCMType.OBJ), 1)
+                player.inv[2] = InvObj(necklace.asRSCM(RSCMType.OBJ), 1)
+                player.withProtectedAccess { search(unit) }
+                assertTrue(isFilled(player, unit))
+                assertEquals(0, player.inv.count(ring))
+                assertEquals(1, player.inv.count(necklace))
+                assertTrue(UNITS.filter { it !== unit }.none { isFilled(player, it) })
+
+                for (slot in 0 until player.inv.size) {
+                    if (player.inv[slot] == null) player.inv[slot] = InvObj("obj.logs".asRSCM(RSCMType.OBJ), 1)
+                }
+                player.inv[0] = null
+                player.withProtectedAccess { search(unit) }
+                assertTrue(isFilled(player, unit))
+                assertEquals(0, player.inv.count(ring))
+
+                player.inv[3] = null
+                player.withProtectedAccess { search(unit) }
+                assertFalse(isFilled(player, unit))
+                assertEquals(1, player.inv.count(ring))
+                assertEquals(2, player.inv.count(necklace))
+            }
+        }
+
+    private fun GameTestScope.prepare() {
+        val tile = CoordGrid(3206, 3423, 0)
+        allocZoneCollision(tile)
+        player.teleport(tile)
+        player.clearInv()
+    }
+}
diff --git a/content/other/treasure-trails/src/main/kotlin/org/rsmod/content/other/treasuretrails/BeginnerClueScript.kt b/content/other/treasure-trails/src/main/kotlin/org/rsmod/content/other/treasuretrails/BeginnerClueScript.kt
new file mode 100644
index 000000000..1eabf2fc7
--- /dev/null
+++ b/content/other/treasure-trails/src/main/kotlin/org/rsmod/content/other/treasuretrails/BeginnerClueScript.kt
@@ -0,0 +1,533 @@
+package org.rsmod.content.other.treasuretrails
+
+import dev.openrune.rscm.RSCM
+import dev.openrune.rscm.RSCM.asRSCM
+import dev.openrune.rscm.RSCMType
+import dev.openrune.types.ItemServerType
+import dev.openrune.types.NpcMode
+import jakarta.inject.Inject
+import jakarta.inject.Singleton
+import org.rsmod.api.config.Constants
+import org.rsmod.api.invtx.invAdd
+import org.rsmod.api.invtx.invClear
+import org.rsmod.api.npc.owner.assignSpawnOwner
+import org.rsmod.api.player.events.interact.NpcOverrideEvents
+import org.rsmod.api.player.hook.SpadeDigHook
+import org.rsmod.api.player.interact.NpcOpOverrides
+import org.rsmod.api.player.output.mes
+import org.rsmod.api.player.protect.ProtectedAccess
+import org.rsmod.api.player.vars.VarPlayerIntMapSetter
+import org.rsmod.api.random.GameRandom
+import org.rsmod.api.repo.npc.NpcRepository
+import org.rsmod.api.repo.obj.ObjRepository
+import org.rsmod.api.script.onCommand
+import org.rsmod.api.script.onEvent
+import org.rsmod.api.script.onIfClose
+import org.rsmod.api.script.onOpHeld1
+import org.rsmod.api.script.onOpHeld2
+import org.rsmod.api.script.onOpNpc1
+import org.rsmod.api.script.onPlayerLogout
+import org.rsmod.api.script.onProtectedEvent
+import org.rsmod.api.table.TrailBeginnerCasketRow
+import org.rsmod.api.table.TrailBeginnerStepsRow
+import org.rsmod.content.interfaces.emotes.PlayEmote
+import org.rsmod.game.MapClock
+import org.rsmod.game.cheat.Cheat
+import org.rsmod.game.entity.Npc
+import org.rsmod.game.entity.Player
+import org.rsmod.game.interact.InteractionOp
+import org.rsmod.map.CoordGrid
+import org.rsmod.plugin.scripts.PluginScript
+import org.rsmod.plugin.scripts.ScriptContext
+import org.rsmod.routefinder.collision.CollisionFlagMap
+import org.rsmod.routefinder.flag.CollisionFlag
+
+/**
+ * Beginner Treasure Trails (OSRS Wiki: Clue scroll (beginner), Reward casket (beginner)). A clue
+ * is 1-3 steps (10/45/45%), each a row of `trail_beginner_steps`: talk to an npc, perform an emote
+ * at a spot (Uri then appears and hands over the next step), dig at a map spot, bring Charlie the
+ * Tramp the item he asks for, or find a hot-cold spot with Reldo's strange device. Reading the
+ * scroll opens `trail_cluetext` (203) with the step's text, or the step's map interface (346-356):
+ * what RuneLite's Clue Scroll plugin reads. A finished trail leaves a reward casket, whose
+ * opening message and `trail_rewardinv` (141) contents are what the Loot Tracker records.
+ *
+ * Not done: scroll cases (and the scroll box stack limit), the 10-hour unique restriction.
+ */
+@Singleton
+class BeginnerClueScript
+@Inject
+constructor(
+    private val overrides: NpcOpOverrides,
+    private val npcRepo: NpcRepository,
+    private val objRepo: ObjRepository,
+    private val collision: CollisionFlagMap,
+    private val mapClock: MapClock,
+    private val random: GameRandom,
+) : PluginScript(), SpadeDigHook {
+    private val uris = HashMap<Player, Npc>()
+
+    fun uriOf(player: Player): Npc? = uris[player]
+
+    override fun ScriptContext.startup() {
+        onOpHeld1(CLUE) { read() }
+        onOpHeld2(CLUE) { checkSteps() }
+        onOpHeld1(DEVICE) { feelDevice() }
+        onOpHeld1(SCROLL_BOX) { openScrollBox() }
+        onOpHeld1(CASKET) { openCasketAndShow() }
+        onIfClose(REWARD_INTERFACE) { player.invClear(player.invMap.getOrPut(REWARD_INV)) }
+        for (npc in STEPS.mapNotNull { it.npc?.id }.toSet()) {
+            overrides.register(npc, InteractionOp.Op1) { player, _ -> npcStep(player)?.npc?.id == npc }
+            onProtectedEvent<NpcOverrideEvents.Op>(NpcOverrideEvents.key(npc, InteractionOp.Op1)) {
+                talkToStepNpc(it.npc)
+            }
+        }
+        onEvent<PlayEmote> { emoted(player, seq.id) }
+        onOpNpc1(URI) { talkToUri(it.npc) }
+        onPlayerLogout { uris.remove(player)?.let(::leave) }
+        onCommand("clue") {
+            desc = "Get a beginner clue scroll: ::clue [step, e.g. map_draynor_bank] [steps left]"
+            cheat(::giveClue)
+        }
+    }
+
+    private fun ProtectedAccess.read() {
+        val step = currentStep(player) ?: rollTrail(player)
+        val map = step.map
+        if (map != null) {
+            ifOpenMainModal(map)
+            return
+        }
+        val text =
+            if (step.type == CHARLIE_STEP && player.vars[CHARLIE_ASKED_VARP] == 0) {
+                CHARLIE_START_TEXT
+            } else {
+                step.text ?: ""
+            }
+        ifOpenMainModal(CLUE_TEXT_INTERFACE)
+        ifSetText(CLUE_TEXT, text)
+    }
+
+    fun ProtectedAccess.checkSteps() {
+        val done = player.vars[STEPS_DONE_VARP]
+        mes("You have completed $done ${if (done == 1) "step" else "steps"} on this clue scroll.")
+    }
+
+    private suspend fun ProtectedAccess.talkToStepNpc(npc: Npc) {
+        val step = npcStep(player) ?: return
+        if (step.npc?.id != npc.visType.id) return
+        when (step.type) {
+            CHARLIE_STEP -> talkToCharlie(npc, step)
+            HOT_COLD_STEP -> talkToReldo(npc)
+            else ->
+                startDialogue(npc) {
+                    chatNpc(neutral, "Well done.")
+                    access.completeStep()
+                }
+        }
+    }
+
+    private suspend fun ProtectedAccess.talkToCharlie(npc: Npc, step: TrailBeginnerStepsRow) {
+        val item = step.item1 ?: return
+        val request = step.request ?: return
+        val title = if (player.appearance.bodyType == Constants.bodytype_a) "sir" else "madam"
+        if (player.vars[CHARLIE_ASKED_VARP] == 0) {
+            startDialogue(npc) {
+                chatNpc(neutral, "Please, $title, can you help me.")
+                chatPlayer(neutral, "What can I do for you?")
+                chatNpc(neutral, request)
+                VarPlayerIntMapSetter.set(player, CHARLIE_ASKED_VARP, 1)
+                chatPlayer(happy, "Sure, I'll be glad to help a person in need.")
+            }
+            return
+        }
+        if (item.internalName !in inv) {
+            startDialogue(npc) { chatNpc(neutral, request) }
+            return
+        }
+        val result = handInToCharlie(step)
+        if (result == Advance.NONE) return
+        startDialogue(npc) {
+            mesbox("You give Charlie the ${item.name.lowercase()}.")
+            access.showAdvance(result, byWhom = "Charlie gives you")
+            chatNpc(happy, "Thank you so much $title.")
+        }
+    }
+
+    fun ProtectedAccess.handInToCharlie(step: TrailBeginnerStepsRow): Advance {
+        val item = step.item1?.internalName ?: return Advance.NONE
+        if (player.vars[CHARLIE_ASKED_VARP] == 0 || CLUE !in inv || item !in inv) return Advance.NONE
+        if (invDel(inv, item).failure) return Advance.NONE
+        return advanceTrail()
+    }
+
+    private suspend fun ProtectedAccess.talkToReldo(npc: Npc) {
+        if (playerContainsObj(DEVICE)) {
+            startDialogue(npc) {
+                chatPlayer(
+                    neutral,
+                    "Hey Reldo, I have one of those clue scrolls again, do you have any advice?",
+                )
+                chatNpc(
+                    neutral,
+                    "That strange device will guide you in the same way the key did. Feel it, but " +
+                        "be careful as it is very powerful. Good luck.",
+                )
+            }
+            return
+        }
+        startDialogue(npc) {
+            chatPlayer(neutral, "Hi Reldo, I have come to ask you to help with something.")
+            chatNpc(neutral, "What can I do for you ${player.displayName}?")
+            mesbox("You show Reldo your clue scroll.")
+            chatNpc(quiz, "Ah! Do you know about hot and cold clues?")
+            val knows = choice2("Yes, I do.", true, "No, I don't.", false)
+            if (knows) {
+                chatPlayer(neutral, "Yes, I do.")
+            } else {
+                chatPlayer(neutral, "No, I don't.")
+                chatNpc(
+                    neutral,
+                    "Ah, you use a strange device to tell you how far away you are from the place " +
+                        "you need to be. When you get to your destination you dig.",
+                )
+            }
+            chatNpc(neutral, "Well then use this strange device to feel where your destination is and dig.")
+            if (access.inv.freeSpace() == 0) {
+                chatNpc(neutral, "You should make some room for it before I can give you it.")
+                return@startDialogue
+            }
+            access.invAdd(access.inv, DEVICE)
+        }
+    }
+
+    fun ProtectedAccess.feelDevice() {
+        val step = currentStep(player)
+        if (step?.type != HOT_COLD_STEP || CLUE !in inv) {
+            mes("Nothing interesting happens.")
+            return
+        }
+        mes(deviceMessage(player, step))
+    }
+
+    fun deviceMessage(player: Player, step: TrailBeginnerStepsRow): String {
+        val distance =
+            if (player.coords.level == step.coord.level) {
+                player.coords.chebyshevDistance(step.coord)
+            } else {
+                Int.MAX_VALUE - 1
+            }
+        val last = player.vars[HOT_COLD_LAST_VARP] - 1
+        VarPlayerIntMapSetter.set(player, HOT_COLD_LAST_VARP, distance + 1)
+        val temperature = TEMPERATURES.first { distance >= it.first }.second
+        return when {
+            last < 0 -> "The device is $temperature."
+            distance < last -> "The device is $temperature, and warmer than last time."
+            distance > last -> "The device is $temperature, but colder than last time."
+            else -> "The device is $temperature, and the same temperature as last time."
+        }
+    }
+
+    fun emoted(player: Player, seq: Int) {
+        val step = currentStep(player) ?: return
+        if (step.type != EMOTE_STEP || step.emote?.asRSCM(RSCMType.SEQ) != seq) return
+        if (CLUE !in player.inv || !step.covers(player.coords)) return
+        if (uris[player]?.isSlotAssigned == true) return
+        val uri = Npc(URI, besideTile(player.coords))
+        uri.mode = NpcMode.None
+        npcRepo.add(uri, URI_LIFETIME)
+        uri.assignSpawnOwner(player, mapClock.cycle)
+        uri.facePlayer(player)
+        uris[player] = uri
+    }
+
+    private suspend fun ProtectedAccess.talkToUri(uri: Npc) {
+        val step = currentStep(player)
+        val owned = uris[player] === uri
+        if (!owned || step?.type != EMOTE_STEP || !wearsItems(player, step)) {
+            startDialogue(uri) { chatNpc(neutral, "I do not believe we have any business, Comrade.") }
+            return
+        }
+        uris.remove(player)
+        startDialogue(uri) {
+            chatNpc(neutral, random.pick(URI_LINES))
+            chatPlayer(confused, "What?")
+            access.completeStep()
+        }
+        leave(uri)
+    }
+
+    override fun claims(player: Player): Boolean {
+        val step = currentStep(player) ?: return false
+        val digStep = step.type == MAP_STEP || step.type == HOT_COLD_STEP
+        return digStep && CLUE in player.inv && step.covers(player.coords)
+    }
+
+    override suspend fun ProtectedAccess.dig() {
+        completeStep()
+    }
+
+    private suspend fun ProtectedAccess.completeStep() {
+        showAdvance(advanceTrail(), byWhom = null)
+    }
+
+    private suspend fun ProtectedAccess.showAdvance(result: Advance, byWhom: String?) {
+        when (result) {
+            Advance.NEXT_CLUE -> objbox(CLUE, if (byWhom == null) "You've found a new clue!" else "$byWhom a new clue!")
+            Advance.CASKET -> objbox(CASKET, if (byWhom == null) "You've obtained a casket!" else "$byWhom a casket!")
+            Advance.NONE -> Unit
+        }
+    }
+
+    fun ProtectedAccess.advanceTrail(): Advance {
+        if (CLUE !in inv) return Advance.NONE
+        val left = player.vars[STEPS_LEFT_VARP] - 1
+        if (left > 0) {
+            val done = player.vars[STEPS_DONE_VARP] + 1
+            setStep(player, pickStep(currentStep(player)), left)
+            VarPlayerIntMapSetter.set(player, STEPS_DONE_VARP, done)
+            return Advance.NEXT_CLUE
+        }
+        if (invDel(inv, CLUE).failure) return Advance.NONE
+        clearTrail(player)
+        invAdd(inv, CASKET)
+        return Advance.CASKET
+    }
+
+    enum class Advance {
+        NONE,
+        NEXT_CLUE,
+        CASKET,
+    }
+
+    fun ProtectedAccess.openScrollBox() {
+        if (playerContainsObj(CLUE)) {
+            mes("The clue box refuses to open - you already have a clue.")
+            return
+        }
+        if (invDel(inv, SCROLL_BOX).failure) return
+        invAdd(inv, CLUE)
+    }
+
+    private fun ProtectedAccess.openCasketAndShow() {
+        val rewards = openCasket() ?: return
+        val rewardInv = player.invMap.getOrPut(REWARD_INV)
+        invClear(rewardInv)
+        for (reward in rewards) {
+            invAdd(rewardInv, reward.obj.internalName, reward.count, cert = reward.noted, strict = false)
+        }
+        invTransmit(rewardInv)
+        ifOpenMainModal(REWARD_INTERFACE)
+    }
+
+    fun ProtectedAccess.openCasket(): List<Reward>? {
+        val freed = if (inv.count(CASKET) == 1) 1 else 0
+        if (inv.freeSpace() + freed < MAX_ROLLS) {
+            mes("You need at least $MAX_ROLLS free inventory spaces to open the casket.")
+            return null
+        }
+        if (invDel(inv, CASKET).failure) return null
+        val completed = player.vars[COMPLETED_VARP] + 1
+        VarPlayerIntMapSetter.set(player, COMPLETED_VARP, completed)
+        invClear(player.invMap.getOrPut(REWARD_INV))
+        mes("Well done, you've completed the Treasure Trail!")
+        val plural = if (completed == 1) "" else "s"
+        mes("You have completed <col=ef1020>$completed</col> beginner Treasure Trail$plural.")
+        val rewards = rollRewards(random.of(1, MAX_ROLLS)) { random.of(it) }
+        for (reward in rewards) {
+            val obj = reward.obj.internalName
+            if (invAdd(inv, obj, reward.count, cert = reward.noted).failure) {
+                invAddOrDrop(objRepo, obj, reward.count)
+            }
+        }
+        return rewards
+    }
+
+    fun giveClue(cheat: Cheat) {
+        val player = cheat.player
+        val name = cheat.args.getOrNull(0)
+        val step =
+            if (name == null) {
+                pickStep(null)
+            } else {
+                STEPS.firstOrNull { STEP_NAMES[STEPS.indexOf(it)] == name }
+            }
+        if (step == null) {
+            player.mes("Steps: ${STEP_NAMES.joinToString()}")
+            return
+        }
+        if (CLUE !in player.inv && player.invAdd(player.inv, CLUE).failure) {
+            player.mes("You need a free inventory space.")
+            return
+        }
+        val left = cheat.args.getOrNull(1)?.toIntOrNull()?.coerceIn(1, MAX_STEPS) ?: 1
+        setStep(player, step, left)
+        VarPlayerIntMapSetter.set(player, STEPS_DONE_VARP, 0)
+        player.mes("Beginner clue: ${STEP_NAMES[STEPS.indexOf(step)]}, $left step(s) left.")
+    }
+
+    private fun rollTrail(player: Player): TrailBeginnerStepsRow {
+        val roll = random.of(100)
+        val steps = if (roll < 10) 1 else if (roll < 55) 2 else 3
+        val step = pickStep(null)
+        setStep(player, step, steps)
+        VarPlayerIntMapSetter.set(player, STEPS_DONE_VARP, 0)
+        return step
+    }
+
+    /**
+     * Picks the next step: every talk, emote and map row is one choice, all Charlie rows together
+     * are one, and all hot-cold rows together are one. Never the same choice as [previous].
+     */
+    fun pickStep(previous: TrailBeginnerStepsRow?): TrailBeginnerStepsRow {
+        val choices = STEPS.groupBy { stepGroup(it) }.values.toList()
+        val group = random.pick(choices.filter { previous == null || stepGroup(it[0]) != stepGroup(previous) })
+        return random.pick(group)
+    }
+
+    private fun setStep(player: Player, step: TrailBeginnerStepsRow, left: Int) {
+        VarPlayerIntMapSetter.set(player, STEP_VARP, step.rowId)
+        VarPlayerIntMapSetter.set(player, STEPS_LEFT_VARP, left)
+        VarPlayerIntMapSetter.set(player, CHARLIE_ASKED_VARP, 0)
+        VarPlayerIntMapSetter.set(player, HOT_COLD_LAST_VARP, 0)
+    }
+
+    private fun clearTrail(player: Player) {
+        VarPlayerIntMapSetter.set(player, STEP_VARP, 0)
+        VarPlayerIntMapSetter.set(player, STEPS_LEFT_VARP, 0)
+        VarPlayerIntMapSetter.set(player, STEPS_DONE_VARP, 0)
+        VarPlayerIntMapSetter.set(player, CHARLIE_ASKED_VARP, 0)
+        VarPlayerIntMapSetter.set(player, HOT_COLD_LAST_VARP, 0)
+    }
+
+    /** The current step if it is one that an npc's Talk-to completes or moves on. */
+    fun npcStep(player: Player): TrailBeginnerStepsRow? =
+        currentStep(player)?.takeIf { it.npc != null && it.type != EMOTE_STEP && CLUE in player.inv }
+
+    fun talkStep(player: Player): TrailBeginnerStepsRow? = npcStep(player)?.takeIf { it.type == TALK_STEP }
+
+    private fun wearsItems(player: Player, step: TrailBeginnerStepsRow): Boolean =
+        listOfNotNull(step.item1, step.item2).all { it.internalName in player.worn }
+
+    private fun leave(npc: Npc) {
+        if (npc.isSlotAssigned) npcRepo.del(npc, Int.MAX_VALUE)
+    }
+
+    private fun besideTile(centre: CoordGrid): CoordGrid {
+        for ((x, z) in ADJACENT_OFFSETS) {
+            val candidate = centre.translate(x, z)
+            if (collision[candidate.x, candidate.z, candidate.level] and BLOCKED_FLAGS == 0) {
+                return candidate
+            }
+        }
+        return centre
+    }
+
+    data class Reward(val obj: ItemServerType, val count: Int, val noted: Boolean)
+
+    companion object {
+        const val CLUE = "obj.trail_clue_beginner"
+        const val SCROLL_BOX = "obj.league_clue_box_beginner"
+        const val DEVICE = "obj.beginner_device"
+        const val CASKET = "obj.trail_reward_casket_beginner"
+        const val URI = "npc.trail_beginner_uri"
+        const val CLUE_TEXT_INTERFACE = "interface.trail_cluetext"
+        const val CLUE_TEXT = "component.trail_cluetext:text"
+        const val REWARD_INTERFACE = "interface.trail_rewardscreen"
+        const val REWARD_INV = "inv.trail_rewardinv"
+        const val STEP_VARP = "varp.trail_beginner_step"
+        const val STEPS_LEFT_VARP = "varp.trail_beginner_steps_left"
+        const val COMPLETED_VARP = "varp.trail_beginner_completed"
+        const val STEPS_DONE_VARP = "varp.trail_beginner_steps_done"
+        const val CHARLIE_ASKED_VARP = "varp.trail_beginner_charlie_asked"
+        const val HOT_COLD_LAST_VARP = "varp.trail_beginner_hot_cold_last"
+        const val TALK_STEP = 0
+        const val EMOTE_STEP = 1
+        const val MAP_STEP = 2
+        const val CHARLIE_STEP = 3
+        const val HOT_COLD_STEP = 4
+        const val CHARLIE_START_TEXT = "Talk to Charlie the Tramp in Varrock."
+
+        /** OSRS Wiki, Strange device: the reading for a Chebyshev distance of at least `first`. */
+        val TEMPERATURES =
+            listOf(
+                500 to "ice cold",
+                200 to "very cold",
+                150 to "cold",
+                100 to "warm",
+                70 to "hot",
+                30 to "very hot",
+                4 to "incredibly hot",
+                0 to "visibly shaking",
+            )
+
+        private fun stepGroup(step: TrailBeginnerStepsRow): Int =
+            when (step.type) {
+                CHARLIE_STEP,
+                HOT_COLD_STEP -> -step.type
+                else -> step.rowId
+            }
+        const val MAX_STEPS = 3
+        const val MAX_ROLLS = 3
+        const val URI_LIFETIME = 100
+        const val CASKET_TOTAL_WEIGHT = 44280
+        const val BLOCKED_FLAGS = CollisionFlag.BLOCK_WALK or CollisionFlag.BLOCK_PLAYERS
+        val ADJACENT_OFFSETS =
+            listOf(-1 to 0, 1 to 0, 0 to -1, 0 to 1, -1 to -1, 1 to -1, -1 to 1, 1 to 1)
+
+        val STEPS: List<TrailBeginnerStepsRow> by lazy { TrailBeginnerStepsRow.all() }
+        val STEP_NAMES: List<String> by lazy {
+            STEPS.map {
+                RSCM.getReverseMapping(RSCMType.DBROW, it.rowId).removePrefix("dbrow.trail_beginner_")
+            }
+        }
+        val CASKET_REWARDS: List<TrailBeginnerCasketRow> by lazy { TrailBeginnerCasketRow.all() }
+
+        val URI_LINES =
+            listOf(
+                "A great captain is always ready to change course.",
+                "Actions have consequences.",
+                "Can I have your teabag?",
+                "I am the egg man, are you one of the egg men?",
+                "I believe that it is very rainy in Varrock.",
+                "I quite fancy an onion.",
+                "My magic carpet is full of eels.",
+                "Once, I was a poor man, but then I found a party hat.",
+                "The slowest of fishermen catch the swiftest of fish.",
+                "What's cheese?",
+                "Would you like to buy a pewter spoon?",
+            )
+
+        fun currentStep(player: Player): TrailBeginnerStepsRow? {
+            val row = player.vars[STEP_VARP]
+            return STEPS.firstOrNull { it.rowId == row }
+        }
+
+        fun TrailBeginnerStepsRow.covers(coords: CoordGrid): Boolean =
+            coords.level == coord.level && coords.chebyshevDistance(coord) <= radius
+
+        /** [rolls] picks from the casket table; [nextInt] returns 0 until its bound (exclusive). */
+        fun rollRewards(rolls: Int, nextInt: (Int) -> Int): List<Reward> {
+            val rewards = mutableListOf<Reward>()
+            repeat(rolls) {
+                val row = pickReward(nextInt(CASKET_TOTAL_WEIGHT))
+                val count = if (row.max > row.min) row.min + nextInt(row.max - row.min + 1) else row.min
+                val same = rewards.indexOfFirst { it.obj.id == row.obj.id }
+                if (same >= 0) {
+                    rewards[same] = rewards[same].copy(count = rewards[same].count + count)
+                } else {
+                    rewards += Reward(row.obj, count, row.noted)
+                }
+            }
+            return rewards
+        }
+
+        private fun pickReward(roll: Int): TrailBeginnerCasketRow {
+            var left = roll
+            for (row in CASKET_REWARDS) {
+                if (left < row.weight) return row
+                left -= row.weight
+            }
+            error("Casket roll $roll is past the table's total weight")
+        }
+    }
+}
