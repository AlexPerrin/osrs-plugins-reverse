+
+    @Test
+    fun GameTestState.`rake, plant, grow and harvest an allotment`() =
+        runInjectedGameTest(FarmingScript::class, null, FarmingScript::class) { script ->
+            script.clock = Clock.fixed(start, ZoneOffset.UTC)
+            prepare()
