From b8fd6c1629a9e4fb9d0c880304150495bd1ef136 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 19:49:18 -0400
Subject: [PATCH] Gameframe: never select the fullscreen world map frame at
 login

A desktop login whose saved gameframe does not match the client mode falls back
to the first gameframe with the same resizable and stone-arrangement flags.
Opening the fullscreen world map sets the stone-arrangement varbit, and the
fullscreen map gameframe (toplevel_display) has the same flags as pre-EoC, so the
fallback could pick it. The player then logged in to a black frame without the
map, and the choice was saved, so every later login repeated it.

Skip the fullscreen map frame in the fallback and the intermediate-frame lookup,
and treat a saved fullscreen frame as missing at login.
---
 .../gameframe/script/GameframeScript.kt       | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/content/interfaces/gameframe/src/main/kotlin/org/rsmod/content/interfaces/gameframe/script/GameframeScript.kt b/content/interfaces/gameframe/src/main/kotlin/org/rsmod/content/interfaces/gameframe/script/GameframeScript.kt
index 7af3c1d93..2282ee9cc 100644
--- a/content/interfaces/gameframe/src/main/kotlin/org/rsmod/content/interfaces/gameframe/script/GameframeScript.kt
+++ b/content/interfaces/gameframe/src/main/kotlin/org/rsmod/content/interfaces/gameframe/script/GameframeScript.kt
@@ -64,7 +64,7 @@ class GameframeScript @Inject internal constructor(private val eventBus: EventBu
     }
 
     private fun Player.openLoginGameframe() {
-        val gameframe = gameframes[gameframeTopLevel]
+        val gameframe = gameframes[gameframeTopLevel]?.takeIf { it.isLoginSelectable() }
         if (gameframe != null && gameframe.resizable == ui.frameResizable) {
             ifOpenTop(gameframe.topLevel)
             openGameframe(gameframe, eventBus)
@@ -135,12 +135,22 @@ class GameframeScript @Inject internal constructor(private val eventBus: EventBu
             if (!requiresIntermediate) {
                 return null
             }
-            return gameframes.values.first { it.hasFlags(resizable = true, stoneArrangements) }
+            return gameframes.values.first {
+                it.isLoginSelectable() && it.hasFlags(resizable = true, stoneArrangements)
+            }
         }
 
         private fun Gameframe.hasFlags(resizable: Boolean, stoneArrangements: Boolean): Boolean {
             return this.resizable == resizable && this.stoneArrangement == stoneArrangements
         }
+
+        /**
+         * The fullscreen world map shares the resizable + stone-arrangement flags with pre-EoC, so
+         * flag-based selection could pick it and leave the player on a black frame without the map.
+         */
+        private fun Gameframe.isLoginSelectable(): Boolean = topLevel != FULLSCREEN_MAP_TOPLEVEL
+
+        private const val FULLSCREEN_MAP_TOPLEVEL = "interface.toplevel_display"
     }
 
     public fun Player.changeGameframe(move: GameframeMove) {
@@ -172,11 +182,12 @@ class GameframeScript @Inject internal constructor(private val eventBus: EventBu
     }
 
     private fun selectFallback(resizable: Boolean, stoneArrangements: Boolean): Gameframe? {
-        val priority = gameframes.values.firstOrNull { it.hasFlags(resizable, stoneArrangements) }
+        val candidates = gameframes.values.filter { it.isLoginSelectable() }
+        val priority = candidates.firstOrNull { it.hasFlags(resizable, stoneArrangements) }
         if (priority != null) {
             return priority
         }
-        return gameframes.values.firstOrNull { it.resizable == resizable }
+        return candidates.firstOrNull { it.resizable == resizable }
     }
 
     private fun loadAll() {
