@@ -0,0 +1,256 @@
+package org.rsmod.content.other.treasuretrails
+
+import dev.openrune.rscm.RSCM.asRSCM
+import dev.openrune.rscm.RSCMType
+import dev.openrune.types.util.UncheckedType
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.parallel.Execution
+import org.junit.jupiter.api.parallel.ExecutionMode
+import org.rsmod.api.player.vars.VarPlayerIntMapSetter
+import org.rsmod.api.testing.GameTestState
+import org.rsmod.api.testing.scope.GameTestScope
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Advance
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.CASKET
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.CASKET_REWARDS
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.CASKET_TOTAL_WEIGHT
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.CHARLIE_ASKED_VARP
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.CLUE
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.COMPLETED_VARP
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.REWARD_INV
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.SCROLL_BOX
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.STEPS
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.STEPS_DONE_VARP
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.STEPS_LEFT_VARP
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.STEP_NAMES
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.currentStep
+import org.rsmod.content.other.treasuretrails.BeginnerClueScript.Companion.rollRewards
+import org.rsmod.game.cheat.Cheat
+import org.rsmod.game.inv.InvObj
+import org.rsmod.map.CoordGrid
+
+@OptIn(UncheckedType::class)
+@Execution(ExecutionMode.SAME_THREAD)
+class BeginnerClueScriptTest {
+    private val draynorBankDig = CoordGrid(3092, 3226, 0)
+
+    @Test
+    fun `casket rolls follow the flattened wiki table`() {
+        assertEquals(CASKET_TOTAL_WEIGHT, CASKET_REWARDS.sumOf { it.weight })
+        assertEquals(74, CASKET_REWARDS.size)
+        val first = rollRewards(1) { 0 }.single()
+        assertEquals("obj.mole_slippers", first.obj.internalName)
+        val last = rollRewards(1) { it - 1 }.single()
+        assertEquals("obj.herring", last.obj.internalName)
+        assertEquals(9, last.count)
+        assertTrue(last.noted)
+        val twice = rollRewards(2) { 0 }.single()
+        assertEquals(2, twice.count)
+    }
+
+    @Test
+    fun `every step has its text, npc, emote or map`() {
+        assertEquals(34, STEPS.size)
+        for ((step, name) in STEPS.zip(STEP_NAMES)) {
+            when (step.type) {
+                BeginnerClueScript.TALK_STEP -> assertNotNull(step.npc, name)
+                BeginnerClueScript.EMOTE_STEP -> assertNotNull(step.emote?.asRSCM(RSCMType.SEQ), name)
+                BeginnerClueScript.MAP_STEP -> assertNotNull(step.map?.asRSCM(RSCMType.INTERFACE), name)
+                BeginnerClueScript.CHARLIE_STEP -> {
+                    assertEquals("npc.tramppg", step.npc?.internalName, name)
+                    assertNotNull(step.item1, name)
+                    assertTrue(step.request!!.startsWith("I really need "), name)
+                }
+                BeginnerClueScript.HOT_COLD_STEP -> assertEquals("npc.reldo", step.npc?.internalName, name)
+                else -> error("Unknown step type ${step.type} for $name")
+            }
+            if (step.type != BeginnerClueScript.MAP_STEP) assertNotNull(step.text, name)
+        }
+        assertTrue(STEP_NAMES.contains("anagram_ranael"))
+    }
+
+    @Test
+    fun GameTestState.`a three step trail ends in one casket`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            script.giveClue(Cheat(player, "clue", listOf("map_draynor_bank", "3")))
+            assertEquals(1, player.inv.count(CLUE))
+            assertEquals("map_draynor_bank", stepName())
+            assertTrue(script.claims(player))
+            with(script) {
+                var result = Advance.NONE
+                player.withProtectedAccess { result = advanceTrail() }
+                assertEquals(Advance.NEXT_CLUE, result)
+                assertEquals(2, player.vars[STEPS_LEFT_VARP])
+                player.withProtectedAccess { result = advanceTrail() }
+                assertEquals(Advance.NEXT_CLUE, result)
+                player.withProtectedAccess { result = advanceTrail() }
+                assertEquals(Advance.CASKET, result)
+                assertEquals(0, player.inv.count(CLUE))
+                assertEquals(1, player.inv.count(CASKET))
+                assertNull(currentStep(player))
+                player.withProtectedAccess { result = advanceTrail() }
+                assertEquals(Advance.NONE, result)
+                assertEquals(1, player.inv.count(CASKET))
+            }
+        }
+
+    @Test
+    fun GameTestState.`steps need the clue and the right place or npc`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            script.giveClue(Cheat(player, "clue", listOf("map_draynor_bank")))
+            val away = CoordGrid(3095, 3226, 0)
+            allocZoneCollision(away)
+            player.teleport(away)
+            assertFalse(script.claims(player))
+            script.giveClue(Cheat(player, "clue", listOf("anagram_ranael")))
+            assertEquals("npc.ranael", script.talkStep(player)?.npc?.internalName)
+            player.clearInv()
+            assertNull(script.talkStep(player))
+            script.giveClue(Cheat(player, "clue", listOf("emote_flynn")))
+            script.emoted(player, "seq.emote_dance_spin".asRSCM(RSCMType.SEQ))
+            assertNull(script.uriOf(player))
+        }
+
+    @Test
+    fun GameTestState.`the casket needs space and pays out exactly the reward inv`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            for (slot in 0 until player.inv.size) {
+                player.inv[slot] = InvObj("obj.logs".asRSCM(RSCMType.OBJ), 1)
+            }
+            player.inv[0] = InvObj(CASKET.asRSCM(RSCMType.OBJ), 2)
+            with(script) {
+                var rewards: List<BeginnerClueScript.Reward>? = null
+                player.withProtectedAccess { rewards = openCasket() }
+                assertNull(rewards)
+                assertEquals(2, player.inv.count(CASKET))
+                assertEquals(0, player.vars[COMPLETED_VARP])
+
+                player.inv[1] = null
+                player.inv[2] = null
+                player.inv[3] = null
+                val logs = player.inv.count("obj.logs")
+                player.withProtectedAccess { rewards = openCasket() }
+                assertEquals(1, player.inv.count(CASKET))
+                assertEquals(1, player.vars[COMPLETED_VARP])
+                assertEquals(logs, player.inv.count("obj.logs"))
+                val rolled = checkNotNull(rewards)
+                assertTrue(rolled.isNotEmpty() && rolled.size <= 3)
+                assertTrue(player.invMap.getOrPut(REWARD_INV).objs.all { it == null })
+                val received = player.inv.objs.filterNotNull().filter {
+                    it.id != CASKET.asRSCM(RSCMType.OBJ) && it.id != "obj.logs".asRSCM(RSCMType.OBJ)
+                }
+                assertEquals(rolled.sumOf { it.count }, received.sumOf { it.count })
+            }
+        }
+
+    @Test
+    fun GameTestState.`a scroll box only opens without a clue`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            player.inv[0] = InvObj(SCROLL_BOX.asRSCM(RSCMType.OBJ), 1)
+            player.inv[1] = InvObj(CLUE.asRSCM(RSCMType.OBJ), 1)
+            with(script) {
+                player.withProtectedAccess { openScrollBox() }
+                assertEquals(1, player.inv.count(SCROLL_BOX))
+                assertEquals(1, player.inv.count(CLUE))
+                player.inv[1] = null
+                player.withProtectedAccess { openScrollBox() }
+                assertEquals(0, player.inv.count(SCROLL_BOX))
+                assertEquals(1, player.inv.count(CLUE))
+            }
+        }
+
+    @Test
+    fun GameTestState.`the next step is never from the same group`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            val charlie = STEPS.first { it.type == BeginnerClueScript.CHARLIE_STEP }
+            val hotCold = STEPS.first { it.type == BeginnerClueScript.HOT_COLD_STEP }
+            repeat(200) {
+                assertTrue(script.pickStep(charlie).type != BeginnerClueScript.CHARLIE_STEP)
+                assertTrue(script.pickStep(hotCold).type != BeginnerClueScript.HOT_COLD_STEP)
+            }
+        }
+
+    @Test
+    fun GameTestState.`check steps counts the steps done`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            script.giveClue(Cheat(player, "clue", listOf("map_draynor_bank", "3")))
+            with(script) {
+                assertEquals(0, player.vars[STEPS_DONE_VARP])
+                player.withProtectedAccess { advanceTrail() }
+                assertEquals(1, player.vars[STEPS_DONE_VARP])
+                player.withProtectedAccess { advanceTrail() }
+                assertEquals(2, player.vars[STEPS_DONE_VARP])
+                player.withProtectedAccess { advanceTrail() }
+                assertEquals(0, player.vars[STEPS_DONE_VARP])
+            }
+        }
+
+    @Test
+    fun GameTestState.`charlie takes exactly his item once he has asked`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            prepare()
+            script.giveClue(Cheat(player, "clue", listOf("charlie_raw_herring", "2")))
+            val step = checkNotNull(currentStep(player))
+            val herring = "obj.raw_herring"
+            player.inv[1] = InvObj(herring.asRSCM(RSCMType.OBJ), 1)
+            player.inv[2] = InvObj(herring.asRSCM(RSCMType.OBJ), 1)
+            with(script) {
+                var result = Advance.CASKET
+                player.withProtectedAccess { result = handInToCharlie(step) }
+                assertEquals(Advance.NONE, result)
+                assertEquals(2, player.inv.count(herring))
+                VarPlayerIntMapSetter.set(player, CHARLIE_ASKED_VARP, 1)
+                player.withProtectedAccess { result = handInToCharlie(step) }
+                assertEquals(Advance.NEXT_CLUE, result)
+                assertEquals(1, player.inv.count(herring))
+                assertEquals(0, player.vars[CHARLIE_ASKED_VARP])
+                assertEquals(1, player.inv.count(CLUE))
+                player.withProtectedAccess { result = handInToCharlie(step) }
+                assertEquals(Advance.NONE, result)
+                assertEquals(1, player.inv.count(herring))
+            }
+        }
+
+    @Test
+    fun GameTestState.`the strange device reads the distance to the spot`() =
+        runInjectedGameTest(BeginnerClueScript::class, null, BeginnerClueScript::class) { script ->
+            val spot = CoordGrid(3120, 3282, 0)
+            prepare()
+            script.giveClue(Cheat(player, "clue", listOf("hot_cold_draynor_wheat_field")))
+            val step = checkNotNull(currentStep(player))
+            fun feelAt(dx: Int): String {
+                val tile = spot.translate(dx, 0)
+                allocZoneCollision(tile)
+                player.teleport(tile)
+                return script.deviceMessage(player, step)
+            }
+            assertEquals("The device is warm.", feelAt(120))
+            assertEquals("The device is very hot, and warmer than last time.", feelAt(40))
+            assertEquals("The device is very hot, and the same temperature as last time.", feelAt(40))
+            assertEquals("The device is ice cold, but colder than last time.", feelAt(600))
+            assertEquals("The device is incredibly hot, and warmer than last time.", feelAt(4))
+            assertEquals("The device is visibly shaking, and warmer than last time.", feelAt(3))
+            assertTrue(script.claims(player))
+            feelAt(5)
+            assertFalse(script.claims(player))
+        }
+
+    private fun GameTestScope.stepName(): String? =
+        currentStep(player)?.let { STEP_NAMES[STEPS.indexOf(it)] }
+
+    private fun GameTestScope.prepare() {
+        allocZoneCollision(draynorBankDig)
+        player.teleport(draynorBankDig)
+        player.clearInv()
+    }
+}
