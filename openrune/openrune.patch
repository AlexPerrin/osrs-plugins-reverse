+@OptIn(UncheckedType::class)
+@Execution(ExecutionMode.SAME_THREAD)
+class FarmingScriptTest {
+    private val start = Instant.parse("2026-10-16T12:03:00Z")
+    private val catherby = AREAS[0].patches
