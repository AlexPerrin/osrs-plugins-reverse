+        val slot = slotOf(obj)
+        val held = checkNotNull(player.inv[slot])
+        interact(*options) {
+            val event =
+                when (op) {
+                    1 -> HeldObjEvents.Op1(slot, held, type, player.inv)
+                    else -> HeldObjEvents.Op2(slot, held, type, player.inv)
+                }
+            assertTrue(events.publish(it, event))
+        }
+    }
