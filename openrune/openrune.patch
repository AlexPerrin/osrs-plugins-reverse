@@ -0,0 +1,164 @@
+package org.rsmod.content.quest.area
+
+import dev.openrune.ServerCacheManager
+import dev.openrune.rscm.RSCM.asRSCM
+import kotlin.coroutines.Continuation
+import kotlin.coroutines.EmptyCoroutineContext
