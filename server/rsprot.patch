index 00000000..b1436285
--- /dev/null
+++ b/protocol/osrs-241/osrs-241-android/src/main/kotlin/net/rsprot/protocol/android/AndroidPlayerHitsEncoders.kt
@@ -0,0 +1,142 @@
+package net.rsprot.protocol.android
+
+import net.rsprot.buffer.JagByteBuf
+import net.rsprot.protocol.internal.game.outgoing.info.encoder.OnDemandExtendedInfoEncoder
+import net.rsprot.protocol.internal.game.outgoing.info.shared.extendedinfo.HeadbarList
+import net.rsprot.protocol.internal.game.outgoing.info.shared.extendedinfo.HitmarkList
+import net.rsprot.protocol.message.toIntOrMinusOne
+
+/**
+ * Player flag 0x40000: [count b^0x80] then per hit [type smart][value smart][delay smart][limit smart]
+ * (reader in Ghidra 0x669a04; the client passes them to 0x572240(type, value, delay, cycle, limit)).
+ */
+public class AndroidPlayerHitEncoder : OnDemandExtendedInfoEncoder<HitmarkList> {
+    override fun encode(
+        buffer: JagByteBuf,
+        localPlayerIndex: Int,
+        updatedAvatarIndex: Int,
+        extendedInfo: HitmarkList,
+    ) {
+        val countMarker = buffer.writerIndex()
+        buffer.skipWrite(1)
+        var count = 0
+        for (hit in extendedInfo.elements) {
+            val type =
+                when (localPlayerIndex) {
+                    (hit.sourceIndex - 0x10_000) -> hit.sourceType
+                    updatedAvatarIndex -> hit.selfType
+                    else -> hit.otherType
+                }
+            if (type == UShort.MAX_VALUE) continue
+            buffer.pSmart1or2(type.toInt())
+            buffer.pSmart1or2(hit.value.toInt())
+            buffer.pSmart1or2(hit.delay.toInt())
+            buffer.pSmart1or2(hit.limit.toInt())
+            if (++count >= 0xFF) break
+        }
+        val writerIndex = buffer.writerIndex()
+        buffer.writerIndex(countMarker)
+        buffer.p1Alt1(count)
+        buffer.writerIndex(writerIndex)
+    }
+}
+
+/**
+ * Player flag 0x20000: [count] then per bar [type smart][endTime smart], and unless endTime is
+ * 0x7FFF (remove): [startTime smart][startFill -b], plus [endFill 128-b] when endTime != 0.
+ */
+public class AndroidPlayerHeadbarEncoder : OnDemandExtendedInfoEncoder<HeadbarList> {
+    override fun encode(
+        buffer: JagByteBuf,
+        localPlayerIndex: Int,
+        updatedAvatarIndex: Int,
+        extendedInfo: HeadbarList,
+    ) {
+        val countMarker = buffer.writerIndex()
+        buffer.skipWrite(1)
+        var count = 0
+        for (headBar in extendedInfo.elements) {
+            val isSelf =
+                localPlayerIndex == updatedAvatarIndex ||
+                    localPlayerIndex == (headBar.sourceIndex - 0x10_000)
+            val type = if (isSelf) headBar.selfType.toIntOrMinusOne() else headBar.otherType.toIntOrMinusOne()
+            if (type == -1) continue
+            buffer.pSmart1or2(type)
+            val endTime = headBar.endTime.toInt()
+            buffer.pSmart1or2(endTime)
+            if (endTime != 0x7FFF) {
+                buffer.pSmart1or2(headBar.startTime.toInt())
+                buffer.p1Alt2(headBar.startFill.toInt())
+                if (endTime != 0) buffer.p1Alt3(headBar.endFill.toInt())
+            }
+            if (++count >= 0xFF) break
+        }
+        val writerIndex = buffer.writerIndex()
+        buffer.writerIndex(countMarker)
+        buffer.p1(count)
+        buffer.writerIndex(writerIndex)
+    }
+}
+
+/** NPC flag 0x40000: [count] then per hit [type][value][delay][limit], all smart1or2 (0x569778). */
+public class AndroidNpcHitmarkEncoder : OnDemandExtendedInfoEncoder<HitmarkList> {
+    override fun encode(
+        buffer: JagByteBuf,
+        localPlayerIndex: Int,
+        updatedAvatarIndex: Int,
+        extendedInfo: HitmarkList,
+    ) {
+        val countMarker = buffer.writerIndex()
+        buffer.skipWrite(1)
+        var count = 0
+        for (hit in extendedInfo.elements) {
+            val tinted = localPlayerIndex == (hit.sourceIndex - 0x10_000)
+            val type = if (tinted) hit.selfType else hit.otherType
+            if (type == UShort.MAX_VALUE) continue
+            buffer.pSmart1or2(type.toInt())
+            buffer.pSmart1or2(hit.value.toInt())
+            buffer.pSmart1or2(hit.delay.toInt())
+            buffer.pSmart1or2(hit.limit.toInt())
+            if (++count >= 0xFF) break
+        }
+        val writerIndex = buffer.writerIndex()
+        buffer.writerIndex(countMarker)
+        buffer.p1(count)
+        buffer.writerIndex(writerIndex)
+    }
+}
+
+/**
+ * NPC flag 0x1000000: [count -b] then per bar [type smart][endTime smart], and unless endTime is
+ * 0x7FFF: [startTime smart][startFill b^0x80], plus [endFill] when endTime != 0.
+ */
+public class AndroidNpcHeadbarEncoder : OnDemandExtendedInfoEncoder<HeadbarList> {
+    override fun encode(
+        buffer: JagByteBuf,
+        localPlayerIndex: Int,
+        updatedAvatarIndex: Int,
+        extendedInfo: HeadbarList,
+    ) {
+        val countMarker = buffer.writerIndex()
+        buffer.skipWrite(1)
+        var count = 0
+        for (headBar in extendedInfo.elements) {
+            val isSelf = localPlayerIndex == (headBar.sourceIndex - 0x10_000)
+            val type = if (isSelf) headBar.selfType.toIntOrMinusOne() else headBar.otherType.toIntOrMinusOne()
+            if (type == -1) continue
+            buffer.pSmart1or2(type)
+            val endTime = headBar.endTime.toInt()
+            buffer.pSmart1or2(endTime)
+            if (endTime != 0x7FFF) {
+                buffer.pSmart1or2(headBar.startTime.toInt())
+                buffer.p1Alt1(headBar.startFill.toInt())
+                if (endTime != 0) buffer.p1(headBar.endFill.toInt())
+            }
+            if (++count >= 0xFF) break
+        }
+        val writerIndex = buffer.writerIndex()
+        buffer.writerIndex(countMarker)
+        buffer.p1Alt2(count)
+        buffer.writerIndex(writerIndex)
+    }
+}
