{
  "permissions": {
    "ask": [
      "Bash(gh repo fork*)",
      "Bash(gh pr create*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh pr close*)",
      "Bash(gh pr reopen*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh release*)",
      "Bash(gh gist*)",
      "Bash(gh api -X PATCH*)",
      "Bash(gh api -X POST*)",
      "Bash(gh api -X PUT*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field*)",
      "Bash(gh api * --raw-field*)",
      "Bash(gh api * --input*)",
      "Bash(gh api graphql*)",
      "Bash(git -C re/upstream-pr/or push*)",
      "Bash(git push fork*)",
      "Bash(openrune/upstream/open-batch-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/publish_gate.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "client-dev",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py client" }]
      },
      {
        "matcher": "client-qa",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py client-qa" }]
      },
      {
        "matcher": "server-dev",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py server" }]
      },
      {
        "matcher": "server-qa",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py server-qa" }]
      }
    ]
  }
}
