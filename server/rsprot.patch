+public class AndroidObjAddSpecificEncoder : MessageEncoder<ObjAddSpecific> {
+    override val prot: ServerProt = AndroidGameServerProt.OBJ_ADD_SPECIFIC
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: ObjAddSpecific) {
+        buffer.p2(message.timeUntilPublic)
+        buffer.p4Alt3(message.coordGrid.packed)
+        buffer.p1Alt2(message.ownershipType)
+        buffer.p1Alt2(if (message.neverBecomesPublic) 1 else 0)
+        buffer.p2(message.id)
+        buffer.p2Alt2(message.timeUntilDespawn)
+        buffer.p1Alt2(message.opFlags.toInt())
+        buffer.p4(message.quantity)
+    }
+}
+
+/** Case 109: [coord LE int][id hi, lo^0x80][quantity LE int]. */
+public class AndroidObjDelSpecificEncoder : MessageEncoder<ObjDelSpecific> {
+    override val prot: ServerProt = AndroidGameServerProt.OBJ_DEL_SPECIFIC
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: ObjDelSpecific) {
+        buffer.p4Alt1(message.coordGrid.packed)
+        buffer.p2Alt2(message.id)
+        buffer.p4Alt1(message.quantity)
+    }
+}
+
+/** Case 28: [anim LE][component BE int]. */
+public class AndroidIfSetAnimEncoder : MessageEncoder<IfSetAnim> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETANIM
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetAnim) {
