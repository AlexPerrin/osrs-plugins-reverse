+import net.rsprot.protocol.game.outgoing.map.StaticRebuildMessageV2
+import net.rsprot.protocol.game.outgoing.misc.client.ServerTickEnd
+import net.rsprot.protocol.game.outgoing.misc.player.UpdateRunEnergy
+import net.rsprot.protocol.game.outgoing.misc.player.UpdateRunWeight
+import net.rsprot.protocol.game.outgoing.misc.player.UpdateStatV2
+import net.rsprot.protocol.game.outgoing.varp.VarpLarge
+import net.rsprot.protocol.game.outgoing.varp.VarpSmall
+import net.rsprot.protocol.game.outgoing.worldentity.SetActiveWorldV2
+import net.rsprot.protocol.common.game.outgoing.inv.InventoryObject
+import net.rsprot.protocol.game.outgoing.codec.inv.UpdateInvPartialEncoder
+import net.rsprot.protocol.game.outgoing.inv.UpdateInvFull
+import net.rsprot.protocol.game.outgoing.inv.UpdateInvPartial
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.NpcInfoLargeV6Encoder
+import net.rsprot.protocol.game.outgoing.codec.npcinfo.NpcInfoSmallV6Encoder
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcInfoLargeV6
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcInfoSmallV6
+import net.rsprot.protocol.game.outgoing.specific.ObjAddSpecific
+import net.rsprot.protocol.game.outgoing.specific.ObjDelSpecific
+import net.rsprot.protocol.game.outgoing.codec.misc.player.RunClientScriptEncoder
+import net.rsprot.protocol.game.outgoing.misc.player.RunClientScript
+import net.rsprot.protocol.message.OutgoingMessage
+import net.rsprot.protocol.message.codec.MessageEncoder
+import net.rsprot.protocol.game.outgoing.misc.player.MessageGame
+import net.rsprot.protocol.game.outgoing.codec.misc.player.MessageGameEncoder
+
+// Each encoder mirrors the matching case of the Android packet dispatcher (Ghidra 0x541dd4).
+// Client reads -> server writes: b^0x80 = p1Alt1, -b = p1Alt2, 128-b = p1Alt3,
+// [lo^0x80, hi] = p2Alt3, [hi, lo^0x80] = p2Alt2, raw native int = p4Alt1 (little endian),
+// byte-swapped native int/short = p4/p2 (big endian).
+
+/** Case 2: [current p1][boosted 128-b][stat ^0x80][xp int LE]. */
+public class AndroidUpdateStatV2Encoder : MessageEncoder<UpdateStatV2> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_STAT_V2
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateStatV2) {
+        buffer.p1(message.currentLevel)
+        buffer.p1Alt3(message.invisibleBoostedLevel)
+        buffer.p1Alt1(message.stat)
+        buffer.p4Alt1(message.experience)
+    }
+}
+
+/**
+ * Case 6 (reader Ghidra 0x65524c): [worldArea lo^0x80, hi][zoneX BE][zoneZ BE]. For the login
+ * variant the gpi init block precedes these fields; the login handler (Ghidra 0x51aa80) reads it
+ * first, which matches RSProt's footer placement of the encoded fields.
+ */
+public class AndroidRebuildNormalV2Encoder : MessageEncoder<StaticRebuildMessageV2> {
+    override val prot: ServerProt = AndroidGameServerProt.REBUILD_NORMAL_V2
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: StaticRebuildMessageV2) {
+        buffer.p2Alt3(message.worldArea)
+        buffer.p2(message.zoneX)
+        buffer.p2(message.zoneZ)
+    }
+}
+
+/**
+ * Case 32: [combined id BE int][inventory BE][capacity BE], then per slot
+ * [id+1 hi, lo^0x80][count ^0x80][count p4Alt3 if >= 255].
+ */
+public class AndroidUpdateInvFullEncoder : MessageEncoder<UpdateInvFull> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_INV_FULL
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateInvFull) {
+        buffer.p4(message.combinedId)
+        buffer.p2(message.inventoryId)
+        val capacity = message.capacity
+        buffer.p2(capacity)
+        for (i in 0..<capacity) {
+            val obj = message.getObject(i)
+            if (obj == InventoryObject.NULL) {
+                buffer.p2Alt2(0)
+                buffer.p1Alt1(0)
+                continue
+            }
+            buffer.p2Alt2(InventoryObject.getId(obj) + 1)
+            val count = InventoryObject.getCount(obj)
+            buffer.p1Alt1(count.coerceAtMost(0xFF))
+            if (count >= 0xFF) buffer.p4Alt3(count)
+        }
+        message.returnInventory()
+    }
+}
+
+/** Case 8: same layout as desktop. */
+public fun androidUpdateInvPartialEncoder(): MessageEncoder<UpdateInvPartial> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.UPDATE_INV_PARTIAL, UpdateInvPartialEncoder())
+
+/** Case 26: signed BE short. */
+public class AndroidUpdateRunWeightEncoder : MessageEncoder<UpdateRunWeight> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_RUNWEIGHT
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateRunWeight) {
+        buffer.p2(message.runweight)
+    }
+}
+
+/** Case 30: two plain bytes. */
+public class AndroidSetNpcUpdateOriginEncoder : MessageEncoder<SetNpcUpdateOrigin> {
+    override val prot: ServerProt = AndroidGameServerProt.SET_NPC_UPDATE_ORIGIN
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: SetNpcUpdateOrigin) {
+        buffer.p1(message.originX)
+        buffer.p1(message.originZ)
+    }
+}
+
+/** Case 34: [value -b][id BE]. */
+public class AndroidVarpSmallEncoder : MessageEncoder<VarpSmall> {
+    override val prot: ServerProt = AndroidGameServerProt.VARP_SMALL
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: VarpSmall) {
+        buffer.p1Alt2(message.value)
+        buffer.p2(message.id)
+    }
+}
+
+/** Case 46: no payload. */
+public class AndroidLogoutEncoder : MessageEncoder<Logout> {
+    override val prot: ServerProt = AndroidGameServerProt.LOGOUT
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: Logout) {
+    }
+}
+
+/** Case 55: no payload, bumps the client's server-tick counter. */
+public class AndroidServerTickEndEncoder : MessageEncoder<ServerTickEnd> {
+    override val prot: ServerProt = AndroidGameServerProt.SERVER_TICK_END
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: ServerTickEnd) {
+    }
+}
+
+/** Case 59: [end BE][events1 p4Alt3][combined id BE][events2 LE][start lo^0x80, hi]. */
+public class AndroidIfSetEventsV2Encoder : MessageEncoder<IfSetEventsV2> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETEVENTS_V2
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetEventsV2) {
+        buffer.p2(message.end)
+        buffer.p4Alt3(message.events1)
+        buffer.p4(message.combinedId)
+        buffer.p4Alt1(message.events2)
+        buffer.p2Alt3(message.start)
+    }
+}
+
+/** Case 64: [id hi, lo^0x80][value int LE]. */
+public class AndroidVarpLargeEncoder : MessageEncoder<VarpLarge> {
+    override val prot: ServerProt = AndroidGameServerProt.VARP_LARGE
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: VarpLarge) {
+        buffer.p2Alt2(message.id)
+        buffer.p4Alt1(message.value)
+    }
+}
+
+/** Case 72: [destination combined id BE int][type 128-b][interface hi, lo^0x80]. */
+public class AndroidIfOpenSubEncoder : MessageEncoder<IfOpenSub> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_OPENSUB
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfOpenSub) {
+        buffer.p4(message.destinationCombinedId)
+        buffer.p1Alt3(message.type)
+        buffer.p2Alt2(message.interfaceId)
+    }
+}
+
+/** Case 75: [interface lo^0x80, hi]. */
+public class AndroidIfOpenTopEncoder : MessageEncoder<IfOpenTop> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_OPENTOP
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfOpenTop) {
+        buffer.p2Alt3(message.interfaceId)
+    }
+}
+
+/** Case 90 (reader Ghidra 0x669a04): the bit-level layout is shared with desktop. */
+public class AndroidPlayerInfoEncoder : MessageEncoder<PlayerInfoPacket> {
+    override val prot: ServerProt = AndroidGameServerProt.PLAYER_INFO
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: PlayerInfoPacket) {
+        buffer.buffer.writeBytes(message.content())
+    }
+}
+
+/** Case 99: [world index BE][level]; same as desktop. */
+public class AndroidSetActiveWorldV2Encoder : MessageEncoder<SetActiveWorldV2> {
+    override val prot: ServerProt = AndroidGameServerProt.SET_ACTIVE_WORLD_V2
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: SetActiveWorldV2) {
+        when (val type = message.worldType) {
+            is SetActiveWorldV2.RootWorldType -> {
+                buffer.p2(WorldEntityInfo.ROOT_WORLD)
+                buffer.p1(type.activeLevel)
+            }
+            is SetActiveWorldV2.DynamicWorldType -> {
+                buffer.p2(type.index)
+                buffer.p1(type.activeLevel)
+            }
+        }
+    }
+}
+
+/** Case 102: BE short. */
+public class AndroidUpdateRunEnergyEncoder : MessageEncoder<UpdateRunEnergy> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_RUNENERGY
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateRunEnergy) {
+        buffer.p2(message.runenergy)
+    }
+}
+
+/**
+ * A desktop encoder reused under an Android opcode, for packets whose case in the dispatcher
+ * reads exactly the desktop layout.
+ */
+public class AndroidDelegatingEncoder<T : OutgoingMessage>(
+    override val prot: ServerProt,
+    private val delegate: MessageEncoder<T>,
+) : MessageEncoder<T> {
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: T) {
+        delegate.encode(streamCipher, buffer, message)
+    }
+}
+
+/** Case 81: smart type, has-name byte, [name], message (as desktop). */
+public fun androidMessageGameEncoder(): MessageEncoder<MessageGame> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.MESSAGE_GAME, MessageGameEncoder())
+
+/** Case 150 (reader Ghidra 0x569778, 6-bit deltas): the bit layout is built by RSProt's NpcInfo. */
+public fun androidNpcInfoSmallV6Encoder(): MessageEncoder<NpcInfoSmallV6> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.NPC_INFO_SMALL_V6, NpcInfoSmallV6Encoder())
+
+/** Case 145 (same reader, 8-bit deltas). */
+public fun androidNpcInfoLargeV6Encoder(): MessageEncoder<NpcInfoLargeV6> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.NPC_INFO_LARGE_V6, NpcInfoLargeV6Encoder())
+
+/**
+ * Case 42: [timeUntilPublic BE][coord p4Alt3][ownership -b][neverBecomesPublic -b][id BE]
+ * [timeUntilDespawn hi, lo^0x80][opFlags -b][quantity BE int].
+ */
+public class AndroidObjAddSpecificEncoder : MessageEncoder<ObjAddSpecific> {
+    override val prot: ServerProt = AndroidGameServerProt.OBJ_ADD_SPECIFIC
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: ObjAddSpecific) {
+        buffer.p2(message.timeUntilPublic)
+        buffer.p4Alt3(message.coordGrid.packed)
+        buffer.p1Alt2(message.ownershipType)
+        buffer.p1Alt2(if (message.neverBecomesPublic) 1 else 0)
+        buffer.p2(message.id)
+        buffer.p2Alt2(message.timeUntilDespawn)
+        buffer.p1Alt2(message.opFlags.toInt())
+        buffer.p4(message.quantity)
+    }
+}
+
+/** Case 109: [coord LE int][id hi, lo^0x80][quantity LE int]. */
+public class AndroidObjDelSpecificEncoder : MessageEncoder<ObjDelSpecific> {
+    override val prot: ServerProt = AndroidGameServerProt.OBJ_DEL_SPECIFIC
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: ObjDelSpecific) {
+        buffer.p4Alt1(message.coordGrid.packed)
+        buffer.p2Alt2(message.id)
+        buffer.p4Alt1(message.quantity)
+    }
+}
+
+/** Case 28: [anim LE][component BE int]. */
+public class AndroidIfSetAnimEncoder : MessageEncoder<IfSetAnim> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETANIM
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetAnim) {
+        buffer.p2Alt1(message.anim)
+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 47: [component p4Alt3][npc slot hi, lo^0x80]. */
+public class AndroidIfSetNpcHeadActiveEncoder : MessageEncoder<IfSetNpcHeadActive> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETNPCHEAD_ACTIVE
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetNpcHeadActive) {
+        buffer.p4Alt3(message.combinedId)
+        buffer.p2Alt2(message.index)
+    }
+}
+
+/** Case 62: [component BE int][npc id LE]. */
+public class AndroidIfSetNpcHeadEncoder : MessageEncoder<IfSetNpcHead> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETNPCHEAD
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetNpcHead) {
+        buffer.p4(message.combinedId)
+        buffer.p2Alt1(message.npc)
+    }
+}
+
+/** Case 101: [component BE int]. */
+public class AndroidIfCloseSubEncoder : MessageEncoder<IfCloseSub> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_CLOSESUB
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfCloseSub) {
+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 122: [component p4Alt3][text]. */
+public class AndroidIfSetTextEncoder : MessageEncoder<IfSetText> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETTEXT
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetText) {
+        buffer.p4Alt3(message.combinedId)
+        buffer.pjstr(message.text)
+    }
+}
+
+/** Case 10: type string, args in reverse type order, script id BE int (as desktop). */
+public fun androidRunClientScriptEncoder(): MessageEncoder<RunClientScript> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.RUNCLIENTSCRIPT, RunClientScriptEncoder())
+
+/** Case 77: [hidden: 1 -> 0x7f (128-b)][component BE int]. */
+public class AndroidIfSetHideEncoder : MessageEncoder<net.rsprot.protocol.game.outgoing.interfaces.IfSetHide> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETHIDE
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.interfaces.IfSetHide,
+    ) {
+        buffer.p1Alt3(if (message.hidden) 1 else 0)
+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 79: [component p4Alt3] (bytes >>16, >>24, >>0, >>8). */
+public class AndroidIfSetPlayerHeadEncoder : MessageEncoder<net.rsprot.protocol.game.outgoing.interfaces.IfSetPlayerHead> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETPLAYERHEAD
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.interfaces.IfSetPlayerHead,
+    ) {
+        buffer.p4Alt3(message.combinedId)
+    }
+}
