+/** The price line of `[proc,examine_price_info]` (6005) / `[proc,script6006]`, or null if none. */
+public fun examinePriceInfo(
+    name: String,
+    count: Long,
+    withCount: Boolean,
+    market: Boolean,
+    marketPrice: Long,
+    alchable: Boolean,
+    highAlch: Long,
+    lowAlch: Long,
+): String? {
+    var line = ""
+    if (market) {
+        line = pricePart(line, "GE", marketPrice, count)
+    }
+    if (alchable) {
+        if (highAlch > 0) {
+            line = pricePart(line, "HA", highAlch, count)
+        }
+        if (lowAlch > 0) {
+            line = pricePart(line, "LA", lowAlch, count)
+        }
+    }
+    if (line.isEmpty()) {
+        return null
+    }
+    return when {
+        !withCount -> "Price: $line"
+        count > 1 -> "Price of ${spacer(count)} x $name: $line"
+        else -> "Price of $name: $line"
+    }
