From 9a80318ffccf98046b7de6418abe0951af40a132 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:34:21 -0400
Subject: [PATCH] Match OSRS wording and chat types of skilling messages

Small differences from OSRS that client plugins parse:
- Mining and star mining: "You swing your pick at the rock."
- Fishing: "You catch a shrimp." (no "raw ", trailing full stop)
- Cooking: "You successfully cook the shrimps." / "You accidentally burn
  the shrimps." use the cooked item's name, sent as spam (filtered) messages
- Smelting ("You retrieve a bar of ...") and cannonballs ("You remove the
  cannonballs from the mould.") are spam messages, as in OSRS.
---
 .../content/skills/shootingstars/scripts/StarMiningScript.kt  | 2 +-
 .../kotlin/org/rsmod/content/skills/cooking/CookingEvents.kt  | 4 ++--
 .../org/rsmod/content/skills/fishing/scripts/Fishing.kt       | 4 ++--
 .../kotlin/org/rsmod/content/skills/mining/scripts/Mining.kt  | 2 +-
 .../org/rsmod/content/skills/smithing/CannonBallScript.kt     | 2 +-
 .../rsmod/content/skills/smithing/smelting/SmeltingScript.kt  | 2 +-
 6 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/content/events/shooting-stars/src/main/kotlin/org/rsmod/content/skills/shootingstars/scripts/StarMiningScript.kt b/content/events/shooting-stars/src/main/kotlin/org/rsmod/content/skills/shootingstars/scripts/StarMiningScript.kt
index 91f0017b9..be27eaed8 100644
--- a/content/events/shooting-stars/src/main/kotlin/org/rsmod/content/skills/shootingstars/scripts/StarMiningScript.kt
+++ b/content/events/shooting-stars/src/main/kotlin/org/rsmod/content/skills/shootingstars/scripts/StarMiningScript.kt
@@ -66,7 +66,7 @@ constructor(
         } else {
             val pickaxe = Mining.findPickaxe(player) ?: return
             anim(pickaxeAnim(pickaxe))
-            spam("You swing your pickaxe at the rock.")
+            spam("You swing your pick at the rock.")
             mine(rock)
         }
     }
diff --git a/content/skills/cooking/src/main/kotlin/org/rsmod/content/skills/cooking/CookingEvents.kt b/content/skills/cooking/src/main/kotlin/org/rsmod/content/skills/cooking/CookingEvents.kt
index dc68e7964..5ad59359d 100644
--- a/content/skills/cooking/src/main/kotlin/org/rsmod/content/skills/cooking/CookingEvents.kt
+++ b/content/skills/cooking/src/main/kotlin/org/rsmod/content/skills/cooking/CookingEvents.kt
@@ -213,12 +213,12 @@ class CookingEvents @Inject constructor(
 
         if (burned) {
             invAdd(inv, food.burnt.internalName, 1)
-            mes("You accidentally burn the ${food.raw.name}.")
+            spam("You accidentally burn the ${food.cooked.name.lowercase()}.")
         } else {
             invAdd(inv, food.cooked.internalName, 1)
             val xpModifier = xpMods.get(player, "stat.cooking")
             statAdvance("stat.cooking", food.xp.toDouble() * xpModifier)
-            mes("You successfully cook the ${food.raw.name}.")
+            spam("You successfully cook the ${food.cooked.name.lowercase()}.")
         }
     }
 
diff --git a/content/skills/fishing/src/main/kotlin/org/rsmod/content/skills/fishing/scripts/Fishing.kt b/content/skills/fishing/src/main/kotlin/org/rsmod/content/skills/fishing/scripts/Fishing.kt
index 09ea6418a..2d80936b6 100644
--- a/content/skills/fishing/src/main/kotlin/org/rsmod/content/skills/fishing/scripts/Fishing.kt
+++ b/content/skills/fishing/src/main/kotlin/org/rsmod/content/skills/fishing/scripts/Fishing.kt
@@ -279,9 +279,9 @@ constructor(
             return
         }
 
-        val name = type.name.lowercase()
+        val name = type.name.lowercase().removePrefix("raw ")
         val article = if (active.article == "some") "some" else if (name.firstOrNull() in vowels) "an" else "a"
-        spam("You catch $article $name")
+        spam("You catch $article $name.")
         if (infernalHarpoon) {
             cookInfernalCatch(item, product.count)
         }
diff --git a/content/skills/mining/src/main/kotlin/org/rsmod/content/skills/mining/scripts/Mining.kt b/content/skills/mining/src/main/kotlin/org/rsmod/content/skills/mining/scripts/Mining.kt
index d5436b90c..7996755f3 100644
--- a/content/skills/mining/src/main/kotlin/org/rsmod/content/skills/mining/scripts/Mining.kt
+++ b/content/skills/mining/src/main/kotlin/org/rsmod/content/skills/mining/scripts/Mining.kt
@@ -98,7 +98,7 @@ constructor(
                 return
             }
             anim(miningAnim(pickaxe, data))
-            spam("You swing your pickaxe at the rock.")
+            spam("You swing your pick at the rock.")
             mine(rock, type)
         }
     }
diff --git a/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/CannonBallScript.kt b/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/CannonBallScript.kt
index dd7c61d52..366a28005 100644
--- a/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/CannonBallScript.kt
+++ b/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/CannonBallScript.kt
@@ -111,7 +111,7 @@ class CannonBallScript : PluginScript() {
         )
         delay(1)
 
-        mes("You remove the cannonballs from the mould.")
+        spam("You remove the cannonballs from the mould.")
         if (invAdd(inv, ball.output.internalName, ballsPerSmelt).success) {
             statAdvance("stat.smithing", ball.xp * barsPerSmelt.toDouble())
         }
diff --git a/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/smelting/SmeltingScript.kt b/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/smelting/SmeltingScript.kt
index a28095cd2..68553dd32 100644
--- a/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/smelting/SmeltingScript.kt
+++ b/content/skills/smithing/src/main/kotlin/org/rsmod/content/skills/smithing/smelting/SmeltingScript.kt
@@ -255,7 +255,7 @@ class SmeltingScript @Inject constructor(private val xpMods: XpModifiers) : Plug
                 val xp = SmithingSmeltXp.resolve(player, inv, bar, isSuperHeat, xpMods, regularFurnace)
                 statAdvance("stat.smithing", xp)
                 val metal = SmithingUtils.itemName(bar.output, "bar").removeSuffix(" bar").lowercase()
-                mes("You retrieve a bar of $metal.")
+                spam("You retrieve a bar of $metal.")
                 if (outputCount > 1) {
                     val barName = SmithingUtils.itemName(bar.output, "bar")
                     mes("Your Varrock armour helps you smelt an extra $barName.")
-- 
