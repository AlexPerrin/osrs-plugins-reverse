From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:37:36 -0400
Subject: [PATCH] Log the player out on the client's IDLE packet

The client sends IDLE when its AFK timer runs out; OSRS then logs the player
out. Handle it like the logout button (manualLogout), so combat still blocks
it; ignored while a logout is already under way.
---
 .../api/net/rsprot/handlers/IdleHandler.kt    | 16 +++++++++++++
 .../provider/MessageConsumerProvider.kt       |  4 ++++
 .../net/rsprot/handlers/IdleHandlerTest.kt    | 24 +++++++++++++++++++
 3 files changed, 44 insertions(+)
 create mode 100644 api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/IdleHandler.kt
 create mode 100644 api/net/src/test/kotlin/org/rsmod/api/net/rsprot/handlers/IdleHandlerTest.kt

diff --git a/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/IdleHandler.kt b/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/IdleHandler.kt
new file mode 100644
index 000000000..dc9224eca
--- /dev/null
+++ b/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/IdleHandler.kt
@@ -0,0 +1,16 @@
+package org.rsmod.api.net.rsprot.handlers
+
+import net.rsprot.protocol.game.incoming.misc.client.Idle
+import org.rsmod.game.entity.Player
+
+/**
+ * The client sends IDLE when its AFK timer runs out; OSRS logs the player out. This goes through
+ * the logout button's path, so combat still blocks it.
+ */
+class IdleHandler : MessageHandler<Idle> {
+    override fun handle(player: Player, message: Idle) {
+        if (!player.pendingLogout && !player.loggingOut) {
+            player.manualLogout = true
+        }
+    }
+}
