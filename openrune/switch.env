# OpenRune as the default server, on the ports of osrs-rsps-test (which must be stopped first):
#   docker stop osrs-rsps-test && docker compose --env-file switch.env up -d
# Needs src/.data/rsa.properties (scripts/openrune.sh shared-key) baked into the image, so the
# plain tools/repack.sh build (server/data/rsa.properties modulus, port 43594) logs in.
OPENRUNE_GAME_PORT=43594
OPENRUNE_HTTP_PORT=8080
