From f7b77db163b15e2533c7d5f0989134cbd87cc941 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 03:02:46 -0400
Subject: [PATCH 23/27] Drawers and chests: open the remaining plain drawers,
 the Draynor wardrobe, Seers' drawers and the Camelot chest

DrawersScript only handled drawers2 and PlainChestScript only chestclosed; drawers1/3, the Draynor
wardrobe, the Seers' Village drawers and the Camelot castle chest had Open with no handler (clue
scroll searches on them need the open variant's Search).
---
 .../generic/locs/chests/PlainChestScript.kt   | 23 +++++----
 .../generic/locs/drawers/DrawersScript.kt     | 50 ++++++++++++++-----
 2 files changed, 52 insertions(+), 21 deletions(-)

diff --git a/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/chests/PlainChestScript.kt b/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/chests/PlainChestScript.kt
index 5a68a0fee..c6557c978 100644
--- a/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/chests/PlainChestScript.kt
+++ b/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/chests/PlainChestScript.kt
@@ -12,27 +12,32 @@ import org.rsmod.plugin.scripts.ScriptContext
 
 class PlainChestScript @Inject constructor(private val locRepo: LocRepository) : PluginScript() {
     override fun ScriptContext.startup() {
-        onOpLoc1(CLOSED) { open(it.loc) }
-        onOpLoc2(OPENED) { mes(ChestConstants.DEFAULT) }
-        onOpLoc3(OPENED) { shut(it.loc) }
+        for ((closed, opened) in CHESTS) {
+            onOpLoc1(closed) { open(it.loc, opened) }
+            onOpLoc2(opened) { mes(ChestConstants.DEFAULT) }
+            onOpLoc3(opened) { shut(it.loc, closed) }
+        }
     }
 
-    private suspend fun ProtectedAccess.open(chest: BoundLocInfo) {
+    private suspend fun ProtectedAccess.open(chest: BoundLocInfo, opened: String) {
         arriveDelay()
         anim("seq.human_openchest")
         soundSynth(OPEN_SOUND)
-        locRepo.change(chest, OPENED, ChestConstants.DURATION)
+        locRepo.change(chest, opened, ChestConstants.DURATION)
     }
 
-    private suspend fun ProtectedAccess.shut(chest: BoundLocInfo) {
+    private suspend fun ProtectedAccess.shut(chest: BoundLocInfo, closed: String) {
         arriveDelay()
         anim("seq.human_openchest")
-        locRepo.change(chest, CLOSED, ChestConstants.DURATION)
+        locRepo.change(chest, closed, ChestConstants.DURATION)
     }
 
     private companion object {
-        const val CLOSED = "loc.chestclosed"
-        const val OPENED = "loc.chestopen"
+        val CHESTS =
+            listOf(
+                "loc.chestclosed" to "loc.chestopen",
+                "loc.kr_camelot_chestclosed" to "loc.kr_camelot_chestopen",
+            )
         const val OPEN_SOUND = 52
     }
 }
diff --git a/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/drawers/DrawersScript.kt b/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/drawers/DrawersScript.kt
index b27372c5d..a7bf7550d 100644
--- a/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/drawers/DrawersScript.kt
+++ b/content/generic/generic-locs/src/main/kotlin/org/rsmod/content/generic/locs/drawers/DrawersScript.kt
@@ -10,38 +10,64 @@ import org.rsmod.game.loc.BoundLocInfo
 import org.rsmod.plugin.scripts.PluginScript
 import org.rsmod.plugin.scripts.ScriptContext
 
+/**
+ * Plain drawers and wardrobes: Open turns the loc into its open variant, which has Search and
+ * Shut/Close. [Furniture.searchOp] is the open variant's Search slot (2 for most, 1 for the Seers'
+ * Village drawers); Shut/Close is the slot after it.
+ */
 class DrawersScript @Inject constructor(private val locRepo: LocRepository) : PluginScript() {
     override fun ScriptContext.startup() {
-        onOpLoc1(CLOSED) { open(it.loc) }
-        onOpLoc2(OPENED) { search() }
-        onOpLoc3(OPENED) { shut(it.loc) }
+        for (f in FURNITURE) {
+            onOpLoc1(f.closed) { open(it.loc, f) }
+            if (f.searchOp == 1) {
+                onOpLoc1(f.opened) { search(f) }
+                onOpLoc2(f.opened) { shut(it.loc, f) }
+            } else {
+                onOpLoc2(f.opened) { search(f) }
+                onOpLoc3(f.opened) { shut(it.loc, f) }
+            }
+        }
     }
 
-    private suspend fun ProtectedAccess.open(drawers: BoundLocInfo) {
+    private suspend fun ProtectedAccess.open(loc: BoundLocInfo, f: Furniture) {
         arriveDelay()
         anim(OPEN_SEQ)
         soundSynth(OPEN_SYNTH)
         delay(1)
-        locRepo.change(drawers, OPENED, DURATION)
+        locRepo.change(loc, f.opened, DURATION)
     }
 
-    private suspend fun ProtectedAccess.search() {
+    private suspend fun ProtectedAccess.search(f: Furniture) {
         arriveDelay()
-        mes("You search the drawers but find nothing.")
+        mes("You search the ${f.noun} but find nothing.")
     }
 
-    private suspend fun ProtectedAccess.shut(drawers: BoundLocInfo) {
+    private suspend fun ProtectedAccess.shut(loc: BoundLocInfo, f: Furniture) {
         arriveDelay()
         anim(OPEN_SEQ)
         delay(1)
-        locRepo.change(drawers, CLOSED, DURATION)
+        locRepo.change(loc, f.closed, DURATION)
     }
 
-    private companion object {
-        const val CLOSED = "loc.drawers2"
-        const val OPENED = "loc.drawers2open"
+    data class Furniture(val closed: String, val opened: String, val noun: String, val searchOp: Int = 2)
+
+    companion object {
         const val OPEN_SEQ = "seq.human_openchest"
         const val OPEN_SYNTH = "synth.drawer_open"
         const val DURATION = 500
+
+        val FURNITURE =
+            listOf(
+                Furniture("loc.drawers1", "loc.drawers1open", "drawers"),
+                Furniture("loc.drawers2", "loc.drawers2open", "drawers"),
+                Furniture("loc.drawers3", "loc.drawers3open", "drawers"),
+                Furniture("loc.draynor_wardrobe", "loc.draynor_wardrobe_open", "wardrobe"),
+                Furniture(
+                    "loc.kr_seers_village_drawers1",
+                    "loc.kr_seers_village_drawers1open",
+                    "drawers",
+                    searchOp = 1,
+                ),
+            )
     }
 }
-- 
