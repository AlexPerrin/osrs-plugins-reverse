+import net.rsprot.compression.provider.HuffmanCodecProvider
+import net.rsprot.protocol.common.client.OldSchoolClientType
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerExactMoveEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerFacingEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerFreezeEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerHeadbarEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerHitEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerResetEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerSayEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerSpotAnimEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerTintingEncoder
+import net.rsprot.protocol.game.outgoing.codec.playerinfo.extendedinfo.PlayerTransparencyEncoder
+import net.rsprot.protocol.game.outgoing.info.playerinfo.PlayerAvatarExtendedInfo
+import net.rsprot.protocol.game.outgoing.info.playerinfo.PlayerAvatarExtendedInfoBlocks
+import net.rsprot.protocol.game.outgoing.info.playerinfo.PlayerAvatarExtendedInfoWriter
+import net.rsprot.protocol.internal.game.outgoing.info.encoder.PrecomputedExtendedInfoEncoder
+import net.rsprot.protocol.internal.game.outgoing.info.playerinfo.encoder.PlayerExtendedInfoEncoders
+import net.rsprot.protocol.internal.game.outgoing.info.playerinfo.extendedinfo.MoveSpeed
+import net.rsprot.protocol.internal.game.outgoing.info.playerinfo.extendedinfo.TemporaryMoveSpeed
+import net.rsprot.protocol.internal.game.outgoing.info.shared.extendedinfo.Sequence
+import net.rsprot.protocol.internal.game.outgoing.info.playerinfo.extendedinfo.Chat
+
+/**
+ * Player extended info for the Android client, from the PLAYER_INFO reader (Ghidra 0x669a04).
+ *
+ * Flags are 1-3 bytes: 0x80 in the first byte announces a second, 0x4000 a third. Blocks follow in
+ * the order the client tests them:
+ *   0x2 reset, 0x200 tinting, 0x4 sequence, 0x20000 hitmarks, 0x40 ?, 0x100 move speed,
+ *   0x8000 ?, 0x2000 temp move speed, 0x10000 ?, 0x400 chat, 0x10 appearance, 0x1 say,
+ *   0x80000 ?, 0x100000 ?, 0x20 ?, 0x1000 ?, 0x40000 headbars
+ *
+ * Only blocks whose Android layout has been verified are written; any other flagged block is
+ * dropped from the update rather than sent in a layout the client would misread.
+ */
+public class PlayerAvatarExtendedInfoAndroidWriter :
+    PlayerAvatarExtendedInfoWriter(
+        OldSchoolClientType.ANDROID,
+        PlayerExtendedInfoEncoders(
+            OldSchoolClientType.ANDROID,
+            AndroidPlayerAppearanceEncoder(),
+            AndroidPlayerChatEncoder(),
+            PlayerExactMoveEncoder(),
+            PlayerFacingEncoder(),
+            PlayerHitEncoder(),
+            PlayerHeadbarEncoder(),
+            AndroidPlayerMoveSpeedEncoder(),
+            PlayerSayEncoder(),
+            AndroidPlayerSequenceEncoder(),
+            PlayerSpotAnimEncoder(),
+            AndroidPlayerTemporaryMoveSpeedEncoder(),
+            PlayerTintingEncoder(),
+            PlayerTransparencyEncoder(),
+            PlayerFreezeEncoder(),
+            PlayerResetEncoder(),
+        ),
+    ) {
+    override fun pExtendedInfo(
+        buffer: JagByteBuf,
+        localIndex: Int,
+        observerIndex: Int,
+        flag: Int,
+        blocks: PlayerAvatarExtendedInfoBlocks,
+    ) {
+        var clientFlag = 0
+        if (flag and PlayerAvatarExtendedInfo.SEQUENCE != 0) clientFlag = clientFlag or SEQUENCE
+        if (flag and PlayerAvatarExtendedInfo.MOVE_SPEED != 0) clientFlag = clientFlag or MOVE_SPEED
+        if (flag and PlayerAvatarExtendedInfo.TEMP_MOVE_SPEED != 0) clientFlag = clientFlag or TEMP_MOVE_SPEED
+        if (flag and PlayerAvatarExtendedInfo.CHAT != 0) clientFlag = clientFlag or CHAT
+        if (flag and PlayerAvatarExtendedInfo.APPEARANCE != 0) clientFlag = clientFlag or APPEARANCE
+        if (clientFlag and 0xFF.inv() != 0) clientFlag = clientFlag or EXTENDED_SHORT
+        if (clientFlag and 0xFFFF.inv() != 0) clientFlag = clientFlag or EXTENDED_MEDIUM
+
+        buffer.p1(clientFlag)
+        if (clientFlag and EXTENDED_SHORT != 0) buffer.p1(clientFlag shr 8)
+        if (clientFlag and EXTENDED_MEDIUM != 0) buffer.p1(clientFlag shr 16)
+
+        if (clientFlag and SEQUENCE != 0) pCachedData(buffer, blocks.sequence)
+        if (clientFlag and MOVE_SPEED != 0) pCachedData(buffer, blocks.moveSpeed)
+        if (clientFlag and TEMP_MOVE_SPEED != 0) pCachedData(buffer, blocks.temporaryMoveSpeed)
+        if (clientFlag and CHAT != 0) pCachedData(buffer, blocks.chat)
+        if (clientFlag and APPEARANCE != 0) pCachedData(buffer, blocks.appearance)
+    }
+
+    private companion object {
+        private const val EXTENDED_SHORT = 0x80
+        private const val EXTENDED_MEDIUM = 0x4000
+
+        private const val SEQUENCE = 0x4
+        private const val APPEARANCE = 0x10
+        private const val MOVE_SPEED = 0x100
+        private const val TEMP_MOVE_SPEED = 0x2000
+        private const val CHAT = 0x400
+    }
+}
+
+/** Flag 0x100: one byte, read as -b. */
+public class AndroidPlayerMoveSpeedEncoder : PrecomputedExtendedInfoEncoder<MoveSpeed> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: MoveSpeed,
+    ): JagByteBuf = alloc.buffer(1, 1).toJagByteBuf().also { it.p1Alt2(extendedInfo.value) }
+}
+
+/** Flag 0x2000: one byte, read as b^0x80 (127 = teleport). */
+public class AndroidPlayerTemporaryMoveSpeedEncoder : PrecomputedExtendedInfoEncoder<TemporaryMoveSpeed> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: TemporaryMoveSpeed,
+    ): JagByteBuf = alloc.buffer(1, 1).toJagByteBuf().also { it.p1Alt1(extendedInfo.value) }
+}
+
+/** Flag 0x4: [id hi, lo^0x80][delay]. */
+public class AndroidPlayerSequenceEncoder : PrecomputedExtendedInfoEncoder<Sequence> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: Sequence,
+    ): JagByteBuf =
+        alloc.buffer(3, 3).toJagByteBuf().also {
+            it.p2Alt2(extendedInfo.id.toInt())
+            it.p1(extendedInfo.delay.toInt())
+        }
+}
+
+/**
+ * Flag 0x400: [colour << 8 | effects: lo^0x80, hi][modicon ^0x80][autotyper][huffman length -b]
+ * [huffman bytes reversed, ^0x80][pattern bytes ^0x80].
+ */
+public class AndroidPlayerChatEncoder : PrecomputedExtendedInfoEncoder<Chat> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: Chat,
+    ): JagByteBuf {
+        val text = extendedInfo.text ?: ""
+        val colour = extendedInfo.colour.toInt()
+        val patternLength = if (colour in 13..20) colour - 12 else 0
+        val buffer = alloc.buffer(5 + text.length + patternLength).toJagByteBuf()
+        buffer.p2Alt3(colour shl 8 or extendedInfo.effects.toInt())
+        buffer.p1Alt1(extendedInfo.modicon.toInt())
+        buffer.p1(if (extendedInfo.autotyper) 1 else 0)
+        val huffmanBuffer = alloc.buffer(text.length).toJagByteBuf()
+        try {
+            huffmanCodecProvider.provide().encode(huffmanBuffer, text)
+            buffer.p1Alt2(huffmanBuffer.readableBytes())
+            buffer.pdataAlt3(huffmanBuffer.buffer)
+        } finally {
+            huffmanBuffer.buffer.release()
+        }
+        if (patternLength in 1..8) {
+            val pattern = checkNotNull(extendedInfo.pattern)
+            for (i in 0..<patternLength) {
+                buffer.p1Alt1(pattern[i].toInt())
+            }
+        }
+        return buffer
+    }
+}
