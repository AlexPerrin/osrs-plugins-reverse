+        val type = GrandExchange.type(trade.item) ?: return
+        if (op == IfButtonOp.Op10) {
+            mes(type.examine)
+            return
+        }
+        val slot = firstFreeSlot()
+        openExchange()
+        if (slot == null) {
+            mes("You have no free offer slots.")
+            return
+        }
+        resetSetup(player, slot + 1)
+        selectItem(type, quantity = 1)
+    }
