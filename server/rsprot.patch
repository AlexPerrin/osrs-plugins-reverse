+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 47: [component p4Alt3][npc slot hi, lo^0x80]. */
+public class AndroidIfSetNpcHeadActiveEncoder : MessageEncoder<IfSetNpcHeadActive> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETNPCHEAD_ACTIVE
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetNpcHeadActive) {
+        buffer.p4Alt3(message.combinedId)
+        buffer.p2Alt2(message.index)
+    }
+}
+
+/** Case 62: [component BE int][npc id LE]. */
+public class AndroidIfSetNpcHeadEncoder : MessageEncoder<IfSetNpcHead> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETNPCHEAD
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetNpcHead) {
+        buffer.p4(message.combinedId)
+        buffer.p2Alt1(message.npc)
+    }
+}
+
+/** Case 101: [component BE int]. */
+public class AndroidIfCloseSubEncoder : MessageEncoder<IfCloseSub> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_CLOSESUB
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfCloseSub) {
+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 122: [component p4Alt3][text]. */
+public class AndroidIfSetTextEncoder : MessageEncoder<IfSetText> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETTEXT
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: IfSetText) {
+        buffer.p4Alt3(message.combinedId)
+        buffer.pjstr(message.text)
+    }
+}
+
+/** Case 10: type string, args in reverse type order, script id BE int (as desktop). */
+public fun androidRunClientScriptEncoder(): MessageEncoder<RunClientScript> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.RUNCLIENTSCRIPT, RunClientScriptEncoder())
+
+/** Case 77: [hidden: 1 -> 0x7f (128-b)][component BE int]. */
+public class AndroidIfSetHideEncoder : MessageEncoder<net.rsprot.protocol.game.outgoing.interfaces.IfSetHide> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETHIDE
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.interfaces.IfSetHide,
+    ) {
+        buffer.p1Alt3(if (message.hidden) 1 else 0)
+        buffer.p4(message.combinedId)
+    }
+}
+
+/** Case 79: [component p4Alt3] (bytes >>16, >>24, >>0, >>8). */
+public class AndroidIfSetPlayerHeadEncoder : MessageEncoder<net.rsprot.protocol.game.outgoing.interfaces.IfSetPlayerHead> {
+    override val prot: ServerProt = AndroidGameServerProt.IF_SETPLAYERHEAD
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.interfaces.IfSetPlayerHead,
+    ) {
+        buffer.p4Alt3(message.combinedId)
+    }
+}
