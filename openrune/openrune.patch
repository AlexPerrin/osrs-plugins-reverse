+    /**
+     * osrs-plugins-reverse: the Android client (241.4) crashes on clientscript groups far above the
+     * stock range (it sizes its script table from the archive), so custom scripts must take the ids
+     * right after the stock maximum (9972 in rev 241). Fails the cache build otherwise.
+     */
+    /**
+     * osrs-plugins-reverse: packs whose clientscripts stay out of the cache: the dev spawn menu,
+     * which is useless on mobile (`OPENRUNE_SKIP_CS2_PACKS`, comma-separated pack names; empty packs
+     * everything). New script groups need scripts/fix_reftable.py after the build: the packer leaves
+     * their reference-table sizes at 0, which crashes the Android client during cache sync.
+     */
+    private fun skippedCs2Packs(): Set<String> =
+        (System.getenv("OPENRUNE_SKIP_CS2_PACKS") ?: "spawn")
+            .split(',').map { it.trim().lowercase() }.filter { it.isNotEmpty() }.toSet()
+
+    private fun checkClientScriptIds(lines: Collection<String>) {
+        val limit = System.getenv("OPENRUNE_MAX_CLIENTSCRIPT_ID")?.toIntOrNull() ?: MAX_CLIENTSCRIPT_ID
+        val bad = lines.mapNotNull { line ->
+            val id = line.substringBefore('\t').toIntOrNull() ?: return@mapNotNull null
+            if (id > limit) line else null
+        }
+        check(bad.isEmpty()) {
+            "Custom clientscript ids above $limit break the Android client; renumber them to " +
+                "follow the stock maximum: $bad"
+        }
+    }
