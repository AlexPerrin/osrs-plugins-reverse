From b90f97c0bdc33a7758c346e9b4521430c8c5b3d5 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 07:08:59 -0400
Subject: [PATCH] Kittens: growth overhead text, growth paused in interfaces,
 run-away wording

Every completed growth event (every 150 ticks) the kitten or cat says 'Meow!' (the wording is
a guess); RuneLite's Kitten Tracker counts growth by the follower's overhead text. Growth waits
while a modal is open (OSRS Wiki: the growth timer is paused during dialogue). The kitten runs
off with 'Your kitten got lonely and ran off.' (the text Kitten Tracker matches) or 'Your kitten
got hungry and ran off.' (guess).
---
 .../org/rsmod/content/other/pets/cats/CatCare.kt    | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/cats/CatCare.kt b/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/cats/CatCare.kt
index 35dd61859..90641375b 100644
--- a/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/cats/CatCare.kt
+++ b/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/cats/CatCare.kt
@@ -102,8 +102,16 @@ class CatCare @Inject constructor(private val followers: PetFollowers) {
             player.catGrowthTicks = ticks
             return
         }
+        if (player.ui.modals.isNotEmpty()) {
+            player.catGrowthTicks = GROWTH_TICKS - 1
+            return
+        }
         player.catGrowthTicks = 0
         val events = player.catGrowthEvents + 1
+        // RuneLite's Kitten Tracker counts growth events by the follower's overhead text.
+        if (cat.stage != CatStage.Kitten || events < KITTEN_EVENTS) {
+            npc.say(GROWTH_SAY)
+        }
         when {
             cat.stage == CatStage.Kitten && events >= KITTEN_EVENTS -> {
                 player.catGrowthEvents = 0
@@ -135,7 +143,7 @@ class CatCare @Inject constructor(private val followers: PetFollowers) {
                 player.say("I think it's very hungry!")
                 player.mes("<col=ff0000>Your kitten is very hungry.</col>")
             }
-            0 -> runAway(player, "Your kitten has run away.")
+            0 -> runAway(player, "Your kitten got hungry and ran off.")
         }
     }
 
@@ -156,12 +164,13 @@ class CatCare @Inject constructor(private val followers: PetFollowers) {
                 player.say("I think it's feeling lonely.")
                 player.mes("<col=ff0000>Your kitten really wants attention.</col>")
             }
-            0 -> runAway(player, "Your kitten has run away.")
+            0 -> runAway(player, "Your kitten got lonely and ran off.")
         }
     }
 
     companion object {
         const val GROWTH_TICKS = 150
+        const val GROWTH_SAY = "Meow!"
         const val KITTEN_EVENTS = 120
         const val CAT_EVENTS = 220
         const val MAX_EVENTS = 255
-- 
2.43.0

