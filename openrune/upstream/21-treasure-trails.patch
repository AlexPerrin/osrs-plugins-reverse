+            "black_platelegs",
+            "black_sq_shield",
+            "black_scimitar",
+            "black_sword",
+            "black_warhammer",
+        )
+
+    private val EQUIPMENT =
+        listOf(
+            "shortbow",
+            "longbow",
+            "oak_shortbow",
+            "oak_longbow",
+            "iron_pickaxe",
+            "staff_of_air",
+            "staff_of_water",
+            "staff_of_earth",
+            "staff_of_fire",
+            "steel_full_helm",
+            "steel_platebody",
+            "steel_platelegs",
+            "steel_plateskirt",
+            "steel_longsword",
+            "steel_dagger",
+            "steel_axe",
+            "steel_battleaxe",
+            "leather_cowl",
+            "leather_armour",
+            "leather_chaps",
+            "leather_vambraces",
+            "hardleather_body",
+            "bluewizhat",
+            "wizards_robe",
+            "blackwizhat",
+            "black_robe",
+        )
+
+    private val REWARDS =
+        UNIQUES.map { Reward(it, UNIQUE) } +
+            BLACK_ITEMS.map { Reward(it, BLACK) } +
+            EQUIPMENT.map { Reward(it, GENERIC) } +
+            listOf("airrune", "mindrune", "waterrune", "earthrune", "firerune", "bodyrune").map {
+                Reward(it, GENERIC, 15, 35)
+            } +
+            listOf("chaosrune", "naturerune", "lawrune").map { Reward(it, GENERIC, 2, 7) } +
+            listOf(
+                Reward("bronze_arrow", GENERIC, 15, 30),
+                Reward("iron_arrow", GENERIC, 7, 15),
+                Reward("cabbage", CABBAGE, 5, 9, noted = true),
