+package net.rsprot.protocol.api
+
+/**
+ * osrs-plugins-reverse (one-off diagnostics): the first [loginPackets] outgoing game packets of
+ * every Android session are logged at INFO as `OUT #n op=.. len=.. Class hexbytes` (payload
+ * before any stream-cipher payload encryption; packet group children are indented). Written for
+ * the mobile friends list ("Loading friends list"): did the login UPDATE_FRIENDLIST go out, and
+ * how. Off by default: set the environment variable `RSPROT_OUT_TRACE` to the number of packets
+ * to log per session (e.g. 700).
+ */
+public object OutgoingPacketTrace {
+    @Volatile
+    public var loginPackets: Int = System.getenv("RSPROT_OUT_TRACE")?.toIntOrNull() ?: 0
+
+    public const val MAX_BYTES: Int = 32
+}
