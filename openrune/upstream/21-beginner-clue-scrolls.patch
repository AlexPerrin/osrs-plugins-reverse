@@ -0,0 +1,107 @@
+package org.rsmod.content.other.treasuretrails
+
+import org.rsmod.api.player.output.mes
+import org.rsmod.api.player.protect.ProtectedAccess
+import org.rsmod.api.player.vars.VarPlayerIntMapSetter
+import org.rsmod.api.script.onOpLoc1
+import org.rsmod.api.script.onOpLoc2
+import org.rsmod.api.table.TrailStashUnitsRow
+import org.rsmod.game.entity.Player
+import org.rsmod.plugin.scripts.PluginScript
+import org.rsmod.plugin.scripts.ScriptContext
+
+/**
+ * Beginner STASH units (OSRS Wiki: STASH). Build (op1) needs Construction 12, a hammer, a saw, 2
+ * planks and 10 nails of one metal (not dragon), and sets the unit's `hh_constructed` varbit, which
+ * turns the bush into the STASH and is what RuneLite's Clue Scroll plugin checks (clientscript
+ * 1479). Search (op2) stores the unit's full item set or takes it back, with the messages the
+ * plugin tracks ("You deposit/withdraw your items ... the STASH unit.").
+ *
+ * Deviation: only items in the inventory are stored (not worn ones).
+ */
+class StashUnitScript : PluginScript() {
+    override fun ScriptContext.startup() {
+        for (unit in UNITS) {
+            onOpLoc1(unit.loc) { build(unit) }
+            onOpLoc2(unit.loc) { search(unit) }
+        }
+    }
+
+    suspend fun ProtectedAccess.build(unit: TrailStashUnitsRow) {
+        if (isBuilt(player, unit)) return
+        if (stat(CONSTRUCTION) < unit.level) {
+            mes("You need a Construction level of ${unit.level} to build this STASH unit.")
+            return
+        }
+        val nails = NAILS.firstOrNull { inv.count(it) >= NAILS_NEEDED }
+        if (HAMMER !in inv || SAW !in inv || inv.count(PLANK) < PLANKS_NEEDED || nails == null) {
+            mes("You need a hammer, a saw, $PLANKS_NEEDED planks and $NAILS_NEEDED nails to build this.")
+            return
+        }
+        anim(BUILD_ANIM)
+        delay(BUILD_TICKS)
+        if (invDel(inv, PLANK, PLANKS_NEEDED).failure) return
+        if (invDel(inv, nails, NAILS_NEEDED).failure) return
+        statAdvance(CONSTRUCTION, unit.xp.toDouble())
+        VarPlayerIntMapSetter.set(player, unit.varbit, 1)
+    }
+
+    fun ProtectedAccess.search(unit: TrailStashUnitsRow) {
+        if (!isBuilt(player, unit)) return
+        val items = listOf(unit.item1.internalName, unit.item2.internalName)
+        if (isFilled(player, unit)) {
+            if (inv.freeSpace() < items.size) {
+                mes("You need ${items.size} free inventory spaces to take your items out.")
+                return
+            }
+            for (item in items) invAdd(inv, item)
+            setFilled(player, unit, false)
+            mes("You withdraw your items from the STASH unit.")
+            return
+        }
+        if (items.any { it !in inv }) {
+            mes("You don't have the items to store in this STASH unit.")
+            return
+        }
+        for (item in items) {
+            if (invDel(inv, item).failure) return
+        }
+        setFilled(player, unit, true)
+        mes("You deposit your items into the STASH unit.")
+    }
+
+    companion object {
+        const val CONSTRUCTION = "stat.construction"
+        const val HAMMER = "obj.hammer"
+        const val SAW = "obj.poh_saw"
+        const val PLANK = "obj.woodplank"
+        const val PLANKS_NEEDED = 2
+        const val NAILS_NEEDED = 10
+        const val BUILD_ANIM = "seq.human_poh_build"
+        const val BUILD_TICKS = 3
+        const val FILLED_VARP = "varp.trail_stash_beginner_filled"
+        val NAILS =
+            listOf(
+                "obj.nails_bronze",
+                "obj.nails_iron",
+                "obj.nails",
+                "obj.nails_black",
+                "obj.nails_mithril",
+                "obj.nails_adamant",
+                "obj.nails_rune",
+            )
+
+        val UNITS: List<TrailStashUnitsRow> by lazy { TrailStashUnitsRow.all() }
+
+        fun isBuilt(player: Player, unit: TrailStashUnitsRow): Boolean = player.vars[unit.varbit] == 1
+
+        fun isFilled(player: Player, unit: TrailStashUnitsRow): Boolean =
+            (player.vars[FILLED_VARP] shr unit.filledBit) and 1 == 1
+
+        private fun setFilled(player: Player, unit: TrailStashUnitsRow, filled: Boolean) {
+            val bit = 1 shl unit.filledBit
+            val value = player.vars[FILLED_VARP]
+            VarPlayerIntMapSetter.set(player, FILLED_VARP, if (filled) value or bit else value and bit.inv())
+        }
+    }
+}
