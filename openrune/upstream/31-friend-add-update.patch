From 82d9ae1a863c6114ec9995646ff9ba610f63ee98 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 04:15:40 -0400
Subject: [PATCH] Friends: send the added friend back after FRIENDLIST_ADD

OSRS answers a friend add with an UPDATE_FRIENDLIST entry for the new friend (online with its
world, or offline). Central pushed an entry only when the friend was online, so adding an
offline friend showed nothing until the next login. After a successful add, the handler reads
the social snapshot and sends the new friend's entry (added = true). Login/logout status
changes still come from Central's presence pushes.
---
 .../net/central/CentralSocialClientPackets.kt | 64 +++++++++++--------
 .../rsprot/handlers/FriendListAddHandler.kt   | 23 ++++++-
 2 files changed, 60 insertions(+), 27 deletions(-)

diff --git a/api/net/src/main/kotlin/org/rsmod/api/net/central/CentralSocialClientPackets.kt b/api/net/src/main/kotlin/org/rsmod/api/net/central/CentralSocialClientPackets.kt
index f426d43f6..aa1e21577 100644
--- a/api/net/src/main/kotlin/org/rsmod/api/net/central/CentralSocialClientPackets.kt
+++ b/api/net/src/main/kotlin/org/rsmod/api/net/central/CentralSocialClientPackets.kt
@@ -43,32 +43,7 @@ fun Player.writeCentralSocialSnapshot(snapshot: WorldLinkFrameSpecs.CentralSocia
     client.write(FriendListLoaded)
     client.write(ChatFilterSettingsPrivateChat(snapshot.privateChat))
 
-    val friendEntries =
-        snapshot.friends.map { friend ->
-            if (friend.worldId > 0) {
-                UpdateFriendList.OnlineFriend(
-                    added = false,
-                    name = friend.displayName,
-                    previousName = friend.previousDisplayName,
-                    worldId = friend.worldId,
-                    rank = 0,
-                    properties = 0,
-                    notes = "",
-                    worldName = "OpenRune",
-                    platform = OSRS_PLATFORM,
-                    worldFlags = 0,
-                )
-            } else {
-                UpdateFriendList.OfflineFriend(
-                    added = false,
-                    name = friend.displayName,
-                    previousName = friend.previousDisplayName,
-                    rank = 0,
-                    properties = 0,
-                    notes = "",
-                )
-            }
-        }
+    val friendEntries = snapshot.friends.map { it.toFriendEntry(added = false) }
 
     client.write(UpdateFriendList(friendEntries))
 
@@ -85,6 +60,43 @@ fun Player.writeCentralSocialSnapshot(snapshot: WorldLinkFrameSpecs.CentralSocia
     client.write(UpdateIgnoreList(ignoreEntries))
 }
 
+/**
+ * The friend just added, as OSRS sends it after FRIENDLIST_ADD: one UPDATE_FRIENDLIST entry,
+ * online with its world or offline. Central only pushes an entry for a friend who is online.
+ */
+fun Player.writeCentralAddedFriend(snapshot: WorldLinkFrameSpecs.CentralSocialSnapshot, name: String) {
+    val key = name.socialKey()
+    val friend = snapshot.friends.firstOrNull { it.displayName.socialKey() == key } ?: return
+    client.write(UpdateFriendList(listOf(friend.toFriendEntry(added = true))))
+}
+
+private fun String.socialKey(): String = lowercase().replace('_', ' ').replace('\u00a0', ' ').trim()
+
+private fun WorldLinkFrameSpecs.CentralSocialFriend.toFriendEntry(added: Boolean): UpdateFriendList.Friend =
+    if (worldId > 0) {
+        UpdateFriendList.OnlineFriend(
+            added = added,
+            name = displayName,
+            previousName = previousDisplayName,
+            worldId = worldId,
+            rank = 0,
+            properties = 0,
+            notes = "",
+            worldName = "OpenRune",
+            platform = OSRS_PLATFORM,
+            worldFlags = 0,
+        )
+    } else {
+        UpdateFriendList.OfflineFriend(
+            added = added,
+            name = displayName,
+            previousName = previousDisplayName,
+            rank = 0,
+            properties = 0,
+            notes = "",
+        )
+    }
+
 fun Player.writeCentralSocialSnapshotEmpty() {
     client.write(FriendListLoaded)
     client.write(ChatFilterSettingsPrivateChat(0))
diff --git a/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/FriendListAddHandler.kt b/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/FriendListAddHandler.kt
index b6ca51e1b..47005ba48 100644
--- a/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/FriendListAddHandler.kt
+++ b/api/net/src/main/kotlin/org/rsmod/api/net/rsprot/handlers/FriendListAddHandler.kt
@@ -6,6 +6,8 @@ import org.rsmod.api.db.gateway.GameDbManager
 import org.rsmod.api.db.gateway.model.fold
 import org.rsmod.api.net.central.CentralSocialResult
 import org.rsmod.api.net.central.CentralSocialService
+import org.rsmod.api.net.central.OpenRuneCentralWorldLink
+import org.rsmod.api.net.central.writeCentralAddedFriend
 import org.rsmod.api.social.writeSocialMessage
 import org.rsmod.game.entity.Player
 import org.rsmod.game.entity.PlayerList
@@ -40,7 +42,7 @@ constructor(
                 result.fold(
                     onOk = { socialResult ->
                         when (socialResult) {
-                            CentralSocialResult.Ok -> Unit
+                            CentralSocialResult.Ok -> refreshAddedFriend(current, requestedName)
 
                             CentralSocialResult.Ignored -> Unit
 
@@ -56,4 +58,23 @@ constructor(
             },
         )
     }
+
+    private fun refreshAddedFriend(player: Player, name: String) {
+        val uid = player.uid
+        val characterId = player.characterId
+        db.request(
+            request = { social.socialSnapshot(characterId = characterId) },
+            response = { result ->
+                val current = uid.resolve(playerList) ?: return@request
+                result.fold(
+                    onOk = { sync ->
+                        if (sync is OpenRuneCentralWorldLink.CentralSocialSnapshotResult.Ok) {
+                            current.writeCentralAddedFriend(sync.snapshot, name)
+                        }
+                    },
+                    onErr = {},
+                )
+            },
+        )
+    }
 }
