{
  "permissions": {
    "ask": [
      "Bash(openrune/upstream/open-batch-*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/publish_gate.py"
          },
          {
            "type": "command",
            "if": "Bash(gh release create*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/publish_gate.py"
          },
          {
            "type": "command",
            "if": "Bash(git tag*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/publish_gate.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/github_scope.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/tools/hooks/session_state.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "client-dev",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py client"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/task_stop.py"
          }
        ]
      },
      {
        "matcher": "client-qa",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py client-qa"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/task_stop.py"
          }
        ]
      },
      {
        "matcher": "server-dev",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py server"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/task_stop.py"
          }
        ]
      },
      {
        "matcher": "server-qa",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/slot_stop.py server-qa"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/hooks/task_stop.py"
          }
        ]
      }
    ]
  }
}
