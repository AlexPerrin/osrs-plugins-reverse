@@ -0,0 +1,383 @@
+package net.rsprot.protocol.android
+
+import io.netty.buffer.Unpooled
+import net.rsprot.buffer.JagByteBuf
+import net.rsprot.buffer.extensions.toJagByteBuf
+import net.rsprot.crypto.cipher.StreamCipher
+import net.rsprot.protocol.ServerProt
+import net.rsprot.protocol.ServerProtCategory
+import net.rsprot.protocol.game.outgoing.GameServerProtCategory
+import net.rsprot.protocol.game.outgoing.zone.header.UpdateZoneFullFollows
+import net.rsprot.protocol.game.outgoing.zone.header.UpdateZonePartialFollows
+import net.rsprot.protocol.game.outgoing.zone.payload.LocAddChangeV2
+import net.rsprot.protocol.game.outgoing.zone.payload.LocDel
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjAdd
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjDel
+import net.rsprot.protocol.game.outgoing.zone.payload.LocAnim
+import net.rsprot.protocol.game.outgoing.zone.payload.LocMerge
+import net.rsprot.protocol.game.outgoing.zone.payload.MapAnim
+import net.rsprot.protocol.game.outgoing.zone.payload.MapProjAnimV2
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjCount
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjCustomise
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjEnabledOps
+import net.rsprot.protocol.game.outgoing.zone.payload.ObjUncustomise
+import net.rsprot.protocol.game.outgoing.zone.payload.ScriptedProjAdd
+import net.rsprot.protocol.game.outgoing.zone.payload.ScriptedProjChange
+import net.rsprot.protocol.game.outgoing.zone.payload.SoundArea
+import net.rsprot.protocol.message.OutgoingGameMessage
+import net.rsprot.protocol.message.ZoneProt
+import net.rsprot.protocol.message.codec.MessageEncoder
+
+// Zone packets. The client keeps a zone base (x, z in build-area tiles, level) set by the
+// UPDATE_ZONE_* headers; zone prots carry a packed coord-in-zone (x << 4 | z). Zone prots are
+// handled by one function (Ghidra 0x56edb0) switching on an Android-specific index, which is
+// also the sub-opcode inside UPDATE_ZONE_PARTIAL_ENCLOSED:
+//   0 MAP_ANIM, 1 LOC_ADD_CHANGE_V2, 2 LOC_ANIM, 3 OBJ_ENABLED_OPS, 4 OBJ_UNCUSTOMISE, 5 OBJ_DEL,
+//   6 MAP_PROJANIM_V2, 7 OBJ_CUSTOMISE, 8 OBJ_COUNT, 9 LOC_MERGE, 10 LOC_DEL, 11 OBJ_ADD,
+//   12 SCRIPTEDPROJ_ADD, 13 SOUND_AREA, 14 SCRIPTEDPROJ_CHANGE
+// (identified by payload size and what each case does with the tile's obj/loc lists).
+
+/** Case 7: [z 128-b][x ^0x80][level ^0x80]. */
+public class AndroidUpdateZonePartialFollowsEncoder : MessageEncoder<UpdateZonePartialFollows> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_ZONE_PARTIAL_FOLLOWS
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateZonePartialFollows) {
+        buffer.p1Alt3(message.zoneZ)
+        buffer.p1Alt1(message.zoneX)
+        buffer.p1Alt1(message.level)
+    }
+}
+
+/** Case 68: [level ^0x80][z ^0x80][x -b]; clears the zone's objs/locs changes first. */
+public class AndroidUpdateZoneFullFollowsEncoder : MessageEncoder<UpdateZoneFullFollows> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_ZONE_FULL_FOLLOWS
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: UpdateZoneFullFollows) {
+        buffer.p1Alt1(message.level)
+        buffer.p1Alt1(message.zoneZ)
+        buffer.p1Alt2(message.zoneX)
+    }
+}
+
+/**
+ * Case 23: [level ^0x80][z 128-b][x p1], then (index p1, zone prot payload)* to the end.
+ * Build [payload] with [AndroidZoneProts.encode].
+ */
+public class AndroidUpdateZonePartialEnclosed(
+    public val zoneX: Int,
+    public val zoneZ: Int,
+    public val level: Int,
+    public val payload: ByteArray,
+) : OutgoingGameMessage {
+    override val category: ServerProtCategory
+        get() = GameServerProtCategory.HIGH_PRIORITY_PROT
+
+    override fun toString(): String =
+        "AndroidUpdateZonePartialEnclosed(zoneX=$zoneX, zoneZ=$zoneZ, level=$level, payload=${payload.size} bytes)"
+}
+
+public class AndroidUpdateZonePartialEnclosedEncoder : MessageEncoder<AndroidUpdateZonePartialEnclosed> {
+    override val prot: ServerProt = AndroidGameServerProt.UPDATE_ZONE_PARTIAL_ENCLOSED
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: AndroidUpdateZonePartialEnclosed) {
+        buffer.p1Alt1(message.level)
+        buffer.p1Alt3(message.zoneZ)
+        buffer.p1(message.zoneX)
+        buffer.buffer.writeBytes(message.payload)
+    }
+}
+
+/** Zone prot payloads with their Android index, for UPDATE_ZONE_PARTIAL_ENCLOSED. */
+public object AndroidZoneProts {
+    public const val MAP_ANIM: Int = 0
+    public const val LOC_ADD_CHANGE_V2: Int = 1
+    public const val LOC_ANIM: Int = 2
+    public const val OBJ_ENABLED_OPS: Int = 3
+    public const val OBJ_UNCUSTOMISE: Int = 4
+    public const val OBJ_DEL: Int = 5
+    public const val MAP_PROJANIM_V2: Int = 6
+    public const val OBJ_CUSTOMISE: Int = 7
+    public const val OBJ_COUNT: Int = 8
+    public const val LOC_MERGE: Int = 9
+    public const val LOC_DEL: Int = 10
+    public const val OBJ_ADD: Int = 11
+    public const val SCRIPTEDPROJ_ADD: Int = 12
+    public const val SOUND_AREA: Int = 13
+    public const val SCRIPTEDPROJ_CHANGE: Int = 14
+
+    /** Writes [message]'s Android index and payload; false if it is not a known zone prot. */
+    public fun write(buf: JagByteBuf, message: ZoneProt): Boolean {
+        when (message) {
+            is MapAnim -> { buf.p1(MAP_ANIM); writeMapAnim(buf, message) }
+            is LocAddChangeV2 -> { buf.p1(LOC_ADD_CHANGE_V2); writeLocAddChange(buf, message) }
+            is LocAnim -> { buf.p1(LOC_ANIM); writeLocAnim(buf, message) }
+            is ObjEnabledOps -> { buf.p1(OBJ_ENABLED_OPS); writeObjEnabledOps(buf, message) }
+            is ObjUncustomise -> { buf.p1(OBJ_UNCUSTOMISE); writeObjUncustomise(buf, message) }
+            is ObjDel -> { buf.p1(OBJ_DEL); writeObjDel(buf, message) }
+            is MapProjAnimV2 -> { buf.p1(MAP_PROJANIM_V2); writeMapProjAnim(buf, message) }
+            is ObjCustomise -> { buf.p1(OBJ_CUSTOMISE); writeObjCustomise(buf, message) }
+            is ObjCount -> { buf.p1(OBJ_COUNT); writeObjCount(buf, message) }
+            is LocMerge -> { buf.p1(LOC_MERGE); writeLocMerge(buf, message) }
+            is LocDel -> { buf.p1(LOC_DEL); writeLocDel(buf, message) }
+            is ObjAdd -> { buf.p1(OBJ_ADD); writeObjAdd(buf, message) }
+            is ScriptedProjAdd -> { buf.p1(SCRIPTEDPROJ_ADD); writeScriptedProjAdd(buf, message) }
+            is SoundArea -> { buf.p1(SOUND_AREA); writeSoundArea(buf, message) }
+            is ScriptedProjChange -> { buf.p1(SCRIPTEDPROJ_CHANGE); writeScriptedProjChange(buf, message) }
+            else -> return false
+        }
+        return true
+    }
+
+    /** Encodes [messages] (LocAddChangeV2, LocDel, ObjAdd, ObjDel) as index + payload each. */
+    public fun encode(messages: List<ZoneProt>): ByteArray {
+        val buf = Unpooled.buffer().toJagByteBuf()
+        try {
+            for (message in messages) {
+                check(write(buf, message)) { "Zone prot not mapped for Android: $message" }
+            }
+            val out = ByteArray(buf.buffer.readableBytes())
+            buf.buffer.readBytes(out)
+            return out
+        } finally {
+            buf.buffer.release()
+        }
+    }
+
+    /** Case 1: [op count -b]([op index p1][string])*[shape<<2|rot p1][coord p1][opFlags 128-b][id p2Alt2]. */
+    internal fun writeLocAddChange(buffer: JagByteBuf, message: LocAddChangeV2) {
+        val ops = message.ops
+        buffer.p1Alt2(ops?.size ?: 0)
+        if (ops != null) {
+            for ((key, value) in ops) {
+                buffer.p1(key.toInt() - 1)
+                buffer.pjstr(value)
+            }
+        }
+        buffer.p1(message.locPropertiesPacked)
+        buffer.p1(message.coordInZonePacked)
+        buffer.p1Alt3(message.opFlags.toInt())
+        buffer.p2Alt2(message.id)
+    }
+
+    /** Case 0 (6 bytes): [coord -b][id p2Alt3][delay p2Alt2][height -b] (client: ground height - height). */
+    internal fun writeMapAnim(buffer: JagByteBuf, message: MapAnim) {
+        buffer.p1Alt2(message.coordInZonePacked)
+        buffer.p2Alt3(message.id)
+        buffer.p2Alt2(message.delay)
+        buffer.p1Alt2(message.height)
+    }
+
+    /** Case 2 (4 bytes): [shape<<2|rot ^0x80][anim id LE][coord p1]. */
+    internal fun writeLocAnim(buffer: JagByteBuf, message: LocAnim) {
+        buffer.p1Alt1(message.locPropertiesPacked)
+        buffer.p2Alt1(message.id)
+        buffer.p1(message.coordInZonePacked)
+    }
+
+    /** Case 3 (4 bytes): [coord p1][id p2][opFlags p1]; sets the ops of the matching obj. */
+    internal fun writeObjEnabledOps(buffer: JagByteBuf, message: ObjEnabledOps) {
+        buffer.p1(message.coordInZonePacked)
+        buffer.p2(message.id)
+        buffer.p1(message.opFlags.toInt())
+    }
+
+    /** Case 4 (7 bytes): [quantity p4][coord 128-b][id LE]; matched against the obj's id/count. */
+    internal fun writeObjUncustomise(buffer: JagByteBuf, message: ObjUncustomise) {
+        buffer.p4(message.quantity)
+        buffer.p1Alt3(message.coordInZonePacked)
+        buffer.p2Alt1(message.id)
+    }
+
+    /**
+     * Case 6 (24 bytes). Field roles from the projectile struct built on the stack (start block,
+     * end block, then times/angle/progress/id); the two cycle-relative times are told apart only by
+     * struct order (unverified), as are endHeight vs progress.
+     */
+    internal fun writeMapProjAnim(buffer: JagByteBuf, message: MapProjAnimV2) {
+        buffer.p2Alt3(message.endTime)
+        buffer.p2Alt1(message.startHeight)
+        buffer.p2Alt3(message.endHeight)
+        buffer.p2Alt3(message.progress)
+        buffer.p4(message.end.packed)
+        buffer.p2Alt2(message.id)
+        buffer.p3(message.targetIndex)
+        buffer.p1(message.coordInZonePacked)
+        buffer.p2Alt3(message.startTime)
+        buffer.p3Alt1(message.sourceIndex)
+        buffer.p1Alt2(message.angle)
+    }
+
+    /**
+     * Case 7 (17 bytes): [quantity p4][coord p1][retexIndex LE][model p2Alt2][recolIndex LE]
+     * [recol p2Alt3][retex LE][id p2Alt2]; argument order of the customise call (0x5580c0) matches
+     * desktop's objCustomise(level, x, z, id, count, recol, recolIndex, retex, retexIndex, model).
+     */
+    internal fun writeObjCustomise(buffer: JagByteBuf, message: ObjCustomise) {
+        buffer.p4(message.quantity)
+        buffer.p1(message.coordInZonePacked)
+        buffer.p2Alt1(message.retexIndex)
+        buffer.p2Alt2(message.model)
+        buffer.p2Alt1(message.recolIndex)
+        buffer.p2Alt3(message.recol)
+        buffer.p2Alt1(message.retex)
+        buffer.p2Alt2(message.id)
+    }
+
+    /** Case 8 (11 bytes): [coord p1][new quantity p4][old quantity p4Alt2][id p2Alt3]. */
+    internal fun writeObjCount(buffer: JagByteBuf, message: ObjCount) {
+        buffer.p1(message.coordInZonePacked)
+        buffer.p4(message.newQuantity)
+        buffer.p4Alt2(message.oldQuantity)
+        buffer.p2Alt3(message.id)
+    }
+
+    /** Case 9 (14 bytes): the Android client skips the payload, so the desktop layout is used. */
+    internal fun writeLocMerge(buffer: JagByteBuf, message: LocMerge) {
+        buffer.p1Alt3(message.coordInZonePacked)
+        buffer.p1(message.maxZ)
+        buffer.p2(message.end)
+        buffer.p1Alt1(message.minX)
+        buffer.p1Alt3(message.locPropertiesPacked)
+        buffer.p2Alt1(message.index)
+        buffer.p2Alt3(message.start)
+        buffer.p1Alt3(message.maxX)
+        buffer.p2Alt3(message.id)
+        buffer.p1Alt1(message.minZ)
+    }
+
+    /**
+     * Case 12 (37 bytes). Roles from the struct order (source offsets/height, sourceIndex, target
+     * coord, target offsets/height, targetIndex, times, curve scripts H/A/T); slot is the hash key.
+     * Offsets X/Z/height and the curve-script order are inferred, not verified.
+     */
+    internal fun writeScriptedProjAdd(buffer: JagByteBuf, message: ScriptedProjAdd) {
+        buffer.p2Alt1(message.sourceHeight)
+        buffer.p2Alt3(message.id)
+        buffer.p3(message.sourceIndex)
+        buffer.p3Alt2(message.targetIndex)
+        buffer.p2Alt3(message.targetOffsetX)
+        buffer.p2(message.curveScriptT)
+        buffer.p2Alt3(message.sourceOffsetX)
+        buffer.p2Alt1(message.slot)
+        buffer.p2Alt1(message.endTime)
+        buffer.p4(message.targetCoord.packed)
+        buffer.p2Alt1(message.curveScriptH)
+        buffer.p2Alt3(message.targetOffsetZ)
+        buffer.p2Alt3(message.targetHeight)
+        buffer.p2Alt3(message.sourceOffsetZ)
+        buffer.p2Alt1(message.startTime)
+        buffer.p2(message.curveScriptA)
+        buffer.p1Alt3(message.coordInZonePacked)
+    }
+
+    /**
+     * Case 13 (7 bytes): [id p2Alt3][loops -b][range p1][dropOffRange -b][delay p1][coord p1];
+     * call order matches playAreaSound(world, id, x, z, range, dropOffRange, loops, delay).
+     */
+    internal fun writeSoundArea(buffer: JagByteBuf, message: SoundArea) {
+        buffer.p2Alt3(message.id)
+        buffer.p1Alt2(message.loops)
+        buffer.p1(message.range)
+        buffer.p1Alt2(message.dropOffRange)
+        buffer.p1(message.delay)
+        buffer.p1(message.coordInZonePacked)
+    }
+
+    /**
+     * Case 14 (18 bytes): [offsetX p2Alt3][deleteOnFreezeEnd p1][slot LE][height LE][targetIndex
+     * p3Alt2][targetCoord p4Alt3][offsetZ p2][freezeDuration p2]. Offset/height roles inferred.
+     */
+    internal fun writeScriptedProjChange(buffer: JagByteBuf, message: ScriptedProjChange) {
+        buffer.p2Alt3(message.targetOffsetX)
+        buffer.p1(if (message.deleteOnFreezeEnd) 1 else 0)
+        buffer.p2Alt1(message.slot)
+        buffer.p2Alt1(message.targetHeight)
+        buffer.p3Alt2(message.targetIndex)
+        buffer.p4Alt3(message.targetCoord.packed)
+        buffer.p2(message.targetOffsetZ)
+        buffer.p2(message.freezeDuration)
+    }
+
+    /** Case 10: [shape<<2|rot 128-b][coord p1]. */
+    internal fun writeLocDel(buffer: JagByteBuf, message: LocDel) {
+        buffer.p1Alt3(message.locPropertiesPacked)
+        buffer.p1(message.coordInZonePacked)
+    }
+
+    /**
+     * Case 11 (14 bytes): [neverPublic ^0x80][timeUntilDespawn LE][quantity int LE][ownership ^0x80]
+     * [coord p1][id p2][opFlags -b][timeUntilPublic p2Alt2]. Argument order checked against
+     * OBJ_ADD_SPECIFIC, which calls the same obj-add function (0x55775c).
+     */
+    internal fun writeObjAdd(buffer: JagByteBuf, message: ObjAdd) {
+        buffer.p1Alt1(if (message.neverBecomesPublic) 1 else 0)
+        buffer.p2Alt1(message.timeUntilDespawn)
+        buffer.p4Alt1(message.quantity)
+        buffer.p1Alt1(message.ownershipType)
+        buffer.p1(message.coordInZonePacked)
+        buffer.p2(message.id)
+        buffer.p1Alt2(message.opFlags.toInt())
+        buffer.p2Alt2(message.timeUntilPublic)
+    }
+
+    /** Case 5 (7 bytes): [coord p1][quantity p4Alt2][id p2Alt3]; removes the matching obj. */
+    internal fun writeObjDel(buffer: JagByteBuf, message: ObjDel) {
+        buffer.p1(message.coordInZonePacked)
+        buffer.p4Alt2(message.quantity)
+        buffer.p2Alt3(message.id)
+    }
+}
+
+/** Case 14: LOC_ADD_CHANGE_V2 as a top-level packet (same payload as zone index 1). */
+public class AndroidLocAddChangeV2Encoder : MessageEncoder<LocAddChangeV2> {
+    override val prot: ServerProt = AndroidGameServerProt.LOC_ADD_CHANGE_V2
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: LocAddChangeV2) {
+        AndroidZoneProts.writeLocAddChange(buffer, message)
+    }
+}
+
+/** Case 16: LOC_DEL as a top-level packet. */
