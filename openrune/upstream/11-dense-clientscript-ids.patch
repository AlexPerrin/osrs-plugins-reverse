 .../quest/src/main/resources/gamevals.toml    |  2 +-
 .../manager/QuestPolicySyncScriptTest.kt      |  2 +-
 .../kotlin/dev/openrune/pack/PluginPacks.kt   | 32 ++++++++++++++++---
 7 files changed, 47 insertions(+), 25 deletions(-)

