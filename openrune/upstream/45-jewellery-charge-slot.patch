From eb28c879bffa20d17d9d68cb6761d861baa5e4c6 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 10:12:22 -0400
Subject: [PATCH] fix: jewellery charges keep their inventory or worn slot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Problem. A charge swap used invReplace, which puts the next charge in the
first free slot: a worn games necklace moved to the head slot (seen on a
client).

Change. useCharge replaces the item in its own slot (invReplaceSlot), in
the inventory and in the worn inventory.

Tests. JewelleryTeleportScriptTest: the games necklace in inventory slot
5 and the worn glory in the neck slot keep their slots.

Data sources. None (normal OSRS item replacement keeps the slot).

Caveats. None.

🤖 Generated with [Claude Code](https://claude.com/claude-code)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../travel/jewellery/JewelleryTeleportScriptTest.kt      | 4 +++-
 .../content/travel/jewellery/JewelleryTeleportScript.kt  | 9 +++++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/content/travel/jewellery-teleports/src/integration/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScriptTest.kt b/content/travel/jewellery-teleports/src/integration/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScriptTest.kt
index 5bd3521df..b787724cc 100644
--- a/content/travel/jewellery-teleports/src/integration/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScriptTest.kt
+++ b/content/travel/jewellery-teleports/src/integration/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScriptTest.kt
@@ -24,10 +24,11 @@ class JewelleryTeleportScriptTest {
     fun GameTestState.`a use swaps the necklace for one charge less`() =
         runInjectedGameTest(JewelleryTeleportScript::class, null, JewelleryTeleportScript::class) { script ->
             prepare()
-            player.inv[0] = obj("obj.necklace_of_minigames_8")
+            player.inv[5] = obj("obj.necklace_of_minigames_8")
             assertTrue(use(script, "dbrow.jewellery_teleport_games_necklace_8", inventory = true))
             assertEquals(0, player.inv.count("obj.necklace_of_minigames_8"))
             assertEquals(1, player.inv.count("obj.necklace_of_minigames_7"))
+            assertEquals("obj.necklace_of_minigames_7".asRSCM(RSCMType.OBJ), player.inv[5]?.id)
             val sent = client.mapOf(MessageGame::message)
             assertTrue("You rub the necklace..." in sent, sent.toString())
             assertTrue(sent.any { "Your games necklace has seven uses left." in it }, sent.toString())
@@ -45,6 +46,7 @@ class JewelleryTeleportScriptTest {
             assertTrue(use(script, "dbrow.jewellery_teleport_amulet_of_glory_1", inventory = false))
             assertEquals(0, player.worn.count("obj.amulet_of_glory_1"))
             assertEquals(1, player.worn.count("obj.amulet_of_glory"))
+            assertEquals("obj.amulet_of_glory".asRSCM(RSCMType.OBJ), player.worn[NECK_SLOT]?.id)
             val sent = client.mapOf(MessageGame::message)
             assertTrue(sent.any { "Your ring of dueling crumbles to dust." in it }, sent.toString())
             assertTrue(sent.any { "You use your amulet's last charge." in it }, sent.toString())
diff --git a/content/travel/jewellery-teleports/src/main/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScript.kt b/content/travel/jewellery-teleports/src/main/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScript.kt
index 9272303cf..f60e43d6c 100644
--- a/content/travel/jewellery-teleports/src/main/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScript.kt
+++ b/content/travel/jewellery-teleports/src/main/kotlin/org/rsmod/content/travel/jewellery/JewelleryTeleportScript.kt
@@ -95,9 +95,14 @@ constructor(private val validator: PlayerTeleportValidator, private val areaChec
 
     /** Swaps [item] in [from] for its next charge (or removes it) and sends the charge messages. */
     fun ProtectedAccess.useCharge(item: JewelleryTeleportItemsRow, from: Inventory): Boolean {
-        val obj = item.obj.internalName
+        val slot = from.indexOfFirst { it?.id == item.obj.id }
+        if (slot < 0) return false
         val used =
-            if (item.crumbles == 1) invDel(from, obj, 1) else invReplace(from, obj, 1, item.next.internalName)
+            if (item.crumbles == 1) {
+                invDel(from, item.obj.internalName, 1)
+            } else {
+                invReplaceSlot(from, slot, 1, item.next)
+            }
         if (used.failure) return false
         mes("You rub the ${item.rubWord}...")
         val left = item.charges - 1
