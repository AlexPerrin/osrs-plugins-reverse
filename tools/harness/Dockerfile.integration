# syntax=docker/dockerfile:1
# The deploy image of a gated integration commit (tools/harness/image.sh). Same layout as openrune/Dockerfile:
# server/ and data/ are the gate's installDist output and data, staged without any key file; the login key
# (game.key, rsa.properties), game.yml and entrypoint.sh come from the live image only (ARG LIVE_IMAGE = its image
# id), so patched clients keep their modulus and the key never exists outside the two images.
ARG LIVE_IMAGE=osrs-openrune:241
FROM ${LIVE_IMAGE} AS live
FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --chown=1000:1000 server /app/server
COPY --chown=1000:1000 data /app/.data
COPY --chown=1000:1000 --from=live /app/.data/game.key /app/.data/game.key
COPY --chown=1000:1000 --from=live /app/.data/rsa.properties /app/.data/rsa.properties
COPY --chown=1000:1000 --from=live /app/game.yml /app/game.yml
COPY --chown=1000:1000 --from=live /app/entrypoint.sh /app/entrypoint.sh
RUN mkdir -p /app/.data/postgres /app/plugins /app/logs && chown -R 1000:1000 /app/.data/postgres /app/plugins /app/logs
USER 1000:1000
ENV HOME=/app
EXPOSE 43594
VOLUME /app/.data/postgres
ENTRYPOINT ["/app/entrypoint.sh"]
