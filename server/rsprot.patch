+package net.rsprot.protocol.api
+
+/**
+ * osrs-plugins-reverse: when [enabled], every incoming game packet is logged at INFO with its
+ * opcode, length, message class and first payload bytes, before the consumer check, so packets the
+ * server has no listener for show up too. For live protocol verification (`::trace`).
+ */
+public object IncomingPacketTrace {
+    @Volatile
+    public var enabled: Boolean = false
+
+    public const val MAX_BYTES: Int = 48
+}
