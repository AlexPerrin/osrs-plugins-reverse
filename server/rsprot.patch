+/** A decoder with the message class it produces (the repository keys consumers by class). */
+public class BoundDecoder(
+    public val messageClass: Class<out IncomingMessage>,
+    public val decoder: MessageDecoder<*>,
+)
+
+private inline fun <reified T : IncomingMessage> bound(decoder: MessageDecoder<T>): BoundDecoder =
+    BoundDecoder(T::class.java, decoder)
+
+private class Dec<T : IncomingMessage>(
+    override val prot: ClientProt,
+    private val read: (JagByteBuf) -> T,
+) : MessageDecoder<T> {
+    override fun decode(buffer: JagByteBuf): T {
+        val message = read(buffer)
+        val left = buffer.readableBytes()
+        if (left > 0) {
+            // A layout mismatch would otherwise disconnect the client (unread payload is fatal).
+            logger.warn { "Android ${prot} decoder left $left bytes unread; skipped" }
+            buffer.buffer.skipBytes(left)
+        }
+        return message
+    }
+
+    private companion object {
+        private val logger = InlineLogger()
+    }
+}
+
+private inline fun <reified T : IncomingMessage> bound(
+    prot: ClientProt,
+    noinline read: (JagByteBuf) -> T,
+): BoundDecoder = BoundDecoder(T::class.java, Dec(prot, read))
+
+/** Decoders with Android-specific layouts, in the sender's write order. */
+internal fun androidCustomDecoders(): List<BoundDecoder> =
+    listOf(
+        // 8 (sender 0x5e6af4, CS2 op 0x789/0xb71 in FUN_005e681c): combinedId p4Alt3, obj p2 (the
+        // component's +0xb38, which IF_SETOBJECT sets), sub p2Alt1, crc p4Alt3 (the op's first int),
+        // then the args by the signature string, as desktop (ints as zigzag LEB128 = gVarInt2s), kept
+        // raw for IfScriptTrigger.decode.
+        bound(P.IF_SCRIPT_TRIGGER) { b ->
+            val combinedId = b.g4Alt3()
+            val obj = b.g2()
+            val sub = b.g2Alt1()
+            val crc = b.g4Alt3()
+            val args = b.buffer.copy()
+            b.buffer.readerIndex(b.buffer.writerIndex())
+            IfScriptTrigger(CombinedId(combinedId), sub, obj, crc, args)
+        },
+        // 84 (sender 0x51fc20 in FUN_0051d0a4): behaviours are the 3-int array at +0x148 (filled by
+        // FUN_006cf41c), the server target comes from FUN_006cf688, sub/combinedId from the target
+        // component (+8/+4).
+        bound(P.IF_CRMVIEW_OP) { b ->
+            val behaviour2 = b.g4Alt1()
+            val behaviour1 = b.g4Alt1()
+            val sub = b.g2Alt1()
+            val serverTarget = b.g4Alt2()
+            val behaviour3 = b.g4Alt1()
+            val combinedId = b.g4Alt2()
+            IfCrmViewOp(serverTarget, CombinedId(combinedId), sub, behaviour1, behaviour2, behaviour3)
+        },
+        // 13 (sender 0x51d0a4 -> 0x4fa578): 7 x g2 like desktop, minus desktop's zero checks.
+        bound(P.CONNECTION_TELEMETRY) { b ->
+            val lost = b.g2()
+            val login = b.g2()
+            b.g2()
+            val state = b.g2()
+            b.g2()
+            val count = b.g2()
+            b.g2()
+            ConnectionTelemetry(lost, login, state, count)
+        },
+        // 77: packed g2 (time << 1 | right click), y g2Alt2, x g2, code g1.
+        bound(P.EVENT_MOUSE_CLICK_V2) { b ->
+            val packed = b.g2()
+            val y = b.g2Alt2()
+            val x = b.g2()
+            val code = b.g1()
+            EventMouseClickV2(packed ushr 1, code, packed and 1 != 0, x, y)
+        },
+        // 37: per key, key g1Alt2 then delta g3Alt3 (Android writes the key first).
+        bound(P.EVENT_KEYBOARD) { b ->
+            val count = b.readableBytes() / 4
+            val keys = ByteArray(count)
+            var last = -1
+            for (i in 0..<count) {
+                keys[i] = b.g1Alt2().toByte()
+                val delta = b.g3Alt3()
+                if (i == 0) last = delta
+            }
+            EventKeyboard(last, EventKeyboard.KeySequence(keys))
+        },
+        // 16: angleX g2Alt3, angleY g2Alt3 (pitch then yaw, order as desktop).
+        // 16 (sender in 0x51d0a4): yaw (client+0x894a0 / 8, also the camera angle appended to minimap clicks)
+        // g2Alt3, then pitch (client+0x8949c / 8) g2Alt3. RSProt's angleX is the pitch, angleY the yaw.
+        bound(P.EVENT_CAMERA_POSITION) { b ->
+            val yaw = b.g2Alt3()
+            val pitch = b.g2Alt3()
+            EventCameraPosition(pitch, yaw)
+        },
+        // 19: fps g1Alt2, value1 g4Alt1, value2 g4, gcPercentTime g1.
+        bound(P.SEND_PING_REPLY) { b ->
+            val fps = b.g1Alt2()
+            val v1 = b.g4Alt1()
+            val v2 = b.g4()
+            val gc = b.g1()
+            SendPingReply(fps, gc, v1, v2)
+        },
+        // 29: packed coord g4Alt3.
+        bound(P.CLICKWORLDMAP) { b -> ClickWorldMap(CoordGrid(b.g4Alt3())) },
+        // 35: level g1Alt2, x g2Alt3, z g2Alt2, oculusSyncValue g4Alt3.
+        bound(P.TELEPORT) { b ->
+            val level = b.g1Alt2()
+            val x = b.g2Alt3()
+            val z = b.g2Alt2()
+            Teleport(b.g4Alt3(), x, z, level)
+        },
+        // 39: x g2Alt3, z g2Alt2, keyCombination g1Alt3, then the desktop minimap tail (skipped).
+        // Decoded as MoveGameClick so minimap walking uses the same path.
+        bound(P.MOVE_MINIMAPCLICK) { b ->
+            val x = b.g2Alt3()
+            val z = b.g2Alt2()
+            val key = b.g1Alt3()
+            b.buffer.skipBytes(b.readableBytes())
+            MoveGameClick(x, z, key)
+        },
+        // 88: rank g1Alt1, name.
+        bound(P.FRIENDCHAT_SETRANK) { b ->
+            val rank = b.g1Alt1()
+            FriendChatSetRank(b.gjstr(), rank)
+        },
+        // 42: instructions, type g1, description.
+        bound(P.BUG_REPORT) { b ->
+            val instructions = b.gjstr()
+            val type = b.g1()
+            BugReport(type, b.gjstr(), instructions)
+        },
+        // 15 (sender 0x627974).
+        bound(P.IF_BUTTONT) { b ->
+            val target = b.g4()
+            val selSub = b.g2()
+            val sel = b.g4()
+            val targetSub = b.g2Alt2()
+            val targetObj = b.g2Alt2()
+            val selObj = b.g2Alt1()
+            IfButtonT(CombinedId(sel), selSub, selObj, CombinedId(target), targetSub, targetObj)
+        },
+        // 43 (sender 0x628b50).
+        bound(P.IF_BUTTOND) { b ->
+            val sel = b.g4Alt2()
+            val targetSub = b.g2Alt2()
+            val targetObj = b.g2Alt2()
+            val target = b.g4Alt3()
+            val selObj = b.g2Alt3()
+            val selSub = b.g2Alt2()
+            IfButtonD(CombinedId(sel), selSub, selObj, CombinedId(target), targetSub, targetObj)
+        },
+        // 5 (sender 0x622bd4).
+        bound(P.OPPLAYERT) { b ->
+            val selObj = b.g2Alt1()
+            val sel = b.g4Alt1()
+            val index = b.g2Alt1()
+            val ctrl = b.g1Alt3() == 1
+            val selSub = b.g2Alt3()
+            OpPlayerT(index, ctrl, CombinedId(sel), selSub, selObj)
+        },
+        // 49 (sender 0x620400): NPC type id g2.
+        bound(P.OPNPC6) { b -> OpNpc6(b.g2()) },
+        // 6 (sender 0x6211ac, same struct as the OPOBJ1-5 sender 0x62073c: +4 x, +8 z, +0xc id):
+        // id g2Alt1, z g2Alt3, x g2Alt1.
+        bound(P.OPOBJ6) { b ->
+            val id = b.g2Alt1()
+            val z = b.g2Alt3()
+            val x = b.g2Alt1()
+            net.rsprot.protocol.game.incoming.objs.OpObj6(id, x, z)
+        },
+        // 69 (sender 0x623550): id g2Alt3.
+        bound(P.OPWORLDENTITY6) { b -> OpWorldEntity6(b.g2Alt3()) },
+        // 45 (sender 0x623960): heading g1Alt2.
+        bound(P.SET_HEADING) { b -> SetHeading(b.g1Alt2()) },
+    ) +
+        ANDROID_OPPLAYER.map { (prot, op, spec) ->
+            bound(prot) { b ->
+                val f = b.readFields(spec)
+                OpPlayer(f.getValue("index"), f.getValue("ctrl") == 1, op)
+            }
+        } +
+        ANDROID_OPWORLDENTITY.map { (prot, op, spec) ->
+            bound(prot) { b ->
+                val f = b.readFields(spec)
+                OpWorldEntity(f.getValue("index"), f.getValue("ctrl") == 1, op)
+            }
+        }
