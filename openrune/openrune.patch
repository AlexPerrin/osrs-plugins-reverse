+                assertEquals(3, script.value(player, patch))
+                assertEquals(3, player.inv.count(WEEDS))
+
+                var planted = false
+                player.withProtectedAccess { planted = plant(patch, "obj.potato_seed") }
+                assertTrue(planted)
