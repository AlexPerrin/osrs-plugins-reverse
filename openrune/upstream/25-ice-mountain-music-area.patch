 .data/gamevals/dbrow.rscm                     |  1 +
 .data/raw-cache/map/area/ice_mountain.toml    | 59 +++++++++++++++++++
 .../main/kotlin/dev/openrune/impl/Music.kt    |  6 ++
 4 files changed, 67 insertions(+)
 create mode 100644 .data/raw-cache/map/area/ice_mountain.toml

diff --git a/.data/gamevals/area.rscm b/.data/gamevals/area.rscm
