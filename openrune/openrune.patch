+package org.rsmod.content.other.treasuretrails.pack
+
+import dev.openrune.definition.dbtables.dbTable
+import dev.openrune.definition.util.VarType
+import dev.openrune.pack.columnCoord
+import org.rsmod.map.CoordGrid
+
+/**
+ * Beginner Treasure Trail steps (OSRS Wiki: Treasure Trails/Guide/Beginner; the anagram, cryptic,
+ * emote and map pages). [TEXT] is what the clue scroll interface shows, in the exact wording
+ * RuneLite's Clue Scroll plugin matches. Talk steps name the [NPC]; emote steps an [EMOTE] (seq
+ * symbol) within [RADIUS] of [COORD] while wearing [ITEM_1]/[ITEM_2]; map steps open [MAP] and are
+ * dug within [RADIUS] of [COORD]. Not here: hot-cold (Reldo's strange device) and Charlie the
+ * Tramp's item tasks.
+ */
+object BeginnerClueStepsTable {
+    const val TYPE = 0
+    const val TEXT = 1
+    const val NPC = 2
+    const val COORD = 3
+    const val RADIUS = 4
+    const val EMOTE = 5
+    const val ITEM_1 = 6
+    const val ITEM_2 = 7
+    const val MAP = 8
+
+    const val TALK = 0
+    const val EMOTE_STEP = 1
+    const val MAP_STEP = 2
+
+    private data class Step(
+        val name: String,
+        val type: Int,
+        val coord: CoordGrid,
+        val radius: Int,
+        val text: String? = null,
+        val npc: String? = null,
+        val emote: String? = null,
+        val items: List<String> = emptyList(),
+        val map: String? = null,
+    )
+
+    private fun anagram(name: String, letters: String, npc: String, coord: CoordGrid) =
+        Step(
+            "anagram_$name",
+            TALK,
+            coord,
+            0,
+            text = "The anagram reveals<br>who to speak to next:<br>$letters",
+            npc = npc,
+        )
+
+    private fun cryptic(name: String, text: String, npc: String, coord: CoordGrid) =
+        Step("cryptic_$name", TALK, coord, 0, text = text, npc = npc)
+
+    private fun emote(
+        name: String,
+        text: String,
+        seq: String,
+        coord: CoordGrid,
+        radius: Int,
+        vararg items: String,
+    ) = Step("emote_$name", EMOTE_STEP, coord, radius, text = text, emote = seq, items = items.toList())
+
+    private fun map(name: String, map: String, coord: CoordGrid) =
+        Step("map_$name", MAP_STEP, coord, 1, map = map)
+
+    private val STEPS =
+        listOf(
+            anagram("ranael", "AN EARL", "npc.ranael", CoordGrid(3315, 3163, 0)),
+            anagram("apothecary", "CARPET AHOY", "npc.apothecary", CoordGrid(3195, 3404, 0)),
+            anagram("doric", "I CORD", "npc.doric", CoordGrid(2951, 3450, 0)),
+            anagram("brian", "IN BAR", "npc.brian", CoordGrid(3026, 3246, 0)),
+            anagram("veronica", "RAIN COVE", "npc.veronica", CoordGrid(3110, 3330, 0)),
+            anagram("gertrude", "RUG DETER", "npc.gertrude", CoordGrid(3151, 3412, 0)),
+            anagram("hairdresser", "SIR SHARE RED", "npc.hairdresser", CoordGrid(2944, 3381, 0)),
+            cryptic(
+                "hans",
+                "Always walking around the castle grounds and somehow knows everyone's age.",
+                "npc.hans",
+                CoordGrid(3221, 3218, 0),
+            ),
+            cryptic(
+                "cook",
+                "In the place Duke Horacio calls home, talk to a man with a hat dropped by goblins.",
+                "npc.cook",
+                CoordGrid(3208, 3213, 0),
+            ),
+            cryptic(
+                "shantay",
+                "Near the open desert I reside, to get past me you must abide. Go forward if you " +
+                    "dare, for when you pass me, you'll be sweating by your hair.",
+                "npc.shantay",
+                CoordGrid(3303, 3123, 0),
+            ),
+            emote(
+                "aris",
+                "Blow a raspberry at Aris in her tent. Equip a gold ring and a gold necklace.",
+                "seq.emote_ya_boo_sucks",
+                CoordGrid(3203, 3424, 0),
+                3,
+                "obj.gold_ring",
+                "obj.gold_necklace",
+            ),
+            emote(
+                "brugsen",
+                "Bow to Brugsen Bursen at the Grand Exchange.",
+                "seq.emote_bow",
+                CoordGrid(3164, 3477, 0),
+                5,
+            ),
+            emote(
+                "iffie",
+                "Cheer at Iffie Nitter. Equip a chef hat and a red cape.",
+                "seq.emote_cheer",
+                CoordGrid(3205, 3416, 0),
+                3,
+                "obj.chefs_hat",
+                "obj.red_cape",
+            ),
+            emote(
+                "bob",
+                "Clap at Bob's Brilliant Axes. Equip a bronze axe and leather boots.",
+                "seq.emote_clap",
+                CoordGrid(3231, 3203, 0),
+                3,
+                "obj.bronze_axe",
+                "obj.leather_boots",
+            ),
+            emote(
+                "al_kharid_mine",
+                "Panic at Al Kharid mine.",
+                "seq.emote_panic",
+                CoordGrid(3303, 3271, 0),
+                12,
+            ),
+            emote(
+                "flynn",
+                "Spin at Flynn's Mace Shop.",
+                "seq.emote_dance_spin",
+                CoordGrid(2950, 3387, 0),
+                3,
+            ),
+            map("champions_guild", "interface.trail_map01", CoordGrid(3167, 3360, 0)),
+            map("varrock_east_mine", "interface.trail_map02", CoordGrid(3290, 3373, 0)),
+            map("draynor_bank", "interface.trail_map03", CoordGrid(3092, 3226, 0)),
+            map("standing_stones", "interface.trail_map06", CoordGrid(3043, 3399, 0)),
+            map("wizards_tower", "interface.trail_map11", CoordGrid(3109, 3153, 0)),
+        )
+
+    fun steps() =
+        dbTable("dbtable.trail_beginner_steps", serverOnly = true) {
+            column("type", TYPE, VarType.INT)
+            column("text", TEXT, VarType.STRING)
+            column("npc", NPC, VarType.NPC)
+            column("coord", COORD, VarType.COORDGRID)
+            column("radius", RADIUS, VarType.INT)
+            column("emote", EMOTE, VarType.STRING)
+            column("item_1", ITEM_1, VarType.OBJ)
+            column("item_2", ITEM_2, VarType.OBJ)
+            column("map", MAP, VarType.STRING)
+
+            for (s in STEPS) {
+                row("dbrow.trail_beginner_${s.name}") {
+                    column(TYPE, s.type)
+                    s.text?.let { column(TEXT, it) }
+                    s.npc?.let { columnRSCM(NPC, it) }
+                    columnCoord(COORD, s.coord)
+                    column(RADIUS, s.radius)
+                    s.emote?.let { column(EMOTE, it) }
+                    s.items.getOrNull(0)?.let { columnRSCM(ITEM_1, it) }
+                    s.items.getOrNull(1)?.let { columnRSCM(ITEM_2, it) }
+                    s.map?.let { column(MAP, it) }
+                }
+            }
+        }
+}
