diff --git a/content/skills/farming/pack/src/main/kotlin/org/rsmod/content/skills/farming/pack/FarmingCropsTable.kt b/content/skills/farming/pack/src/main/kotlin/org/rsmod/content/skills/farming/pack/FarmingCropsTable.kt
