+# osrs-plugins-reverse: Lumbridge castle doors the map places as their Recipe for Disaster
+# ("hundred_") variants, which had no door tag ("Nothing interesting happens"): the kitchen to
+# dining room door (3207,3217) and the hallway to dining room double doors (3213,3221-3222).
+# They share models with elfdoor and castledoubledoor*, so they open into those doors' open states
+# (which close back to the plain variants).
+
+[[object]]
+id = "loc.hundred_lumbridge_door"
+inherit = "loc.hundred_lumbridge_door"
+contentGroup = "content.closed_single_door"
+
+[object.params]
+"param.next_loc_stage" = "loc.elfdooropen"
+
+[[object]]
+id = "loc.hundred_lumbridge_doubledoorl"
+inherit = "loc.hundred_lumbridge_doubledoorl"
+contentGroup = "content.closed_left_door"
+
+[object.params]
+"param.next_loc_stage" = "loc.opencastledoubledoorl"
+
+[[object]]
+id = "loc.hundred_lumbridge_doubledoorr"
+inherit = "loc.hundred_lumbridge_doubledoorr"
+contentGroup = "content.closed_right_door"
+
+[object.params]
+"param.next_loc_stage" = "loc.opencastledoubledoorr"
