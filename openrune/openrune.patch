diff --git a/content/other/treasure-trails/src/main/kotlin/org/rsmod/content/other/treasuretrails/StashUnitScript.kt b/content/other/treasure-trails/src/main/kotlin/org/rsmod/content/other/treasuretrails/StashUnitScript.kt
