     client.write(message)
 }
 
+/**
+ * Sends the examine as [ChatType.ObjExamine], the type RuneLite expects for items (the stock
+ * `examine_item` clientscript prints it with `mes`, as a plain game message).
+ */
+@Suppress("UNUSED_PARAMETER")
 public fun Player.objExamine(type: ItemServerType, count: Int, marketPrice: Int) {
-    ClientScripts.examineItem(
-        player = this,
-        obj = type.id,
-        count = count,
-        desc = type.examine,
-        market = type.stockmarket,
-        marketPrice = marketPrice,
-        alchable = type.param(params.no_alchemy) == 0,
-        lowAlch = type.lowAlch,
-        highAlch = type.highAlch,
-    )
+    val text =
+        if (count >= 100_000) "${"%,d".format(Locale.ROOT, count)} x ${type.name}." else type.examine
+    mes(text, ChatType.ObjExamine)
 }
 
 public object GameMessage {
