+            hotCold("draynor_manor_mushrooms", CoordGrid(3096, 3379, 0)),
+            hotCold("draynor_wheat_field", CoordGrid(3120, 3282, 0)),
+            hotCold("ice_mountain", CoordGrid(3007, 3475, 0)),
+            hotCold("lumbridge_cow_field", CoordGrid(3174, 3336, 0)),
+            hotCold("northeast_of_al_kharid_mine", CoordGrid(3332, 3313, 0)),
+        )
+
+    fun steps() =
+        dbTable("dbtable.trail_beginner_steps", serverOnly = true) {
+            column("type", TYPE, VarType.INT)
+            column("text", TEXT, VarType.STRING)
+            column("npc", NPC, VarType.NPC)
+            column("coord", COORD, VarType.COORDGRID)
+            column("radius", RADIUS, VarType.INT)
+            column("emote", EMOTE, VarType.STRING)
+            column("item_1", ITEM_1, VarType.OBJ)
+            column("item_2", ITEM_2, VarType.OBJ)
+            column("map", MAP, VarType.STRING)
+            column("request", REQUEST, VarType.STRING)
+
+            for (s in STEPS) {
+                row("dbrow.trail_beginner_${s.name}") {
+                    column(TYPE, s.type)
+                    s.text?.let { column(TEXT, it) }
+                    s.npc?.let { columnRSCM(NPC, it) }
+                    columnCoord(COORD, s.coord)
+                    column(RADIUS, s.radius)
+                    s.emote?.let { column(EMOTE, it) }
+                    s.items.getOrNull(0)?.let { columnRSCM(ITEM_1, it) }
+                    s.items.getOrNull(1)?.let { columnRSCM(ITEM_2, it) }
+                    s.map?.let { column(MAP, it) }
+                    s.request?.let { column(REQUEST, it) }
+                }
+            }
+        }
+}
diff --git a/content/other/treasure-trails/pack/src/main/kotlin/org/rsmod/content/other/treasuretrails/pack/StashUnitsTable.kt b/content/other/treasure-trails/pack/src/main/kotlin/org/rsmod/content/other/treasuretrails/pack/StashUnitsTable.kt
