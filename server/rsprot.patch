+package net.rsprot.protocol.android.unverified
+
+import net.rsprot.buffer.JagByteBuf
+import net.rsprot.protocol.common.client.OldSchoolClientType
+import net.rsprot.protocol.internal.game.outgoing.info.worldentityinfo.encoder.WorldEntityResolutionChangeEncoder
+
+public class AndroidWorldEntityResolutionChangeEncoder : WorldEntityResolutionChangeEncoder {
+    override val clientType: OldSchoolClientType = OldSchoolClientType.ANDROID
+
+    override fun encodeAddition(
+        buffer: JagByteBuf,
+        id: Int,
+        sizeX: Int,
+        sizeZ: Int,
+        priority: Int,
+    ): Int {
+        buffer.p2Alt1(id)
+        val flagWriteIndex = buffer.writerIndex()
+        buffer.p1Alt3(0)
+        buffer.p1Alt2(priority)
+        buffer.p1Alt3((sizeX shl 4) or sizeZ)
+        return flagWriteIndex
+    }
+
+    override fun rewriteExtendedInfoFlag(
+        buffer: JagByteBuf,
+        flagWriteIndex: Int,
+        flag: Int,
+    ) {
+        val finalPosition = buffer.writerIndex()
+        buffer.writerIndex(flagWriteIndex)
+        buffer.p1Alt3(flag)
+        buffer.writerIndex(finalPosition)
+    }
+}
