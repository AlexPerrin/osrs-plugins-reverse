+@Suppress("UNCHECKED_CAST")
+private fun MessageDecoderRepositoryBuilder<AndroidGameClientProt>.bindBound(b: BoundDecoder) {
+    bind(b.messageClass as Class<IncomingMessage>, b.decoder as MessageDecoder<IncomingMessage>)
+}
