From 35a91107fb4a6756b0996bfd147276f2bf71a352 Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 09:27:10 -0400
Subject: [PATCH] Pets: send the follower varp when a follower respawns at
 login

The follower npc respawned on the login tick sets follower_npc (varp 447)
before the engine transmits varps, so the client kept the login value (0 or
the old npc) although the follower follows. RuneLite's Kitten Tracker and
follower plugins read it. Resync the varp after each spawn.
---
 .../kotlin/org/rsmod/content/other/pets/PetFollowers.kt   | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/PetFollowers.kt b/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/PetFollowers.kt
index 51fa26f50..a1b4b6892 100644
--- a/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/PetFollowers.kt
+++ b/content/other/pets/src/main/kotlin/org/rsmod/content/other/pets/PetFollowers.kt
@@ -10,6 +10,7 @@ import org.rsmod.api.player.protect.ProtectedAccess
 import org.rsmod.api.player.vars.boolVarBit
 import org.rsmod.api.player.vars.intVarBit
 import org.rsmod.api.player.vars.intVarp
+import org.rsmod.api.player.vars.resyncVar
 import org.rsmod.api.repo.npc.NpcRepository
 import org.rsmod.content.other.pets.cats.Cats
 import org.rsmod.content.other.pets.dogs.Dogs
@@ -88,6 +89,9 @@ constructor(
             player.faceNpc(npc)
         }
         player.followerNpc = npc.uid.packed
+        // A follower respawned on the login tick is set before the engine transmits varps, so the
+        // client would keep the value sent with the login varps (Kitten Tracker reads it).
+        player.resyncVar(FOLLOWER_VARP)
         player.followerObj = form.objId
     }
 
@@ -245,6 +249,8 @@ constructor(
  * Official varp the client reads to render follower-only right-click options. Holds the npc uid,
  * which packs as `(type shl 16) or slot` — exactly what the client expects.
  */
-private var Player.followerNpc: Int by intVarp("varp.follower_npc")
+private const val FOLLOWER_VARP = "varp.follower_npc"
+
+private var Player.followerNpc: Int by intVarp(FOLLOWER_VARP)
 private var Player.followerStuck: Int by intVarBit("varbit.pet_follower_stuck")
 private var Player.followerBusy: Boolean by boolVarBit("varbit.pet_follower_busy")
-- 
