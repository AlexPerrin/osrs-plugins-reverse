+        buffer.p1(if (message.heightRelative) 1 else 0)
+    }
+}
+
+/** Case 133: camera position tween. */
+public class AndroidCamMoveToCyclesV3Encoder : MessageEncoder<CamMoveToCyclesV3> {
+    override val prot: ServerProt = AndroidGameServerProt.CAM_MOVETO_CYCLES_V3
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: CamMoveToCyclesV3) {
+        buffer.p1Alt3(message.easing.id)
+        buffer.p2(message.x)
+        buffer.p2(message.cycles)
+        buffer.p2(message.z)
+        buffer.p1(if (message.ignoreTerrain) 1 else 0)
+        buffer.p1(if (message.heightRelative) 1 else 0)
+        buffer.p2(message.height)
+    }
+}
+
+/** Case 136: [heightRelative ^0x80][height LE][x LE][rate -b][z p2Alt2][rate2 p1]. */
+public class AndroidCamMoveToV3Encoder : MessageEncoder<CamMoveToV3> {
+    override val prot: ServerProt = AndroidGameServerProt.CAM_MOVETO_V3
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: CamMoveToV3) {
+        buffer.p1Alt1(if (message.heightRelative) 1 else 0)
+        buffer.p2Alt1(message.height)
+        buffer.p2Alt1(message.x)
+        buffer.p1Alt2(message.rate)
+        buffer.p2Alt2(message.z)
+        buffer.p1(message.rate2)
+    }
+}
+
+/** Case 142: pitch/yaw towards a point. */
+public class AndroidCamRotateToCoordinateV3Encoder : MessageEncoder<CamRotateToCoordinateV3> {
+    override val prot: ServerProt = AndroidGameServerProt.CAM_ROTATETO_COORDINATE_V3
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: CamRotateToCoordinateV3) {
+        buffer.p2Alt1(message.height)
+        buffer.p1(if (message.trackTarget) 1 else 0)
+        buffer.p1Alt3(message.easing.id)
+        buffer.p2Alt1(message.cycles)
+        buffer.p1Alt1(if (message.heightRelative) 1 else 0)
+        buffer.p2Alt3(message.z)
+        buffer.p2Alt1(message.x)
+    }
+}
+
+/** Case 144: lookat tween. */
+public class AndroidCamLookAtCyclesEncoder : MessageEncoder<CamLookAtCycles> {
+    override val prot: ServerProt = AndroidGameServerProt.CAM_LOOKAT_CYCLES
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: CamLookAtCycles) {
+        buffer.p2Alt1(message.z)
+        buffer.p2Alt1(message.x)
+        buffer.p1Alt3(message.easing.id)
+        buffer.p2Alt2(message.height)
+        buffer.p1(if (message.heightRelative) 1 else 0)
+        buffer.p2Alt2(message.cycles)
+    }
+}
+
+/** Case 147: [id p2Alt2][fade p1]. */
+public class AndroidAmbientSoundStartEncoder : MessageEncoder<AmbientSoundStart> {
+    override val prot: ServerProt = AndroidGameServerProt.AMBIENTSOUND_START
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: AmbientSoundStart) {
+        buffer.p2Alt2(message.id)
+        buffer.p1(if (message.fade) 1 else 0)
+    }
+}
+
+/**
+ * Case 123: [fadeInDelay p2][fadeInSpeed p2Alt3][fadeOutSpeed LE][fadeOutDelay p2Alt3] ->
+ * FUN_007907c8(outDelay, outSpeed, inDelay, inSpeed). Its globals 0xb842f0/0xb84300 feed wait tasks
+ * (delays) and 0xb842f8 a fade task (speed) in the music player (FUN_0078e970); MIDI_SONG_STOP (86)
+ * fills the same first two through FUN_00790000.
+ */
+public class AndroidMidiSwapEncoder : MessageEncoder<MidiSwap> {
+    override val prot: ServerProt = AndroidGameServerProt.MIDI_SWAP
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: MidiSwap) {
+        buffer.p2(message.fadeInDelay)
+        buffer.p2Alt3(message.fadeInSpeed)
+        buffer.p2Alt1(message.fadeOutSpeed)
+        buffer.p2Alt3(message.fadeOutDelay)
+    }
+}
+
+/** Case 148: [model p4]; -1 clears (by size elimination with OCULUS_SYNC at 44). */
+public class AndroidCamSkyboxEncoder : MessageEncoder<CamSkybox> {
+    override val prot: ServerProt = AndroidGameServerProt.CAM_SKYBOX
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: CamSkybox) {
+        buffer.p4(message.model)
+    }
+}
+
+/** Case 149: [fade ^0x80]. */
+public class AndroidAmbientSoundStopEncoder : MessageEncoder<AmbientSoundStop> {
+    override val prot: ServerProt = AndroidGameServerProt.AMBIENTSOUND_STOP
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: AmbientSoundStop) {
+        buffer.p1Alt1(if (message.fade) 1 else 0)
+    }
+}
+
+/** Cases 113 (npc) / 20 (loc) / 115 (obj, by elimination): one byte, b & 1 stored in a settings struct. */
+public class AndroidHideNpcOpsEncoder : MessageEncoder<HideNpcOps> {
+    override val prot: ServerProt = AndroidGameServerProt.HIDENPCOPS
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: HideNpcOps) {
+        buffer.pboolean(message.hidden)
+    }
+}
+
+public class AndroidHideLocOpsEncoder : MessageEncoder<HideLocOps> {
+    override val prot: ServerProt = AndroidGameServerProt.HIDELOCOPS
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: HideLocOps) {
+        buffer.pboolean(message.hidden)
+    }
+}
+
+public class AndroidHideObjOpsEncoder : MessageEncoder<HideObjOps> {
+    override val prot: ServerProt = AndroidGameServerProt.HIDEOBJOPS
+
+    override fun encode(streamCipher: StreamCipher, buffer: JagByteBuf, message: HideObjOps) {
+        buffer.pboolean(message.hidden)
+    }
+}
+
+/** Case 65: one string (as desktop), kept for the URL-opening CS2 ops. */
+public fun androidSiteSettingsEncoder(): MessageEncoder<net.rsprot.protocol.game.outgoing.misc.client.SiteSettings> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.SITE_SETTINGS, net.rsprot.protocol.game.outgoing.codec.misc.client.SiteSettingsEncoder())
+
+/** Case 121: as desktop (all fields BE). */
+public fun androidIfResyncV2Encoder(): MessageEncoder<net.rsprot.protocol.game.outgoing.interfaces.IfResyncV2> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.IF_RESYNC_V2, net.rsprot.protocol.game.outgoing.codec.interfaces.IfResyncV2Encoder())
+
+/** Case 143: coord p4 BE, -1 = no flag (as desktop). */
+public fun androidSetMapFlagV2Encoder(): MessageEncoder<net.rsprot.protocol.game.outgoing.misc.player.SetMapFlagV2> =
+    AndroidDelegatingEncoder(AndroidGameServerProt.SET_MAP_FLAG_V2, net.rsprot.protocol.game.outgoing.codec.misc.player.SetMapFlagV2Encoder())
+
+/**
+ * Case 132: id p2, recol count p1, (index p1Alt1, value p2Alt3)*, colour flag p1Alt3 (raw 0x7f =
+ * present) [+ colour p2Alt2], model p2Alt3, retex count p1, (index p1Alt1, value p2)*, coord p4,
+ * quantity p4. Recolour vs retexture lists: same destination vectors as case 12 (V1).
+ */
+public class AndroidObjCustomiseSpecificV2Encoder :
+    MessageEncoder<net.rsprot.protocol.game.outgoing.specific.ObjCustomiseSpecificV2> {
+    override val prot: ServerProt = AndroidGameServerProt.OBJ_CUSTOMISE_SPECIFIC_V2
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.specific.ObjCustomiseSpecificV2,
+    ) {
+        buffer.p2(message.id)
+        buffer.p1(message.recolours.size)
+        for ((index, value) in message.recolours) {
+            buffer.p1Alt1(index)
+            buffer.p2Alt3(value)
+        }
+        val colour = message.colour
+        buffer.p1Alt3(if (colour != null) 1 else 0)
+        if (colour != null) buffer.p2Alt2(colour)
+        buffer.p2Alt3(message.model)
+        buffer.p1(message.retextures.size)
+        for ((index, value) in message.retextures) {
+            buffer.p1Alt1(index)
+            buffer.p2(value)
+        }
+        buffer.p4(message.coordGrid.packed)
+        buffer.p4(message.quantity)
+    }
+}
+
+/**
+ * Case 76 (27 bytes): sourceIndex p3Alt2, progress p2, startHeight p2, targetIndex p3Alt3,
+ * startTime p2Alt3, end p4Alt1, start p4Alt3, angle p1, id p2Alt1 (0xffff = none), endTime p2Alt2,
+ * endHeight p2Alt3. Byte orders read from the case; field roles from the order of the struct it
+ * fills (start coord, startHeight, sourceIndex, end coord, endHeight, targetIndex, startTime,
+ * endTime, angle, progress, id), as for zone MAP_PROJANIM_V2: unverified until seen on device.
+ */
+public class AndroidProjAnimSpecificV4Encoder :
+    MessageEncoder<net.rsprot.protocol.game.outgoing.specific.ProjAnimSpecificV4> {
+    override val prot: ServerProt = AndroidGameServerProt.PROJANIM_SPECIFIC_V4
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.specific.ProjAnimSpecificV4,
+    ) {
+        buffer.p3Alt2(message.sourceIndex)
+        buffer.p2(message.progress)
+        buffer.p2(message.startHeight)
+        buffer.p3Alt3(message.targetIndex)
+        buffer.p2Alt3(message.startTime)
+        buffer.p4Alt1(message.end.packed)
+        buffer.p4Alt3(message.start.packed)
+        buffer.p1(message.angle)
+        buffer.p2Alt1(message.id)
+        buffer.p2Alt2(message.endTime)
+        buffer.p2Alt3(message.endHeight)
+    }
+}
+
+/**
+ * Case 41 (parser 0x6580e4): reload p1Alt3 (raw 0x7f = reload), zoneX p2Alt1, zoneZ p2Alt1, then as
+ * desktop: distinct mapsquare count p2, and per zone (4 x 13 x 13) a 1-bit present flag + 26-bit
+ * reference zone.
+ */
+public class AndroidRebuildRegionV2Encoder :
+    MessageEncoder<net.rsprot.protocol.game.outgoing.map.RebuildRegionV2> {
+    override val prot: ServerProt = AndroidGameServerProt.REBUILD_REGION_V2
+
+    override fun encode(
+        streamCipher: StreamCipher,
+        buffer: JagByteBuf,
+        message: net.rsprot.protocol.game.outgoing.map.RebuildRegionV2,
+    ) {
+        buffer.p1Alt3(if (message.reload) 1 else 0)
+        buffer.p2Alt1(message.zoneX)
+        buffer.p2Alt1(message.zoneZ)
+        val zones = message.zones
+        val mapsquares = HashSet<Int>()
+        for (zone in zones) if (zone != null) mapsquares += zone.mapsquareId
+        buffer.p2(mapsquares.size)
+        buffer.buffer.ensureWritable(((27 * zones.size) + 32) ushr 3)
+        val bitbuf = buffer.buffer.toBitBuf()
+        bitbuf.use {
+            for (zone in zones) {
+                if (zone == null) {
+                    bitbuf.pBits(1, 0)
+                    continue
+                }
+                bitbuf.pBits(1, 1)
+                bitbuf.pBits(26, zone.referenceZone.packed)
+            }
+        }
+    }
+}
diff --git a/protocol/osrs-241/osrs-241-android/src/main/kotlin/net/rsprot/protocol/android/AndroidPlayerAppearanceEncoder.kt b/protocol/osrs-241/osrs-241-android/src/main/kotlin/net/rsprot/protocol/android/AndroidPlayerAppearanceEncoder.kt
