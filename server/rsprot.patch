+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatarExtendedInfoWriter
+import net.rsprot.protocol.internal.game.outgoing.info.npcinfo.encoder.NpcExtendedInfoEncoders
+import net.rsprot.protocol.internal.game.outgoing.info.shared.extendedinfo.Sequence
+
+@Suppress("DuplicatedCode")
+public class NpcAvatarExtendedInfoAndroidWriter :
+    NpcAvatarExtendedInfoWriter(
+        OldSchoolClientType.ANDROID,
+        NpcExtendedInfoEncoders(
+            OldSchoolClientType.ANDROID,
+            NpcSpotAnimEncoder(),
+            NpcSayEncoder(),
+            NpcVisibleOpsEncoder(),
+            NpcExactMoveEncoder(),
+            AndroidNpcSequenceEncoder(),
+            NpcTintingEncoder(),
+            NpcHeadIconCustomisationEncoder(),
+            NpcNameChangeEncoder(),
+            NpcHeadCustomisationEncoder(),
+            NpcBodyCustomisationEncoder(),
+            NpcTransformationEncoder(),
+            NpcCombatLevelChangeEncoder(),
+            AndroidNpcHitmarkEncoder(),
+            AndroidNpcHeadbarEncoder(),
+            AndroidNpcFaceEncoder(),
+            NpcBaseAnimationSetEncoder(),
+            NpcTransparencyEncoder(),
+            NpcFreezeEncoder(),
+        ),
+    ) {
+    override fun pExtendedInfo(
+        buffer: JagByteBuf,
+        localIndex: Int,
+        observerIndex: Int,
+        flag: Int,
+        blocks: NpcAvatarExtendedInfoBlocks,
+    ) {
+        // Android NPC extended info (NPC_INFO reader, Ghidra 0x569778): flag bytes chain with
+        // 0x20 (second byte), 0x2000 (third) and 0x20000 (fourth). Only blocks with a verified
+        // Android layout are written, in the client's read order: 0x2 transformation, 0x1 sequence,
+        // 0x4 say, 0x1000000 headbars, 0x40000 hitmarks. Anything else is dropped.
+        var clientFlag = 0
+        if (flag and NpcAvatarExtendedInfo.TRANSFORMATION != 0) clientFlag = clientFlag or ANDROID_TRANSFORMATION
+        if (flag and NpcAvatarExtendedInfo.SEQUENCE != 0) clientFlag = clientFlag or ANDROID_SEQUENCE
+        if (flag and NpcAvatarExtendedInfo.SAY != 0) clientFlag = clientFlag or ANDROID_SAY
+        if (flag and NpcAvatarExtendedInfo.HEADBARS != 0) clientFlag = clientFlag or ANDROID_HEADBARS
+        if (flag and NpcAvatarExtendedInfo.HITMARKS != 0) clientFlag = clientFlag or ANDROID_HITMARKS
+        if (flag and NpcAvatarExtendedInfo.FACE != 0) clientFlag = clientFlag or ANDROID_FACE
+        if (clientFlag and 0xFFFFFF.inv() != 0) clientFlag = clientFlag or EXTENDED_LARGE
+        if (clientFlag and 0xFFFF.inv() != 0) clientFlag = clientFlag or EXTENDED_MEDIUM
+        if (clientFlag and 0xFF.inv() != 0) clientFlag = clientFlag or EXTENDED_SHORT
+        buffer.p1(clientFlag)
+        if (clientFlag and EXTENDED_SHORT != 0) buffer.p1(clientFlag shr 8)
+        if (clientFlag and EXTENDED_MEDIUM != 0) buffer.p1(clientFlag shr 16)
+        if (clientFlag and EXTENDED_LARGE != 0) buffer.p1(clientFlag shr 24)
+        if (clientFlag and ANDROID_TRANSFORMATION != 0) pCachedData(buffer, blocks.transformation)
+        if (clientFlag and ANDROID_SEQUENCE != 0) pCachedData(buffer, blocks.sequence)
+        if (clientFlag and ANDROID_SAY != 0) pCachedData(buffer, blocks.say)
+        if (clientFlag and ANDROID_HEADBARS != 0) pOnDemandData(buffer, localIndex, blocks.headbarList, observerIndex)
+        if (clientFlag and ANDROID_FACE != 0) pCachedData(buffer, blocks.face)
+        if (clientFlag and ANDROID_HITMARKS != 0) pOnDemandData(buffer, localIndex, blocks.hitmarkList, observerIndex)
+    }
+
+    private companion object {
+        private const val ANDROID_SEQUENCE: Int = 0x1
+        private const val ANDROID_TRANSFORMATION: Int = 0x2
+        private const val ANDROID_SAY: Int = 0x4
+        private const val ANDROID_HITMARKS: Int = 0x40000
+        private const val ANDROID_FACE: Int = 0x40
+        private const val ANDROID_HEADBARS: Int = 0x1000000
+        private const val EXTENDED_SHORT: Int = 0x20
+        private const val EXTENDED_MEDIUM: Int = 0x2000
+        private const val EXTENDED_LARGE: Int = 0x20000
+    }
+}
+
+/** NPC flag 0x1: [id lo^0x80, hi][delay]. */
+public class AndroidNpcSequenceEncoder : PrecomputedExtendedInfoEncoder<Sequence> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: Sequence,
+    ): JagByteBuf =
+        alloc.buffer(3, 3).toJagByteBuf().also {
+            it.p2Alt3(extendedInfo.id.toInt())
+            it.p1(extendedInfo.delay.toInt())
+        }
+}
+
+/**
+ * NPC flag 0x40 (read after 0x400, before hitmarks 0x40000): the face flag byte is read raw (desktop
+ * writes p1Alt2), then the shared face payload (parser 0x4fb10c, same as desktop).
+ */
+public class AndroidNpcFaceEncoder : PrecomputedExtendedInfoEncoder<Face> {
+    override fun precompute(
+        alloc: ByteBufAllocator,
+        huffmanCodecProvider: HuffmanCodecProvider,
+        extendedInfo: Face,
+    ): JagByteBuf {
+        val buffer = alloc.buffer(9, 9).toJagByteBuf()
+        var flag = extendedInfo.walkMode or (extendedInfo.kind.value shl 3)
+        if (extendedInfo.instant) flag = flag or (1 shl 6)
+        buffer.p1(flag)
+        extendedInfo.encode(buffer)
+        return buffer
+    }
+}
