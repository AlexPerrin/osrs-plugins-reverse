+private fun pricePart(prev: String, label: String, each: Long, count: Long): String {
+    val sep = if (prev.isNotEmpty()) "  " else ""
+    val total = if (Long.MAX_VALUE / count > each) spacer(each * count) else "Lots!"
+    var line = "$prev$sep$label <col=ef1020>$total</col>"
+    if (count > 1 && each > 0) {
+        line = "$line (<col=ef1020>${spacer(each)}</col>ea)"
+    }
+    val plain = line.replace(Regex("<[^>]*>"), "")
+    return if (plain.length < 80) line else prev
 }
 
