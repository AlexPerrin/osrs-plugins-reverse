@@ -0,0 +1,51 @@
+package org.rsmod.content.other.treasuretrails.pack
+
+import dev.openrune.definition.dbtables.dbTable
+import dev.openrune.definition.util.VarType
+
+/**
+ * The beginner STASH units (OSRS Wiki: STASH). [LOC] is the inconspicuous bush (a multiloc on
+ * [VARBIT], `hh_constructed_*`: 0 = bush, 1 = built), [ITEM_1]/[ITEM_2] the emote clue items it
+ * holds and [FILLED_BIT] its bit in the server-only `trail_stash_beginner_filled` varp.
+ */
+object StashUnitsTable {
+    const val LOC = 0
+    const val VARBIT = 1
+    const val ITEM_1 = 2
+    const val ITEM_2 = 3
+    const val FILLED_BIT = 4
+    const val LEVEL = 5
+    const val XP = 6
+
+    private data class Unit(val name: String, val number: Int, val item1: String, val item2: String)
+
+    private val UNITS =
+        listOf(
+            Unit("gypsy_tent_entrance", 1, "obj.gold_ring", "obj.gold_necklace"),
+            Unit("fine_clothes_entrance", 2, "obj.chefs_hat", "obj.red_cape"),
+            Unit("bob_axes_entrance", 3, "obj.bronze_axe", "obj.leather_boots"),
+        )
+
+    fun units() =
+        dbTable("dbtable.trail_stash_units", serverOnly = true) {
+            column("loc", LOC, VarType.STRING)
+            column("varbit", VARBIT, VarType.STRING)
+            column("item_1", ITEM_1, VarType.OBJ)
+            column("item_2", ITEM_2, VarType.OBJ)
+            column("filled_bit", FILLED_BIT, VarType.INT)
+            column("level", LEVEL, VarType.INT)
+            column("xp", XP, VarType.INT)
+
+            for (u in UNITS) {
+                row("dbrow.trail_stash_${u.name}") {
+                    column(LOC, "loc.hh_beginner00${u.number}")
+                    column(VARBIT, "varbit.hh_constructed_beginner00${u.number}")
+                    columnRSCM(ITEM_1, u.item1)
+                    columnRSCM(ITEM_2, u.item2)
+                    column(FILLED_BIT, u.number - 1)
+                    column(LEVEL, 12)
+                    column(XP, 150)
+                }
+            }
+        }
+}
