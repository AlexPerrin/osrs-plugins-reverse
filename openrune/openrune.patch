+package org.rsmod.api.player.output
+
+import dev.openrune.types.ItemServerType
+import net.rsprot.protocol.game.outgoing.misc.player.MessageGame
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+import org.rsmod.game.client.Client
+import org.rsmod.game.entity.Player
+
+class ObjExamineTest {
+    @Test fun `item examine is sent as an ObjExamine message, not through clientscript mes`() {
+        val (player, sent) = player()
+        val type = ItemServerType(id = 1925, name = "Bucket", examine = "It's a wooden bucket.")
+        player.objExamine(type, count = 1, marketPrice = 4)
+        val message = sent.single() as MessageGame
+        assertEquals(ChatType.ObjExamine.id, message.type)
+        assertEquals(27, message.type)
+        assertEquals("It's a wooden bucket.", message.message)
+    }
+
+    @Test fun `large stacks are examined as count x name`() {
+        val (player, sent) = player()
+        val type = ItemServerType(id = 995, name = "Coins", examine = "Lovely money!")
+        player.objExamine(type, count = 1_234_567, marketPrice = 1)
+        val message = sent.single() as MessageGame
+        assertEquals(ChatType.ObjExamine.id, message.type)
+        assertEquals("1,234,567 x Coins.", message.message)
+    }
+
+    @Test fun `price line matches examine_price_info`() {
+        val red = "<col=ef1020>"
+        assertEquals(
+            "Price of Bucket: GE ${red}4</col>  HA ${red}1</col>",
+            examinePriceInfo("Bucket", 1, true, true, 4, true, 1, 0),
+        )
+        assertEquals(
+            "Price of 2,000 x Shrimps: GE ${red}100,000</col> (${red}50</col>ea)",
+            examinePriceInfo("Shrimps", 2000, true, true, 50, false, 5, 2),
+        )
+        assertEquals(
+            "Price: GE ${red}1,234,567</col> (${red}1</col>ea)",
+            examinePriceInfo("Coins", 1_234_567, false, true, 1, false, 0, 0),
+        )
+        assertNull(examinePriceInfo("Quest item", 1, true, false, 0, false, 0, 0))
+    }
+
+    private fun player(): Pair<Player, List<Any>> {
+        val client = RecordingClient()
+        val player = Player()
+        player.client = client
+        return player to client.messages
+    }
+
+    private class RecordingClient : Client<Any, Any> {
+        val messages = mutableListOf<Any>()
+
+        override fun write(message: Any) {
+            messages += message
+        }
+
+        override fun close() {}
+
+        override fun read(player: Player) {}
+
+        override fun flush() {}
+
+        override fun flushHighPriority() {}
+
+        override fun unregister(service: Any, player: Player) {}
+    }
+}
