+# Grand Exchange items exempt from the 2% tax.
+# Source: Old School RuneScape Wiki, "Grand Exchange", section "Exempt from tax"
+# (https://oldschool.runescape.wiki/w/Grand_Exchange#Exempt_from_tax, as of 17 October 2026),
+# by the wiki's contributors, licensed CC BY-NC-SA 3.0 (https://creativecommons.org/licenses/by-nc-sa/3.0/).
+# Changes: names matched to tradeable unnoted obj symbols; "Energy potion" taken as all four doses.
+# This file is under CC BY-NC-SA 3.0, not the project licence.
+[[enum]]
+isServerOnly = true
+id = "enum.ge_tax_exempt"
+keyType = "OBJ"
+valueType = "INT"
+
+[enum.values]
+"obj.pestle_and_mortar" = 1
+"obj.shrimp" = 1
+"obj.salmon" = 1
