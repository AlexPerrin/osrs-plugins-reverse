From c80912117f4dff58947796e2b18bf0709282c8be Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:12:24 -0400
Subject: [PATCH 60/62] Daddy's Home: the waxwood crates top up to three logs

Each search gave three more waxwood logs while the bed was unbuilt. The
wiki's waxwood log page says duplicates cannot be obtained, so a search
now gives only what is missing from three, counting logs and waxwood
planks in the inventory and the bank. With three already held the crates
say "You search the crates but find nothing interesting." (the OSRS
wording for that case is a guess).
---
 .../varrock/daddyshome/DaddysHomeFurniture.kt | 11 +++++++++--
 .../daddyshome/DaddysHomeInteractionTest.kt   | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+), 2 deletions(-)

diff --git a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeFurniture.kt b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeFurniture.kt
index 60b374b08..0c70a8e91 100644
--- a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeFurniture.kt
+++ b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeFurniture.kt
@@ -268,11 +268,18 @@ class DaddysHomeFurniture @Inject constructor(private val daddysHome: DaddysHome
         val needsLogs =
             stage in DaddysHomeQuest.BUILDING until DaddysHomeQuest.COMPLETE &&
                 daddysHome.furnitureState(player, Furniture.bed) < Furniture.BUILT
-        if (!needsLogs) {
+        // The wiki says duplicates cannot be obtained: top up to three logs, counting logs and
+        // planks already held or banked. The message once the player has three is a guess.
+        val held =
+            listOf(DaddysHomeQuest.WAXWOOD_LOGS, DaddysHomeQuest.WAXWOOD_PLANK).sumOf {
+                inv.count(it) + bank.count(it)
+            }
+        val missing = WAXWOOD_LOG_COUNT - held
+        if (!needsLogs || missing <= 0) {
             mes("You search the crates but find nothing interesting.")
             return
         }
-        if (invAdd(inv, DaddysHomeQuest.WAXWOOD_LOGS, WAXWOOD_LOG_COUNT).failure) {
+        if (invAdd(inv, DaddysHomeQuest.WAXWOOD_LOGS, missing).failure) {
             mes("You don't have enough inventory space.")
             return
         }
diff --git a/content/quest/src/test/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeInteractionTest.kt b/content/quest/src/test/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeInteractionTest.kt
index 6978f83d7..baed2d0a6 100644
--- a/content/quest/src/test/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeInteractionTest.kt
+++ b/content/quest/src/test/kotlin/org/rsmod/content/quest/area/varrock/daddyshome/DaddysHomeInteractionTest.kt
@@ -216,6 +216,25 @@ class DaddysHomeInteractionTest {
         assertEquals(0, late.player.inv.count("obj.daddyshome_waxwood_logs"))
     }
 
+    @Test
+    fun `the crates only top up to three waxwood logs counting planks and the bank`() {
+        val f = Fixture(DaddysHomeQuest.BUILDING)
+        f.setAll(Furniture.CLEARED)
+        f.crates()
+        f.crates()
+        assertEquals(3, f.player.inv.count("obj.daddyshome_waxwood_logs"))
+
+        val mixed = Fixture(DaddysHomeQuest.BUILDING)
+        mixed.setAll(Furniture.CLEARED)
+        mixed.give("obj.daddyshome_waxwood_plank" to 1)
+        mixed.player.invMap.getOrPut("inv.bank")[0] = InvObj("obj.daddyshome_waxwood_logs", 1)
+        mixed.crates()
+        assertEquals(1, mixed.player.inv.count("obj.daddyshome_waxwood_logs"))
+        mixed.crates()
+        assertEquals(1, mixed.player.inv.count("obj.daddyshome_waxwood_logs"))
+        assertTrue(mixed.output().contains("find nothing interesting"), mixed.output())
+    }
+
     @Test
     fun `a full inventory does not lose the logs`() {
         val f = Fixture(DaddysHomeQuest.BUILDING)
