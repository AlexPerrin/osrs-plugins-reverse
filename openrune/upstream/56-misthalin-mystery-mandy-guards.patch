From 80606f42351e6792e67dd3682ba03d72556ac4df Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 17:58:51 -0400
Subject: [PATCH 3/3] Misthalin Mystery: Mandy completes the quest only at its
 last stage, with room for the gems

mandyOutside() completed the quest for any unfinished player (the multinpc falls back to
its base handler), and completeQuest dropped the three uncut gems when the inventory was
full. Mandy now needs stage MandyWaiting (130) and 3 free inventory slots.
---
 .../content/quest/area/misthalin/MisthalinMystery.kt  | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/misthalin/MisthalinMystery.kt b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/misthalin/MisthalinMystery.kt
index 3aa651706..64507bba1 100644
--- a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/misthalin/MisthalinMystery.kt
+++ b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/misthalin/MisthalinMystery.kt
@@ -331,6 +331,10 @@ constructor(
             return
         }
 
+        if (quest.getQuestStage(player) != MisthalinStage.MandyWaiting) {
+            return
+        }
+
         chatNpc(happy, "Oh hi, ${player.displayName}.")
         chatPlayer(happy, "Hi Mandy. How are you feeling now?")
         chatNpc(happy, "Much better thanks, and lucky to be alive, thanks to you in no small part.")
@@ -341,12 +345,19 @@ constructor(
                 "so please, take them...",
         )
 
+        if (access.inv.freeSpace() < RewardSlots) {
+            access.mes("You need $RewardSlots free inventory spaces to take the gems.")
+            return
+        }
+
         access.mistmystXpAwarded = true
 
         quest.completeQuest(access)
     }
 
     private companion object {
+        /** The uncut ruby, emerald and sapphire. */
+        private const val RewardSlots = 3
         private const val BoatFadeDelay = 1
         private const val BoatCrossingTicks = 2
         private const val BoatFadeInDelay = 1
