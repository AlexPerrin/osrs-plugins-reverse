+                    chatNpc(sad, "Sad about that affair with young Romeo and Juliet...")
+                    chatNpc(neutral, "I hear every time Romeo sees Juliet now he runs away screaming something about ghosts and Juliet's cousin?")
+                    chatNpc(neutral, "Always did think he was a bit of a strange one...")
+                    chatNpc(happy, "Anyway! Life goes on and so does business! Can I do something for you?")
+                } else {
+                    chatNpc(neutral, "Well I hear young Romeo's having a little woman trouble but other than that all's quiet on the eastern front. Can I do something for you?")
+                }
+                apothecaryOptions()
+            }
+            3 -> {
+                chatPlayer(quiz, hair)
+                chatNpc(neutral, "I do indeed. I gave it to my mother. That's why I now live alone.")
+                chatNpc(neutral, "But can I do something for you?")
+                apothecaryOptions()
+            }
+            4 -> {
+                chatPlayer(quiz, giveAway)
+                if (access.random.randomBoolean()) {
+                    freeSample()
+                    return
+                }
+                chatNpc(sad, "Sorry, charity is not my strong point. Do you need anything else?")
+                apothecaryOptions()
+            }
