From 9ae8a54da4aa48396585acc2be0887fb2d166f2b Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 22:36:31 -0400
Subject: [PATCH] Gertrude's Cat: Gertrude asks about Shilop after the boys are
 paid

At stage 2 (the boys paid, Fluffs not yet found) Gertrude repeated the
stage-1 lines ("Have you seen my poor Fluffs?" ... "What about
Shilop?"). The wiki transcript has a separate exchange for this point
("Hello again, did you manage to find Shilop? ..."), which she now uses.
---
 .../varrock/GertrudesCatInteractionTest.kt    | 12 +++++++++++
 .../varrock/gertrudescat/GertrudesCatQuest.kt | 21 +++++++++++++++++--
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/content/areas/city/varrock/src/test/kotlin/org/rsmod/content/areas/city/varrock/GertrudesCatInteractionTest.kt b/content/areas/city/varrock/src/test/kotlin/org/rsmod/content/areas/city/varrock/GertrudesCatInteractionTest.kt
index ff9f26b6f..26f0b25e5 100644
--- a/content/areas/city/varrock/src/test/kotlin/org/rsmod/content/areas/city/varrock/GertrudesCatInteractionTest.kt
+++ b/content/areas/city/varrock/src/test/kotlin/org/rsmod/content/areas/city/varrock/GertrudesCatInteractionTest.kt
@@ -250,6 +250,18 @@ class GertrudesCatInteractionTest {
         assertEquals(3, f.stage())
     }
 
+    @Test fun `after paying the boys Gertrude asks about Shilop, not Fluffs`() {
+        val f = Fixture(2)
+        f.talkToGertrude()
+        f.finish()
+        assertTrue(f.output().contains("did you manage to find Shilop?"), f.output())
+        assertFalse(f.output().contains("What about Shilop?"), f.output())
+        val before = Fixture(1)
+        before.talkToGertrude()
+        before.finish()
+        assertTrue(before.output().contains("What about Shilop?"), before.output())
+    }
+
     @Test fun `the journal follows the stage`() {
         val f = Fixture(2)
         f.player.metFluffs = true
diff --git a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/gertrudescat/GertrudesCatQuest.kt b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/gertrudescat/GertrudesCatQuest.kt
index 7c9209e5d..faf783439 100644
--- a/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/gertrudescat/GertrudesCatQuest.kt
+++ b/content/quest/src/main/kotlin/org/rsmod/content/quest/area/varrock/gertrudescat/GertrudesCatQuest.kt
@@ -113,8 +113,8 @@ class GertrudesCatQuest :
     suspend fun Dialogue.gertrudeDialogue(): Boolean {
         when (stage(player)) {
             0 -> beforeQuest()
-            STAGE_STARTED,
-            STAGE_PAID_KIDS -> lookingForFluffs()
+            STAGE_STARTED -> lookingForFluffs()
+            STAGE_PAID_KIDS -> afterPayingKids()
             STAGE_GAVE_MILK -> sardineAdvice()
             STAGE_GAVE_SARDINE -> afterSardine()
             else -> return false
@@ -163,6 +163,23 @@ class GertrudesCatQuest :
         chatNpc(confused, "Hmmm... strange. He should be at the market.")
     }
 
+    /** After paying the boys (stage 2), from the wiki transcript ("Talking to Gertrude again"). */
+    private suspend fun Dialogue.afterPayingKids() {
+        if (player.metFluffs) {
+            sardineAdvice()
+            return
+        }
+        chatPlayer(happy, "Hello Gertrude.")
+        chatNpc(
+            quiz,
+            "Hello again, did you manage to find Shilop? I can't keep an eye on him for the life of me.",
+        )
+        chatPlayer(neutral, "He does seem quite a handful.")
+        chatNpc(angry, "You have no idea! Did he help at all?")
+        chatPlayer(happy, "I think so, I'm just going to look now.")
+        chatNpc(happy, "Thanks again, adventurer.")
+    }
+
     private suspend fun Dialogue.sardineAdvice() {
         chatPlayer(happy, "Hello again.")
         chatNpc(quiz, "Hello. How's it going? Any luck?")
-- 
