diff --git a/protocol/osrs-241/osrs-241-desktop/src/test/kotlin/net/rsprot/protocol/game/outgoing/info/NpcInfoViewEdgeTest.kt b/protocol/osrs-241/osrs-241-desktop/src/test/kotlin/net/rsprot/protocol/game/outgoing/info/NpcInfoViewEdgeTest.kt
new file mode 100644
index 00000000..b4e15043
--- /dev/null
+++ b/protocol/osrs-241/osrs-241-desktop/src/test/kotlin/net/rsprot/protocol/game/outgoing/info/NpcInfoViewEdgeTest.kt
@@ -0,0 +1,104 @@
+package net.rsprot.protocol.game.outgoing.info
+
+import io.netty.buffer.ByteBuf
+import net.rsprot.protocol.common.client.OldSchoolClientType
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatar
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcAvatarFactory
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcInfo
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcInfoLargeV6
+import net.rsprot.protocol.game.outgoing.info.npcinfo.NpcInfoSmallV6
+import net.rsprot.protocol.internal.game.outgoing.info.CoordGrid
+import net.rsprot.protocol.internal.game.outgoing.info.util.ZoneIndexStorage
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import kotlin.test.assertEquals
+
+/**
+ * NPCs added at the edge of the view distance (15 tiles) must stay in high resolution on the next
+ * tick: the Android client showed a count one lower than its list right after such an add.
+ */
+class NpcInfoViewEdgeTest {
+    private lateinit var infoProtocols: InfoProtocols
+    private lateinit var client: NpcInfoClient
+    private lateinit var npcInfo: NpcInfo
+    private lateinit var factory: NpcAvatarFactory
+    private lateinit var infos: Infos
+    private val player = CoordGrid(0, 3207, 3207)
+
+    @BeforeEach
+    fun initialize() {
+        client = NpcInfoClient()
+        val storage = ZoneIndexStorage(ZoneIndexStorage.NPC_CAPACITY)
+        factory = generateNpcAvatarFactory(storage)
+        infoProtocols = generateInfoProtocols(factory, storage)
+        infos = infoProtocols.alloc(500, OldSchoolClientType.DESKTOP)
+        npcInfo = infos.npcInfo
+    }
+
+    private fun tick() {
+        infos.updateRootCoord(player.level, player.x, player.z)
+        infos.updateRootBuildAreaCenteredOnPlayer(player.x, player.z)
+        infoProtocols.npcInfoProtocol.update()
+        val packet = npcInfo.internalPacketResult(NpcInfo.ROOT_WORLD).getOrNull()!!
+        packet.markConsumed()
+        val buffer: ByteBuf =
+            when (packet) {
+                is NpcInfoSmallV6 -> packet.content()
+                is NpcInfoLargeV6 -> packet.content()
+                else -> error("unknown packet $packet")
+            }
+        client.decode(buffer, false, player)
+    }
+
+    private fun spawn(
+        index: Int,
+        dx: Int,
+        dz: Int,
+    ): NpcAvatar = factory.alloc(index, 3028, player.level, player.x + dx, player.z + dz)
+
+    private fun serverCount(): Int = npcInfo.getHighResolutionIndices(NpcInfo.ROOT_WORLD).size
+
+    @Test
+    fun `npc at distance 15 stays after the add`() {
+        spawn(1, 0, 15)
+        tick()
+        assertEquals(1, client.npcSlotCount)
+        repeat(3) {
+            tick()
+            assertEquals(1, client.npcSlotCount, "client list after tick ${it + 2}")
+            assertEquals(1, serverCount())
+        }
+    }
+
+    @Test
+    fun `npc spawned at runtime at distance 15 stays`() {
+        for (i in 0..<27) spawn(10 + i, i % 10 - 5, i / 10 - 1)
+        tick()
+        assertEquals(27, client.npcSlotCount)
+        spawn(19538, 0, 15)
+        tick()
+        assertEquals(28, client.npcSlotCount)
+        repeat(3) {
+            tick()
+            assertEquals(28, client.npcSlotCount, "client list after tick ${it + 3}")
+            assertEquals(28, serverCount())
+        }
+    }
+
+    @Test
+    fun `add at distance 15 with a removal in the same tick`() {
+        val gone = spawn(5, 1, 1)
+        for (i in 0..<5) spawn(10 + i, i, -2)
+        tick()
+        assertEquals(6, client.npcSlotCount)
+        factory.release(gone)
+        spawn(19538, -15, 15)
+        tick()
+        assertEquals(6, client.npcSlotCount)
+        repeat(3) {
+            tick()
+            assertEquals(6, client.npcSlotCount, "client list after tick ${it + 3}")
+            assertEquals(6, serverCount())
+        }
+    }
+}
