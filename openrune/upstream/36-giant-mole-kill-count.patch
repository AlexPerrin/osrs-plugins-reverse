From 85aab83452266910402a877dab5a82f22e1c5adb Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Sat, 17 Oct 2026 07:08:48 -0400
Subject: [PATCH] Giant Mole kill count

The Giant Mole gets param.killcount_varp = varp.total_mole_kills (1515, the OSRS varp), so
the generic kill count hook sends 'Your Giant Mole kill count is: N', which RuneLite's
chat commands and the KPH Tracker plugin read.
---
 .data/raw-cache/server/npcs.toml | 1 +
 1 file changed, 1 insertion(+)

diff --git a/.data/raw-cache/server/npcs.toml b/.data/raw-cache/server/npcs.toml
index bd9af7f5d..536d4a4af 100644
--- a/.data/raw-cache/server/npcs.toml
+++ b/.data/raw-cache/server/npcs.toml
@@ -10902,6 +10902,7 @@ inherit = "npc.castlewars_imp"
 id = "npc.mole_giant"
 inherit = "npc.mole_giant"
 [npc.params]
+"param.killcount_varp"="varp.total_mole_kills"
 "param.elemental_weakness_type"=2
 "param.elemental_weakness_percent"=50
 
