From 53a4414a48535d9ac49ca4f1f21dba134c773c4a Mon Sep 17 00:00:00 2001
From: Alex Perrin <44126061+AlexPerrin@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:33:03 -0400
Subject: [PATCH] Serialize transactions on the shared database connection

The game thread (logins) and the account-saving service use the same JDBC
connection. Two transactions interleaved on it commit each other's work and
lose SET LOCAL search_path, which shows up as "schema 'main' does not exist"
on an account save. Guard withTransaction/transaction with one lock.
---
 .../org/rsmod/api/db/jdbc/GameDatabase.kt     | 55 +++++++++++--------
 1 file changed, 33 insertions(+), 22 deletions(-)

diff --git a/api/db/src/main/kotlin/org/rsmod/api/db/jdbc/GameDatabase.kt b/api/db/src/main/kotlin/org/rsmod/api/db/jdbc/GameDatabase.kt
index eddd260e2..686761909 100644
--- a/api/db/src/main/kotlin/org/rsmod/api/db/jdbc/GameDatabase.kt
+++ b/api/db/src/main/kotlin/org/rsmod/api/db/jdbc/GameDatabase.kt
@@ -24,6 +24,13 @@ constructor(
 
     private lateinit var connection: Connection
 
+    /**
+     * The game thread (logins) and the account-saving service share [connection]. Interleaved
+     * transactions on one JDBC connection commit each other's work and drop `SET LOCAL
+     * search_path`, which showed as "schema 'main' does not exist" on a save.
+     */
+    private val transactionLock = Any()
+
     public fun connect(connector: GameConnection) {
         check(!::connection.isInitialized) { "Connection already initialized." }
         val config = configProvider.get()
@@ -67,19 +74,21 @@ constructor(
         block: (DatabaseConnection) -> T,
     ): T =
         withConnection { connection ->
-            val wrapped = DatabaseConnection(connection)
-            try {
-                applySchemaSearchPath(connection, schema)
-                val result = block(wrapped)
-                connection.commit()
-                result
-            } catch (t: Throwable) {
+            synchronized(transactionLock) {
+                val wrapped = DatabaseConnection(connection)
                 try {
-                    connection.rollback()
-                } catch (rollbackEx: Throwable) {
-                    throw DatabaseRollbackException(t, rollbackEx)
+                    applySchemaSearchPath(connection, schema)
+                    val result = block(wrapped)
+                    connection.commit()
+                    result
+                } catch (t: Throwable) {
+                    try {
+                        connection.rollback()
+                    } catch (rollbackEx: Throwable) {
+                        throw DatabaseRollbackException(t, rollbackEx)
+                    }
+                    throw t
                 }
-                throw t
             }
         }
 
@@ -89,19 +98,21 @@ constructor(
         block: (DatabaseConnection) -> T,
     ): T {
         assertValidConnection()
-        try {
-            val wrapped = DatabaseConnection(connection)
-            applySchemaSearchPath(connection, schema)
-            val result = block(wrapped)
-            connection.commit()
-            return result
-        } catch (t: Throwable) {
+        synchronized(transactionLock) {
             try {
-                connection.rollback()
-            } catch (rollbackEx: Throwable) {
-                throw DatabaseRollbackException(t, rollbackEx)
+                val wrapped = DatabaseConnection(connection)
+                applySchemaSearchPath(connection, schema)
+                val result = block(wrapped)
+                connection.commit()
+                return result
+            } catch (t: Throwable) {
+                try {
+                    connection.rollback()
+                } catch (rollbackEx: Throwable) {
+                    throw DatabaseRollbackException(t, rollbackEx)
+                }
+                throw t
             }
-            throw t
         }
     }
 
